<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- O render dos testes usa Skia de verdade. O libSkiaSharp padrão do Linux exige libfontconfig.so.1, que a imagem do CI não tem;
         a variante sem dependências não precisa dela (as fontes do app são embutidas). A versão é a que o Avalonia.Skia puxa. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <ProjectReference Include="..\..\src\VNForge.App\VNForge.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geradores sintéticos do YU-RIS (jogo de mentira montado em código) para o BuildScreenTests. -->
    <Compile Include="..\VNForge.Engines.YuRis.Tests\Ypf\Synthetic\*.cs" Exclude="..\VNForge.Engines.YuRis.Tests\Ypf\Synthetic\*Tests.cs" LinkBase="Synthetic\Ypf" />
    <Compile Include="..\VNForge.Engines.YuRis.Tests\Yscm\Synthetic\*.cs" LinkBase="Synthetic\Yscm" />
    <Compile Include="..\VNForge.Engines.YuRis.Tests\Ystb\Synthetic\*.cs" LinkBase="Synthetic\Ystb" />
    <Compile Include="..\VNForge.Engines.YuRis.Tests\Ystl\Synthetic\*.cs" Exclude="..\VNForge.Engines.YuRis.Tests\Ystl\Synthetic\*Tests.cs" LinkBase="Synthetic\Ystl" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os tokens e a lista de ícones saem do design system; um teste confere que o Tokens.axaml está em dia com o tokens.json. -->
    <None Include="..\..\docs\design\tokens.json" Link="design\tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\VNForge.App\Themes\Tokens.axaml" Link="design\Tokens.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\VNForge.App\Themes\TextScale.axaml" Link="design\TextScale.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
