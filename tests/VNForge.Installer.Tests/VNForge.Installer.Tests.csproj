<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- O render dos testes usa Skia de verdade. O libSkiaSharp padrão do Linux exige libfontconfig.so.1, que a imagem do CI não tem;
         a variante sem dependências não precisa dela (as fontes do instalador são embutidas). Mesmo arranjo do VNForge.App.Tests. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <ProjectReference Include="..\..\src\VNForge.Installer\VNForge.Installer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O jogo sintético dos testes do Patching: arquivos aleatórios em disco, nada de jogo de verdade. -->
    <Compile Include="..\VNForge.Patching.Tests\SyntheticGame.cs" Link="SyntheticGame.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A arte da capa do quadro #540 (150 por 200), recortada da captura do quadro: o instalador a mostra como o patch a levaria. -->
    <None Include="Rendering\Assets\capa-quadro.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
