<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Controls.AccentCards"
             x:DataType="c:AccentCards">

  <UserControl.Styles>
    <!-- Selo do quadro (".v3-pill"): 11/600 com 18 de entrelinha, 8 de lado, 1 em cima e embaixo, em cápsula. -->
    <Style Selector="Border.pill-tag">
      <Setter Property="Padding" Value="8,1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    </Style>
    <Style Selector="Border.pill-tag TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Cartão que ainda não existe ("Em breve"): fundo da camada e contorno sutil. -->
    <Style Selector="RadioButton.option.marked:disabled /template/ Border#Card">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgLayer}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    </Style>
  </UserControl.Styles>

  <!-- Os cartões de acentos (.enc): nome e selo na primeira linha, a explicação e a frase de teste desenhada na caixa de texto do jogo. -->
  <ItemsControl ItemsSource="{Binding Options, RelativeSource={RelativeSource AncestorType=c:AccentCards}}" Margin="0,0,-12,0">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ChoiceOption">
        <RadioButton Classes="option marked" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=c:AccentCards}}" Margin="0,0,12,0" VerticalAlignment="Stretch"
                     IsEnabled="{Binding IsAvailable}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
          <DockPanel>
            <c:GameTextbox DockPanel.Dock="Bottom" Flat="True" ShowVacant="True" HorizontalAlignment="Stretch" Margin="0,8,0,0" Layout="{Binding Layout}" AutomationProperties.Name="Frase de teste"/>
            <StackPanel Spacing="8" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="radio-mark"/>
                <TextBlock Classes="title-sm" LineHeight="20" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Center"/>
              </StackPanel>
              <Border Classes="pill-tag" HorizontalAlignment="Left" Background="{DynamicResource Vnf.StatusApprovedBg}" IsVisible="{Binding ShowBadge}">
                <TextBlock Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding Badge}"/>
              </Border>
              <Border Classes="pill-tag" HorizontalAlignment="Left" Background="{DynamicResource Vnf.StatusPendingBg}" IsVisible="{Binding ShowSoonBadge}">
                <TextBlock Foreground="{DynamicResource Vnf.StatusPendingFg}" Text="{Binding Badge}"/>
              </Border>
              <TextBlock Classes="body-sm secondary" LineHeight="18" TextWrapping="Wrap" Text="{Binding Description}"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
