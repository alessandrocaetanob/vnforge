<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Controls.AccentCards"
             x:DataType="c:AccentCards">

  <!-- Os cartões de acentos (.v3-qc do quadro da #547): círculo de rádio e nome na primeira linha, o selo embaixo, a explicação e a frase de teste desenhada na caixa de texto do jogo,
       sempre no pé do cartão. -->
  <ItemsControl ItemsSource="{Binding Options, RelativeSource={RelativeSource AncestorType=c:AccentCards}}" Margin="0,0,-12,0">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ChoiceOption">
        <RadioButton Classes="option marked" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=c:AccentCards}}" Margin="0,0,12,0" VerticalAlignment="Stretch"
                     IsEnabled="{Binding IsAvailable}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
          <DockPanel>
            <c:GameTextbox DockPanel.Dock="Bottom" Flat="True" HorizontalAlignment="Stretch" Margin="0,16,0,0" Layout="{Binding Layout}" AutomationProperties.Name="Frase de teste"/>
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Classes="radio-mark"/>
                <TextBlock Grid.Column="1" Classes="title-sm" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.TextPrimary}" Text="{Binding Title}" VerticalAlignment="Center"/>
              </Grid>
              <Border HorizontalAlignment="Left" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                      Background="{DynamicResource Vnf.StatusApprovedBg}" IsVisible="{Binding ShowBadge}">
                <TextBlock FontSize="11" LineHeight="18" FontWeight="SemiBold" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding Badge}"/>
              </Border>
              <Border HorizontalAlignment="Left" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                      Background="{DynamicResource Vnf.StatusPendingBg}" IsVisible="{Binding ShowSoonBadge}">
                <TextBlock FontSize="11" LineHeight="18" FontWeight="SemiBold" Foreground="{DynamicResource Vnf.StatusPendingFg}" Text="{Binding Badge}"/>
              </Border>
              <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
