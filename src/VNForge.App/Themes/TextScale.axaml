<!-- Escrito à mão, fora do Tokens.axaml: o Generate-Tokens.ps1 reescreve aquele arquivo inteiro e não conhece estes recursos. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="Vnf.PillHeight">20</x:Double>
  <x:Double x:Key="Vnf.MarkerHeight">22</x:Double>
  <x:Double x:Key="Vnf.MarkerLineHeight">26</x:Double>

  <!-- Tamanhos do texto a 100%; a janela os troca pelos de TextAppearance.Build conforme o tamanho escolhido nos Ajustes. Mudou aqui, mude lá (TextAppearanceTests confere). -->
  <!-- Exceção ao tokens.json: title-xl usa 34/50, title-lg 24/35, title-md 17/25 e title-sm 15/22, não 34/40, 24/32, 17/24 e 15/20. O Zen Kaku Gothic New pede 1,448 de altura por corpo (49,2, 34,75, 24,6 e 21,7) e abaixo disso o TextBlock corta as descendentes; FontsHeadlessTests e TypographyTokensTests conferem. -->
  <x:Double x:Key="Vnf.FontSize.TitleXl">34</x:Double>
  <x:Double x:Key="Vnf.LineHeight.TitleXl">50</x:Double>
  <x:Double x:Key="Vnf.FontSize.TitleLg">24</x:Double>
  <x:Double x:Key="Vnf.LineHeight.TitleLg">35</x:Double>
  <x:Double x:Key="Vnf.FontSize.TitleSm">15</x:Double>
  <x:Double x:Key="Vnf.LineHeight.TitleSm">22</x:Double>
  <x:Double x:Key="Vnf.FontSize.ColumnHeader">12</x:Double>
  <x:Double x:Key="Vnf.LineHeight.ColumnHeader">16</x:Double>
  <x:Double x:Key="Vnf.FontSize.Overline">11</x:Double>
  <x:Double x:Key="Vnf.LineHeight.Overline">16</x:Double>
  <x:Double x:Key="Vnf.LetterSpacing.Overline">0.77</x:Double>
  <x:Double x:Key="Vnf.FontSize.Body">14</x:Double>
  <x:Double x:Key="Vnf.LineHeight.Body">20</x:Double>
  <x:Double x:Key="Vnf.FontSize.BodySm">13</x:Double>
  <x:Double x:Key="Vnf.LineHeight.BodySm">18</x:Double>
  <x:Double x:Key="Vnf.FontSize.Caption">12</x:Double>
  <x:Double x:Key="Vnf.LineHeight.Caption">16</x:Double>
  <x:Double x:Key="Vnf.FontSize.Mono">12</x:Double>
  <x:Double x:Key="Vnf.LineHeight.Mono">18</x:Double>
  <x:Double x:Key="Vnf.FontSize.Pill">11</x:Double>
  <x:Double x:Key="Vnf.LineHeight.Pill">14</x:Double>
  <x:Double x:Key="Vnf.FontSize.MonoXs">11</x:Double>
  <x:Double x:Key="Vnf.LineHeight.MonoXs">14</x:Double>
  <x:Double x:Key="Vnf.FontSize.TitleMd">17</x:Double>
  <x:Double x:Key="Vnf.LineHeight.TitleMd">25</x:Double>
  <x:Double x:Key="Vnf.FontSize.JpBody">19</x:Double>
  <x:Double x:Key="Vnf.LineHeight.JpBody">30</x:Double>
  <x:Double x:Key="Vnf.FontSize.JpRow">13</x:Double>
  <x:Double x:Key="Vnf.LineHeight.JpRow">18</x:Double>
  <x:Double x:Key="Vnf.FontSize.BodyLoose">14</x:Double>
  <x:Double x:Key="Vnf.LineHeight.BodyLoose">22</x:Double>
  <x:Double x:Key="Vnf.FontSize.ReviewSource">19</x:Double>
  <x:Double x:Key="Vnf.LineHeight.ReviewSource">27</x:Double>
  <x:Double x:Key="Vnf.FontSize.ReviewTranslation">17</x:Double>
  <x:Double x:Key="Vnf.LineHeight.ReviewTranslation">30</x:Double>
  <x:Double x:Key="Vnf.FontSize.ReviewSuggestion">15</x:Double>
  <x:Double x:Key="Vnf.LineHeight.ReviewSuggestion">24</x:Double>
</ResourceDictionary>
