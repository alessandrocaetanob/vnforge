<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Escalas de docs/design/tokens.json (type.groups). Texto japonês sempre em Vnf.FontJp. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
  </Style>

  <!-- O Zen Kaku Gothic New tem 1,45 de altura natural por corpo (ascendente 1,16 e descendente 0,29): com 26/32 e 17/24 o TextBlock cortava
       as descendentes (j, p, g). A altura de linha cobre a altura natural da fonte; FontsHeadlessTests confere. -->
  <Style Selector="TextBlock.title-lg">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.TitleLg}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.TitleLg}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.title-md">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.TitleMd}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.TitleMd}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.title-xl">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.TitleXl}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.TitleXl}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.title-sm">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.TitleSm}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.TitleSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.column-header">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.ColumnHeader}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.ColumnHeader}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Body}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Body}"/>
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Body}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.body-sm">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.BodySm}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.BodySm}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Caption}"/>
  </Style>
  <!-- O v3 pede caixa alta e 0,07 em de espaçamento (0,77px a 11px). O TextBlock não tem text-transform: quem usa a classe escreve o rótulo em caixa alta. -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Overline}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Overline}"/>
    <Setter Property="LetterSpacing" Value="{DynamicResource Vnf.LetterSpacing.Overline}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.jp-body">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.JpBody}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.JpBody}"/>
  </Style>
  <Style Selector="TextBlock.jp-row">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.JpRow}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.JpRow}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Mono}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Mono}"/>
  </Style>
  <Style Selector="TextBlock.mono-xs">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.MonoXs}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.MonoXs}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
</Styles>
