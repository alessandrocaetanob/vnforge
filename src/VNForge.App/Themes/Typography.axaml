<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Escalas de docs/design/tokens.json (type.groups). Texto japonês sempre em Vnf.FontJp. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
  </Style>

  <!-- O Zen Kaku Gothic New tem 1,45 de altura natural por corpo (ascendente 1,16 e descendente 0,29): com 26/32 e 17/24 o TextBlock cortava
       as descendentes (j, p, g). A altura de linha cobre a altura natural da fonte; TypographyTests confere. -->
  <Style Selector="TextBlock.title-lg">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="LineHeight" Value="38"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.title-md">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="LineHeight" Value="25"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.body-sm">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.jp-body">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="LineHeight" Value="24"/>
  </Style>
  <Style Selector="TextBlock.jp-row">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style Selector="TextBlock.mono-xs">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontMono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LineHeight" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
</Styles>
