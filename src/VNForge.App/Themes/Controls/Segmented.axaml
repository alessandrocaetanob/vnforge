<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Controle segmentado (quadro da aba Jogar, "Semanas | Lista"): pílula inteira de bg-inset, sem contorno nem divisor, 34px de altura.
       O segmento marcado é uma pílula interna a 3px da borda, de 28px, em bg-card com contorno stroke-subtle e texto text-primary em 600; os outros ficam em text-secondary. -->
  <Style Selector="ListBox.seg">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Desligada e não marcada: apagada. Desligada e marcada (o ajuste escolhido que a estratégia não grava) mantém o texto normal sobre o destaque, para continuar legível. -->
  <Style Selector="ListBox.seg > ListBoxItem:disabled:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextTertiary}"/>
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <!-- Abas (artboard de Ajustes): 40px de altura, texto em text-secondary; a marcada fica em text-primary 600 com sublinhado de 3px accent. -->
  <Style Selector="TabControl.tabs">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="TabControl.tabs > TabItem">
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"/>
          <Border Name="PART_Underline" Height="3" Margin="14,0" CornerRadius="2" VerticalAlignment="Bottom"
                  Background="{DynamicResource Vnf.Accent}" IsVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.tabs > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
  </Style>
  <Style Selector="TabControl.tabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TabControl.tabs > TabItem:selected /template/ Border#PART_Underline">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="TabControl.tabs > TabItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
</Styles>
