<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Barra de progresso simples (vnf-progress): 4px, trilho em stroke-subtle, preenchimento em accent; cheia, em seg-approved. -->
  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.Accent}"/>
  </Style>
  <Style Selector="ProgressBar.thin.done">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SegApproved}"/>
  </Style>
  <Style Selector="ProgressBar.thin /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <!-- A lista de cenas usa a barra de 3px. -->
  <Style Selector="ProgressBar.thin.slim">
    <Setter Property="MinHeight" Value="3"/>
    <Setter Property="Height" Value="3"/>
    <Setter Property="CornerRadius" Value="1.5"/>
  </Style>
  <Style Selector="ProgressBar.thin.slim /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="1.5"/>
  </Style>

  <!-- v5: 36px de altura. O nome numa linha só (reticências se passar), o percentual (ou o visto, com a cena pronta) à direita e a barra de 3px embaixo. O id da cena não aparece: vai na dica do mouse (ScriptItemViewModel.Tooltip). -->
  <Style Selector="c|ScriptItem">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="10,0,10,6"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" FontSize="13" LineHeight="18" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Vnf.TextPrimary}"/>
            <StackPanel Name="PART_Percent" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <PathIcon Name="PART_Running" Width="16" Height="16" IsVisible="False" Data="{DynamicResource Icon.ArrowSync}"
                        Foreground="{DynamicResource Vnf.StatusAiFg}" AutomationProperties.Name="IA traduzindo"/>
              <TextBlock Name="PART_PercentText" Text="{TemplateBinding PercentText}" FontSize="12" LineHeight="18"
                         Foreground="{DynamicResource Vnf.TextSecondary}"/>
              <PathIcon Name="PART_Done" Width="14" Height="14" IsVisible="False" Data="{DynamicResource Icon.Check}"
                        Foreground="{DynamicResource Vnf.StatusApprovedFg}"/>
            </StackPanel>
          </Grid>
          <ProgressBar Name="PART_Bar" Grid.Row="1" Classes="thin slim" Minimum="0" Maximum="100" Value="{TemplateBinding Percent}" ShowProgressText="False"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|ScriptItem:unlabeled /template/ TextBlock#PART_Label">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="c|ScriptItem:running /template/ PathIcon#PART_Running">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="c|ScriptItem:running /template/ TextBlock#PART_PercentText">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusAiFg}"/>
  </Style>
  <Style Selector="c|ScriptItem:complete /template/ ProgressBar#PART_Bar">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SegApproved}"/>
  </Style>
  <!-- Pronta: o visto toma o lugar de "100%" (o nome de acessibilidade do item continua dizendo o percentual). -->
  <Style Selector="c|ScriptItem:complete /template/ TextBlock#PART_PercentText">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="c|ScriptItem:complete /template/ PathIcon#PART_Done">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <!-- O script atual é o item selecionado da lista: accent-soft e nome em 600. -->
  <Style Selector="ListBoxItem:selected c|ScriptItem /template/ TextBlock#PART_Label">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Lista de scripts do Editor: itens de raio sm sem barra lateral, hover em bg-card-hover e atual em accent-soft. -->
  <Style Selector="ListBox.scripts">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0,0,0,8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel/>
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <!-- O item da lista leva o cabeçalho do capítulo quando abre um grupo, então o fundo de hover e de atual fica no cartão da cena (Border.scene), não no item inteiro. -->
  <Style Selector="ListBox.scripts > ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.scripts Border.scene">
    <Setter Property="Margin" Value="6,1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.scripts > ListBoxItem:pointerover Border.scene">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
  <Style Selector="ListBox.scripts > ListBoxItem:selected Border.scene">
    <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
  </Style>
</Styles>
