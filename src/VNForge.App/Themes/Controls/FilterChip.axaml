<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Chip de filtro (".v3-chip" do quadro): pílula de 32px com 16px de padding, rótulo 13/18 regular e a contagem (o <b> do quadro) na mesma fonte em 600 e text-primary.
       Marcado: preenchido em accent, borda accent, rótulo e contagem em on-accent. -->
  <Style Selector="c|FilterChip">
    <Setter Property="Height" Value="{DynamicResource Vnf.ControlMd}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}"
                       FontWeight="{TemplateBinding FontWeight}" LineHeight="18" VerticalAlignment="Center"/>
            <TextBlock Name="PART_Count" Text="{TemplateBinding CountText}" Foreground="{DynamicResource Vnf.TextPrimary}" FontWeight="SemiBold" LineHeight="18"
                       IsVisible="{TemplateBinding CountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|FilterChip:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
  <Style Selector="c|FilterChip:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
  </Style>
  <Style Selector="c|FilterChip:checked">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.OnAccent}"/>
  </Style>
  <Style Selector="c|FilterChip:checked /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
  </Style>
  <Style Selector="c|FilterChip:checked /template/ TextBlock#PART_Count">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.OnAccent}"/>
  </Style>
  <Style Selector="c|FilterChip:focus-visible /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.FocusRing}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="c|FilterChip:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextTertiary}"/>
  </Style>
</Styles>
