<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- A aba Pastas e os diálogos da pasta de dados (quadro da #694). Ficam no tema porque o cartão do diálogo vive na camada de sobreposição, fora da árvore da página. -->

  <!-- ".tag": a etiqueta de onde veio a pasta, em pílula de accent-soft, 12/16 médio. -->
  <Style Selector="Border.folder-tag">
    <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Padding" Value="8,2"/>
  </Style>
  <Style Selector="Border.folder-tag TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>

  <!-- ".note.info", ".note.warn" e ".note.err": fundo da severidade, raio 12, respiro de 12 por 14, sem borda; o texto e o ícone levam a cor da severidade (a info, a secundária). -->
  <Style Selector="Border.folder-note, Border.folder-warn, Border.folder-error">
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
    <Setter Property="Padding" Value="14,12"/>
  </Style>
  <Style Selector="Border.folder-note">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
  </Style>
  <Style Selector="Border.folder-warn">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalWarningBg}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="Border.folder-warn PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="Border.folder-error">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalErrorBg}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="Border.folder-error PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>

  <!-- ".swap .field": o caminho em mono num campo de 32, fundo inset e contorno de controle; o destino leva o contorno accent. -->
  <Style Selector="Border.folder-field">
    <Setter Property="Height" Value="{DynamicResource Vnf.ControlMd}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.folder-field.to">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
  </Style>
  <Style Selector="Border.folder-field > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
</Styles>
