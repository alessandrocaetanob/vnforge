<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- InfoBar (docs/design/components/InfoBar): o Fluent do Avalonia não tem. Fundo e ícone pela severidade; texto em text-primary. -->
  <Style Selector="Border.infobar">
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
  </Style>
  <Style Selector="Border.infobar PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
  </Style>
  <Style Selector="Border.infobar.warning">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalWarningBg}"/>
  </Style>
  <Style Selector="Border.infobar.warning PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="Border.infobar.error">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalErrorBg}"/>
  </Style>
  <Style Selector="Border.infobar.error PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="Border.infobar.success">
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusApprovedBg}"/>
  </Style>
  <Style Selector="Border.infobar.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
  </Style>
</Styles>
