<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- ReviewStage: o palco 16:9 do modo revisão. Degradê vertical do quadro (sem vinheta), cartão de capítulo em cima à esquerda e a caixa do jogo encostada na base (encolhe, sem passar do palco, se for grande demais). -->
  <Style Selector="c|ReviewStage">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="{DynamicResource Vnf.RadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource Vnf.StageStroke}" ClipToBounds="True">
          <Border.Background>
            <!-- O degradê do quadro do #532 (medido na captura): azul-acinzentado em cima, quase preto embaixo, igual nos dois temas e sem vinheta nos cantos. -->
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#2A3655"/>
              <GradientStop Offset="0.2" Color="#293452"/>
              <GradientStop Offset="0.59" Color="#20273E"/>
              <GradientStop Offset="0.79" Color="#171D2F"/>
              <GradientStop Offset="1" Color="#0F1320"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Border Name="PART_Chapter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Padding="12,6" CornerRadius="{DynamicResource Vnf.RadiusSm}"
                    Background="{DynamicResource Vnf.StageCard}" IsVisible="{TemplateBinding SceneName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource Vnf.TextboxInk}" Opacity="0.85" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding SceneName}"/>
            </Border>
            <Viewbox Name="PART_Content" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,48,20,20">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Viewbox>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Palco de altura fixa (a fila por risco e a sugestão do editor): a caixa fica centrada no palco, como no quadro, e não encostada na base. -->
  <Style Selector="c|ReviewStage:fixed /template/ Viewbox#PART_Content">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="20"/>
  </Style>
</Styles>
