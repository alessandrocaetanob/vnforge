<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- ReviewStage: o palco 16:9 do modo revisão, como o ".stagebox" do quadro do #546: degradê vertical de stage-top a stage-bottom com a vinheta radial (transparente até 40%, stage-vignette na ponta), borda de 1 px em stage-stroke com o raio lg,
       o cartão da cena em cima à esquerda (12 de margem, stage-card, texto branco 12/16 600) e a caixa do jogo centrada no palco. Igual nos dois temas, porque é a tela do jogo e não a do app. -->
  <Style Selector="c|ReviewStage">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="{DynamicResource Vnf.RadiusLg}" BorderThickness="1" BorderBrush="{DynamicResource Vnf.StageStroke}" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="{DynamicResource Vnf.StageTopColor}"/>
              <GradientStop Offset="1" Color="{DynamicResource Vnf.StageBottomColor}"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Border IsHitTestVisible="False">
              <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="70.7%" RadiusY="70.7%">
                  <GradientStop Offset="0.4" Color="#0004060B"/>
                  <GradientStop Offset="1" Color="{DynamicResource Vnf.StageVignetteColor}"/>
                </RadialGradientBrush>
              </Border.Background>
            </Border>
            <Border Name="PART_Chapter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Padding="10,4" CornerRadius="{DynamicResource Vnf.RadiusSm}" BorderThickness="1"
                    BorderBrush="{DynamicResource Vnf.StageStroke}" Background="{DynamicResource Vnf.StageCard}" IsVisible="{TemplateBinding SceneName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding SceneName}"/>
            </Border>
            <Viewbox Name="PART_Content" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Viewbox>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Palco de altura fixa (a fila por risco e a sugestão do editor): a caixa fica centrada no palco, como no quadro, e não encostada na base. -->
  <Style Selector="c|ReviewStage:fixed /template/ Viewbox#PART_Content">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="20"/>
  </Style>
</Styles>
