<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- ReviewStage: o palco 16:9 do modo revisão. Degradê vertical de Vnf.StageTop a Vnf.StageBottom, vinheta nos cantos, cartão de capítulo em cima à esquerda e a caixa do jogo encostada na base (encolhe, sem passar do palco, se for grande demais). -->
  <Style Selector="c|ReviewStage">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="{DynamicResource Vnf.RadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource Vnf.StageStroke}" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="{DynamicResource Vnf.StageTopColor}"/>
              <GradientStop Offset="1" Color="{DynamicResource Vnf.StageBottomColor}"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Border Name="PART_Vignette" IsHitTestVisible="False">
              <Border.Background>
                <RadialGradientBrush Center="50%,40%" RadiusX="95%" RadiusY="105%">
                  <GradientStop Offset="0.62" Color="Transparent"/>
                  <GradientStop Offset="1" Color="{DynamicResource Vnf.StageVignetteColor}"/>
                </RadialGradientBrush>
              </Border.Background>
            </Border>
            <Border Name="PART_Chapter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Padding="12,6" CornerRadius="{DynamicResource Vnf.RadiusSm}"
                    Background="{DynamicResource Vnf.StageCard}" IsVisible="{TemplateBinding SceneName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource Vnf.TextboxInk}" Opacity="0.85" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding SceneName}"/>
            </Border>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,48,20,20">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Viewbox>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
