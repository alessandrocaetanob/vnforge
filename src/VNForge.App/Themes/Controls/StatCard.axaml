<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Cartão de número do Painel (artboard Painel, ".stat"): painel de bg-card, 16px de respiro, número em 28/32 bold na fonte de exibição,
       a visualização embaixo e um rodapé de 40px que vai de borda a borda, separado por stroke-subtle. -->
  <Style Selector="c|StatCard">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Spacing="8" Margin="16,16,16,0">
              <TextBlock Classes="overline" Text="{TemplateBinding Title}"/>
              <TextBlock Name="PART_Value" Text="{TemplateBinding Value}" FontFamily="{DynamicResource Vnf.FontDisplay}" FontSize="28" LineHeight="32" Padding="0,0,0,3"
                        FontWeight="Bold"/>
              <TextBlock Classes="body-sm secondary" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <ContentPresenter Grid.Row="1" Name="PART_Viz" Margin="16,8,16,16" VerticalAlignment="Bottom" MinHeight="48"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <Border Name="PART_Footer" Grid.Row="2" Classes="divider-top" Height="40" Padding="16,0"
                    IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding Footer}" VerticalAlignment="Center" FontSize="13"/>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
