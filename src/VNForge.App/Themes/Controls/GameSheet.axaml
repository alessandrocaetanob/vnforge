<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Peças da Ficha do jogo (quadro da #554): cartão, selo de etapa, etiqueta, cartão de personagem, campo de revisão e os títulos de cartão. -->
  <Style Selector="Border.sheet-card">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Border.sheet-card.pad6">
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style Selector="TextBlock.sheet-h2">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LineHeight" Value="28"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.sheet-h3">
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TextBlock.sheet-prose">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="LineHeight" Value="24"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MaxWidth" Value="612"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="TextBlock.sheet-note">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="Button.sheet-link">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Selo de etapa (.v3-pill): 11/18 semibold, 1px de cima e de baixo, 8px dos lados. -->
  <Style Selector="Border.sheet-pill">
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusPendingBg}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.sheet-pill > TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusPendingFg}"/>
  </Style>
  <Style Selector="Border.sheet-pill.ai"><Setter Property="Background" Value="{DynamicResource Vnf.StatusAiBg}"/></Style>
  <Style Selector="Border.sheet-pill.ai > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.StatusAiFg}"/></Style>
  <Style Selector="Border.sheet-pill.tr"><Setter Property="Background" Value="{DynamicResource Vnf.StatusTranslatedBg}"/></Style>
  <Style Selector="Border.sheet-pill.tr > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.StatusTranslatedFg}"/></Style>
  <Style Selector="Border.sheet-pill.rev"><Setter Property="Background" Value="{DynamicResource Vnf.StatusReviewedBg}"/></Style>
  <Style Selector="Border.sheet-pill.rev > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.StatusReviewedFg}"/></Style>
  <Style Selector="Border.sheet-pill.ok"><Setter Property="Background" Value="{DynamicResource Vnf.StatusApprovedBg}"/></Style>
  <Style Selector="Border.sheet-pill.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/></Style>
  <Style Selector="Border.sheet-pill.warn"><Setter Property="Background" Value="{DynamicResource Vnf.SignalWarningBg}"/></Style>
  <Style Selector="Border.sheet-pill.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/></Style>

  <!-- Etiqueta (.v3-tag): 24 de altura, 12/16, contorno sutil sobre bg-inset. A sua (.mine) em accent-soft; a escondida (.hid) é tracejada e o traço vem do Rectangle ao lado dela. -->
  <Style Selector="Border.sheet-tag">
    <Setter Property="Height" Value="{DynamicResource Vnf.TagHeight}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.sheet-tag TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.sheet-tag PathIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="Border.sheet-tag.mine">
    <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.sheet-tag.mine TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/></Style>
  <Style Selector="Border.sheet-tag.hid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.sheet-tag.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="Border.sheet-tag.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/></Style>

  <!-- A pílula tracejada do quadro (.spoil): o estado do spoiler e o "Mostrar" do cartão escondido. -->
  <Style Selector="Button.sheet-spoil">
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="Button.sheet-spoil /template/ ContentPresenter#PART_ContentPresenter, Button.sheet-spoil:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.sheet-spoil:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
  </Style>

  <!-- Cartão de personagem (.ctile). -->
  <Style Selector="Border.sheet-tile">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.sheet-portrait-box">
    <Setter Property="Width" Value="{DynamicResource Vnf.PortraitMd}"/>
    <Setter Property="Height" Value="{DynamicResource Vnf.PortraitMd}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Campo de tradução da revisão (.v3-field): bg-card, 14/20, contorno de 1px em stroke-control e de 1,5px em accent no campo que se edita. -->
  <Style Selector="TextBox.sheet-field">
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
  </Style>
  <Style Selector="TextBox.sheet-field /template/ Border#PART_BorderElement, TextBox.sheet-field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox.sheet-field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
  </Style>

  <!-- Barra de progresso da revisão (.pbar): 6 de altura, trilho em bg-inset, preenchimento em accent. -->
  <Style Selector="ProgressBar.sheet-bar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="MinHeight" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="ShowProgressText" Value="False"/>
  </Style>
</Styles>
