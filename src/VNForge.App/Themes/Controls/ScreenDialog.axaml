<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Vnf.Scrim" Color="#8C05080E"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Vnf.Scrim" Color="#59141C2C"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ScreenDialog (v3.css ".scrim" e ".dialog"): o controle no XAML é só o ponto de partida; aberto, o cartão (ScreenDialogSurface) vai para a OverlayLayer. -->
  <Style Selector="c|ScreenDialog">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel/>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- O fundo escurecido cobre a janela e o cartão fica no centro, com a largura de DialogWidth (ou menos, deixando 24px de cada lado). Tab cicla dentro dele.
       Sem divisor acima dos botões e com o X só em ShowClose, como no quadro. -->
  <Style Selector="c|ScreenDialogSurface">
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Scrim" Background="{DynamicResource Vnf.Scrim}"/>
          <Border Name="PART_Dialog" MaxWidth="{TemplateBinding DialogWidth}" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Background="{DynamicResource Vnf.BgCard}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="1"
                  CornerRadius="{DynamicResource Vnf.RadiusLg}" BoxShadow="{DynamicResource Vnf.ShadowFlyout}" Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="title-md" Text="{TemplateBinding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Name="PART_Close" Grid.Column="1" Classes="icon sm subtle" IsVisible="{TemplateBinding ShowClose}" AutomationProperties.Name="Fechar">
                  <PathIcon Width="10" Height="10" Data="{DynamicResource Icon.Dismiss}"/>
                </Button>
              </Grid>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Margin="0,16,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <Border Name="PART_Footer" Grid.Row="2" Margin="0,16,0,0" IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding Footer}"/>
              </Border>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>