<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Cabeçalho de página (artboards): migalha na fonte da interface, caption 12/16 text-secondary, título title-lg e as ações à direita, alinhadas à base. -->
  <Style Selector="c|PageHeader">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="2" VerticalAlignment="Bottom" MinWidth="0">
            <TextBlock Name="PART_Breadcrumb" Classes="caption secondary" Text="{TemplateBinding Breadcrumb}" TextTrimming="CharacterEllipsis"
                       IsVisible="{TemplateBinding Breadcrumb, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Name="PART_Title" Classes="title-lg" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ContentPresenter Name="PART_Actions" Grid.Column="1" VerticalAlignment="Bottom"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Numa linha só (Editor dentro do jogo, que já tem o cabeçalho do jogo acima): o título em title-md, a migalha ao lado e as ações à direita. -->
  <Style Selector="c|PageHeader.inline">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock Name="PART_Title" Classes="title-md" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Name="PART_Breadcrumb" Grid.Column="1" Classes="caption secondary" Text="{TemplateBinding Breadcrumb}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" IsVisible="{TemplateBinding Breadcrumb, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <ContentPresenter Name="PART_Actions" Grid.Column="2" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
