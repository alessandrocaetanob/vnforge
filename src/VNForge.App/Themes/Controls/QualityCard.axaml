<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- QualityCard (v3.css ".qcards .opt"): o OptionCard com o preço em 20/24 bold na fonte de exibição, o tempo em letra pequena e o modelo no canto.
       Marcado, a borda vira accent de 2px. -->
  <Style Selector="c|QualityCard">
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Card" Padding="{TemplateBinding Padding}" Background="{DynamicResource Vnf.BgLayer}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}"
                BorderThickness="1" CornerRadius="{DynamicResource Vnf.RadiusMd}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Panel Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1"/>
                <Ellipse Name="PART_Dot" Width="8" Height="8" Fill="{DynamicResource Vnf.Accent}" IsVisible="False"/>
              </Panel>
              <TextBlock Grid.Column="1" Classes="body-strong" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Name="PART_Model" Grid.Column="2" FontSize="11" LineHeight="14" Foreground="{DynamicResource Vnf.TextSecondary}" Text="{TemplateBinding Model}"
                         VerticalAlignment="Center" IsVisible="{TemplateBinding Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{TemplateBinding Description}"
                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{TemplateBinding ShowPrice}">
              <TextBlock Name="PART_Price" Text="{TemplateBinding PriceText}" FontFamily="{DynamicResource Vnf.FontDisplay}" FontSize="20" LineHeight="26" FontWeight="Bold"
                         VerticalAlignment="Bottom"/>
              <TextBlock Name="PART_Duration" Classes="caption secondary" Text="{TemplateBinding Duration}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                         IsVisible="{TemplateBinding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <TextBlock Name="PART_RateMark" Classes="caption secondary" Text="(cotação de exemplo)" IsVisible="{TemplateBinding ExampleRate}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|QualityCard:pointerover /template/ Border#PART_Card">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
  <Style Selector="c|QualityCard:checked /template/ Border#PART_Card">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="13,11"/>
  </Style>
  <Style Selector="c|QualityCard:checked /template/ Ellipse#PART_Dot">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="c|QualityCard:focus-visible /template/ Border#PART_Card">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.FocusRing}"/>
  </Style>
  <Style Selector="c|QualityCard:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
</Styles>