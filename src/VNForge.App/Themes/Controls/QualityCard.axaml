<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- QualityCard (".opt" e ".v3-qc" do quadro): o OptionCard com o círculo de rádio na linha do título (display 15/20 bold), o preço em 17/24 bold e o tempo ao lado dele, em letra pequena.
       Sem nome de modelo: a qualidade basta. Marcado, só a borda vira accent de 2px; o fundo fica o do cartão. -->
  <Style Selector="c|QualityCard">
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Card" Padding="{TemplateBinding Padding}" Background="{DynamicResource Vnf.BgCard}" BorderBrush="{DynamicResource Vnf.StrokeControl}"
                BorderThickness="1" CornerRadius="{DynamicResource Vnf.RadiusLg}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Border Name="PART_Mark" Classes="radio-mark"/>
              <!-- Sem a classe title-sm: o estilo dela ganha do LineHeight local do template e mandaria 22; o quadro tem 15/20. -->
              <TextBlock Grid.Column="1" FontFamily="{DynamicResource Vnf.FontDisplay}" FontSize="15" LineHeight="20" FontWeight="Bold" Foreground="{DynamicResource Vnf.TextPrimary}"
                         Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Name="PART_Description" Classes="caption secondary" TextWrapping="Wrap" Text="{TemplateBinding Description}"
                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Name="PART_PriceRow" IsVisible="{TemplateBinding ShowPrice}">
              <TextBlock Name="PART_Price" Text="{TemplateBinding PriceText}" FontSize="17" LineHeight="24" FontWeight="Bold"/>
              <!-- Sem as classes caption e secondary: o estilo delas ganha do valor local no template e mandaria 12/16; o quadro tem 12 com entrelinha de 1,6 (19,2, arredondada para 19 no render), que dá os 158 de altura do cartão. -->
              <TextBlock Name="PART_Duration" FontSize="12" LineHeight="19" Foreground="{DynamicResource Vnf.TextSecondary}" TextWrapping="Wrap" Text="{TemplateBinding Duration}"
                         IsVisible="{TemplateBinding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <TextBlock Name="PART_RateMark" Classes="caption secondary" Text="(cotação de exemplo)" IsVisible="{TemplateBinding ExampleRate}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Variante "inline" (Ajustes, v6): o preço e o tempo na mesma linha, de 4 em 4px, e a descrição em 12/20. -->
  <Style Selector="c|QualityCard.inline /template/ StackPanel#PART_PriceRow">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="4"/>
  </Style>
  <Style Selector="c|QualityCard.inline /template/ TextBlock#PART_Description">
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style Selector="c|QualityCard.inline /template/ TextBlock#PART_Duration">
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <Style Selector="c|QualityCard:pointerover /template/ Border#PART_Card">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
  </Style>
  <Style Selector="c|QualityCard:checked /template/ Border#PART_Card">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="15,13"/>
  </Style>
  <Style Selector="c|QualityCard:checked /template/ Border.radio-mark">
    <Setter Property="BorderThickness" Value="5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
  </Style>
  <Style Selector="c|QualityCard:focus-visible /template/ Border#PART_Card">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.FocusRing}"/>
  </Style>
  <Style Selector="c|QualityCard:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
</Styles>
