<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- MarkerChip (v3.css ".mk"): pílula de 20px com o nome do marcador em português. O desenho que a abre é o triângulo de virar a página,
       "↵" na quebra de linha e "✱" na variável. Faltando na tradução (:missing) vira erro. -->
  <Style Selector="c|MarkerChip">
    <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontUi}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Pill" Height="20" Padding="8,0" CornerRadius="10" Background="{TemplateBinding Background}"
                BorderBrush="Transparent" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Name="PART_Triangle" Width="8" Height="6" Data="M0,0 L8,0 L4,6 Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"
                  IsVisible="{TemplateBinding Glyph, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
            <TextBlock Name="PART_Glyph" Text="{TemplateBinding Glyph}" FontSize="12" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                       IsVisible="{TemplateBinding Glyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|MarkerChip:missing">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalErrorBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="c|MarkerChip:missing /template/ Border#PART_Pill">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
</Styles>