<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit">

  <!-- Original: fundo rebaixado (bg-inset), raio sm, em volta do texto com os marcadores como chips. -->
  <Style Selector="Border.original">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="Padding" Value="10,7"/>
  </Style>

  <!-- Memória de tradução (#537): cartão rebaixado como o do Original, com o percentual em selo (aprovado quando exato, IA quando aproximado). -->
  <Style Selector="Border.memory">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="Padding" Value="14,10,14,9"/>
  </Style>
  <Style Selector="Border.memory-item">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0,7,0,10"/>
  </Style>
  <Style Selector="Border.memory-pill">
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusAiBg}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="20"/>
  </Style>
  <Style Selector="Border.memory-pill > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusAiFg}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.memory-pill.exact">
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusApprovedBg}"/>
  </Style>
  <Style Selector="Border.memory-pill.exact > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
  </Style>
  <Style Selector="Button.memory-scene">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Dicionário offline (#538): o cartão da palavra sob o mouse, o .pop do quadro (bg-card, borda de controle, raio md, sombra de flyout). -->
  <Style Selector="Border.word-card">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource Vnf.ShadowFlyout}"/>
    <Setter Property="Padding" Value="14,12"/>
  </Style>
  <Style Selector="Border.word-footer">
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0,8,0,0"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>
  <Style Selector="Border.word-tag">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="20"/>
  </Style>
  <Style Selector="Border.word-tag TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Caption}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxWidth" Value="150"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.word-tag.ok">
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusApprovedBg}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.word-tag.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MaxWidth" Value="170"/>
  </Style>
  <Style Selector="Border.word-tag.ok PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.word-more">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <!-- A origem do dicionário no rodapé e no aviso: texto secundário que é link para a licença; sublinha ao passar o mouse. -->
  <Style Selector="Button.word-source">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.word-source /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.word-source TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Caption}"/>
  </Style>
  <Style Selector="Button.word-source:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
  </Style>
  <Style Selector="Button.word-more /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.word-more TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Caption}"/>
  </Style>

  <!-- TranslationField: fundo de painel e borda de 1px em accent em volta do campo inteiro, sempre, porque é o campo ativo da tela (quadro do #532). -->
  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="ae|TextEditor.translation">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontUi}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Body}"/>
    <Setter Property="ShowLineNumbers" Value="False"/>
    <Setter Property="WordWrap" Value="True"/>
    <Setter Property="MinHeight" Value="72"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>

  <!-- Linha de medidas sob o campo: caracteres, linhas e colunas, e o estado dos marcadores em verde ou vermelho. -->
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.meta.marker-state">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="TextBlock.meta.marker-state.ok">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
  </Style>
  <Style Selector="PathIcon.marker-state">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="PathIcon.marker-state.ok">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
  </Style>

  <!-- A tecla dentro de um botão de destaque: contorno claro em vez do fundo rebaixado. -->
  <Style Selector="Button.accent Border.kbd">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vnf.OnAccent}"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <Style Selector="Button.accent Border.kbd > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.OnAccent}"/>
  </Style>
</Styles>
