<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- docs/design/components/LineRow: colunas 56 · 92 · 132 · 1* · 1.2* · 32 com gap de 8 e recuo de 12 (v4: o texto leva o que sobra). Original em jp-row, o resto em body-sm, o número em mono.
       As três colunas de texto moram numa grade interna (PART_Text): a mesma conta de larguras, e a densidade Roteiro (#460) as empilha em três linhas dessa grade, sem coluna de falante. -->
  <Style Selector="c|LineRow">
    <Setter Property="Height" Value="{DynamicResource Vnf.RowHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
        <Grid Name="PART_Row" ColumnDefinitions="56,92,*,32" ColumnSpacing="8" Margin="{TemplateBinding Padding}">
          <TextBlock Name="PART_Number" Classes="mono secondary" Text="{TemplateBinding NumberText}"/>
          <c:StatusBadge Name="PART_Status" Grid.Column="1" Status="{TemplateBinding Status}"/>
          <Grid Name="PART_Text" Grid.Column="2" ColumnDefinitions="132,*,1.2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2" VerticalAlignment="Center">
            <SelectableTextBlock Name="PART_Speaker" Classes="body-sm" Text="{TemplateBinding SpeakerText}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{TemplateBinding SpeakerTip}"/>
            <TextBlock Name="PART_Original" Classes="jp-row" Text="{TemplateBinding Original}" TextTrimming="CharacterEllipsis"/>
            <Grid Name="PART_TranslationCell" ColumnDefinitions="*,Auto">
              <TextBlock Name="PART_Translation" Classes="body-sm" Text="{TemplateBinding TranslationText}" TextTrimming="CharacterEllipsis"/>
              <Border Name="PART_Doubt" Grid.Column="1" IsVisible="False" Height="18" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                      Background="{DynamicResource Vnf.SignalWarningBg}" ToolTip.Tip="{TemplateBinding DoubtTip}">
                <TextBlock Text="Dúvida" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.SignalWarningFg}"/>
              </Border>
            </Grid>
          </Grid>
          <Panel Name="PART_Issue" Grid.Column="3">
            <PathIcon Name="PART_Warning" Width="16" Height="16" IsVisible="False" Data="{DynamicResource Icon.Warning}"
                      Foreground="{DynamicResource Vnf.SignalWarningFg}" AutomationProperties.Name="{TemplateBinding IssueLabel}" ToolTip.Tip="{TemplateBinding IssueTip}"/>
            <PathIcon Name="PART_Error" Width="16" Height="16" IsVisible="False" Data="{DynamicResource Icon.Error}"
                      Foreground="{DynamicResource Vnf.SignalErrorFg}" AutomationProperties.Name="{TemplateBinding IssueLabel}" ToolTip.Tip="{TemplateBinding IssueTip}"/>
          </Panel>
        </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Colunas: tudo numa linha só, centrado, com reticências. -->
  <Style Selector="c|LineRow /template/ Grid#PART_Row">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|LineRow /template/ TextBlock#PART_Number, c|LineRow /template/ c|StatusBadge#PART_Status, c|LineRow /template/ Panel#PART_Issue">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|LineRow /template/ SelectableTextBlock#PART_Speaker">
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="MaxLines" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|LineRow /template/ TextBlock#PART_Original">
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="MaxLines" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|LineRow /template/ Grid#PART_TranslationCell">
    <Setter Property="Grid.Column" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|LineRow /template/ TextBlock#PART_Translation">
    <Setter Property="MaxLines" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Roteiro (#460): o nome de quem fala é o rótulo em cima (medium; o falante trocado segue em semibold), o original embaixo dele e a tradução por último, até duas linhas cada; o resto da linha fica no alto.
       A altura acompanha o texto, de 72 px (uma linha de cada) a 108 px (duas de cada): a lista mede os itens que mostra e estima o resto pela média. -->
  <Style Selector="c|LineRow:script">
    <Setter Property="Height" Value="NaN"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ Grid#PART_Row">
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ TextBlock#PART_Number, c|LineRow:script /template/ c|StatusBadge#PART_Status, c|LineRow:script /template/ Panel#PART_Issue">
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ Grid#PART_Text">
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ SelectableTextBlock#PART_Speaker">
    <Setter Property="Grid.ColumnSpan" Value="3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ TextBlock#PART_Original">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
    <Setter Property="MaxLines" Value="2"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ Grid#PART_TranslationCell">
    <Setter Property="Grid.Row" Value="2"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ TextBlock#PART_Translation">
    <Setter Property="MaxLines" Value="2"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="c|LineRow:script /template/ Border#PART_Doubt">
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <!-- Narração e "sem tradução" em text-secondary, sem itálico. -->
  <Style Selector="c|LineRow:narration /template/ SelectableTextBlock#PART_Speaker">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <!-- Falante trocado nesta linha: o nome em accent e semibold; a dica diz o que o jogo traz. -->
  <Style Selector="c|LineRow:speaker-changed /template/ SelectableTextBlock#PART_Speaker">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="c|LineRow:untranslated /template/ TextBlock#PART_Translation">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
  </Style>
  <Style Selector="c|LineRow:doubt /template/ Border#PART_Doubt">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="c|LineRow:warning /template/ PathIcon#PART_Warning">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="c|LineRow:error /template/ PathIcon#PART_Error">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <!-- A grade usa a seleção da lista de projetos (accent-soft e barra de 3px); a linha tem altura fixa para a virtualização não medir. -->
  <Style Selector="ListBox.lines > ListBoxItem">
    <Setter Property="Height" Value="{DynamicResource Vnf.RowHeight}"/>
  </Style>
  <Style Selector="ListBox.lines > ListBoxItem /template/ Border#SelectionBar">
    <Setter Property="Margin" Value="0,6"/>
  </Style>
  <Style Selector="ListBox.lines.script > ListBoxItem">
    <Setter Property="Height" Value="NaN"/>
  </Style>
  <Style Selector="ListBox.lines.script > ListBoxItem /template/ Border#SelectionBar">
    <Setter Property="Margin" Value="0,8"/>
  </Style>
</Styles>
