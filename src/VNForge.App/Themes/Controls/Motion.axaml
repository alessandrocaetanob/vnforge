<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- Todo movimento do app mora sob a classe "motion" da janela (Motion.Follow): ela sai quando o Windows pede menos animação. -->

  <!-- Barras de progresso: o indicador desliza até o novo valor. -->
  <Style Selector="Window.motion ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- Barra indeterminada: o FluentTheme anima o indicador sozinho. Sem a classe "motion" ele some e uma faixa parada (Border.static-working, na TaskBar) assume o lugar. -->
  <Style Selector="Window:not(.motion) ProgressBar:indeterminate /template/ Border#PART_Indicator">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Border.static-working">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.Accent}"/>
    <Setter Property="Opacity" Value="0.5"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="Window:not(.motion) Border.static-working.indeterminate">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <!-- Ícone girando nas tarefas em andamento. -->
  <Style Selector="PathIcon.spin">
    <Setter Property="RenderTransform" Value="rotate(0deg)"/>
  </Style>
  <Style Selector="Window.motion PathIcon.spin">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Pulso verde curto na linha que acabou de ser aprovada (Motion.PulseOnApproval põe a classe por 700 ms). -->
  <Style Selector="Window.motion c|LineRow.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.7" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Background" Value="#555FBF7F"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Background" Value="#005FBF7F"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Triângulo de virar a página da caixa do jogo: sobe e desce 3 px. Sem a classe "motion" (o Windows pediu menos movimento) fica parado. -->
  <Style Selector="Window.motion c|GameTextbox">
    <Style.Animations>
      <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="NextOffset" Value="0"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="NextOffset" Value="3"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Esqueleto: as faixas pulsam devagar. -->
  <Style Selector="Window.motion c|Skeleton">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.45"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
