<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- TodoItem (v3.css ".ready"): ícone de gravidade em 20px, título, explicação em 12/16 e o botão que resolve à direita; 48px no mínimo, divisória embaixo. -->
  <Style Selector="c|TodoItem">
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12">
            <PathIcon Name="PART_Icon" Width="20" Height="20" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Data="{DynamicResource Icon.Check}"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{TemplateBinding Title}" TextWrapping="Wrap"/>
              <TextBlock Classes="caption secondary" Text="{TemplateBinding Message}" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <Button Name="PART_Action" Grid.Column="2" Classes="link sm" VerticalAlignment="Center" Command="{TemplateBinding Command}" Content="{TemplateBinding ActionText}"
                    IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|TodoItem:warning">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="c|TodoItem:warning /template/ PathIcon#PART_Icon">
    <Setter Property="Data" Value="{DynamicResource Icon.Warning}"/>
  </Style>
  <Style Selector="c|TodoItem:error">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="c|TodoItem:error /template/ PathIcon#PART_Icon">
    <Setter Property="Data" Value="{DynamicResource Icon.Error}"/>
  </Style>
</Styles>