<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VNForge.App.Controls">

  <!-- TodoItem (linha do cartão "Precisa de você" do quadro da #544): ícone de gravidade em 24px, título em peso forte, explicação em 12/16 e o botão que resolve à direita em 14 semibold;
       50px no mínimo, divisória embaixo. -->
  <Style Selector="c|TodoItem">
    <Setter Property="MinHeight" Value="50"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="12">
            <PathIcon Name="PART_Icon" Width="24" Height="24" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Data="{DynamicResource Icon.Check}"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="body-strong" Foreground="{DynamicResource Vnf.TextPrimary}" Text="{TemplateBinding Title}" TextWrapping="Wrap"/>
              <TextBlock Classes="caption secondary" Text="{TemplateBinding Message}" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <Button Name="PART_Action" Grid.Column="2" Classes="link todo-action" VerticalAlignment="Center" Command="{TemplateBinding Command}" Content="{TemplateBinding ActionText}"
                    IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- A ação do quadro é em 14 semibold e colada na margem; o link sm (13, regular, 8px de vão) não serve. -->
  <Style Selector="Button.link.todo-action">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="c|TodoItem:warning">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="c|TodoItem:warning /template/ PathIcon#PART_Icon">
    <Setter Property="Data" Value="{DynamicResource Icon.Warning}"/>
  </Style>
  <Style Selector="c|TodoItem:error">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
  </Style>
  <Style Selector="c|TodoItem:error /template/ PathIcon#PART_Icon">
    <Setter Property="Data" Value="{DynamicResource Icon.Error}"/>
  </Style>
</Styles>