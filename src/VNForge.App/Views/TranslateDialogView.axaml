<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.TranslateDialogView"
             x:DataType="vm:TranslateDialogViewModel">

  <!-- Traduzir com IA (U12): o diálogo vive na camada de sobreposição, sobre o Editor; Escape e o X fecham. Três perguntas: o que, com que qualidade e por quanto. -->
  <c:ScreenDialog Title="Traduzir com IA" IsOpen="{Binding IsOpen, Mode=TwoWay}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Styles>
        <!-- Escopo sem linha pendente: o cartão fica apagado (60%, como no quadro). O diálogo sobe para a camada de sobreposição, então o estilo mora dentro dele. -->
        <Style Selector="RadioButton.option:disabled">
          <Setter Property="Opacity" Value="0.6"/>
        </Style>
      </ScrollViewer.Styles>
      <StackPanel Spacing="16" AutomationProperties.Name="Traduzir com IA">

        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="O que traduzir"/>
          <ItemsControl ItemsSource="{Binding Scopes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" ColumnSpacing="12" RowSpacing="12"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScopeChoice">
                <RadioButton Classes="option marked" GroupName="TranslateScope" VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Classes="radio-mark"/>
                      <TextBlock Grid.Column="1" Classes="title-sm" LineHeight="20" Text="{Binding Title}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Summary}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Com que qualidade"/>
          <ItemsControl ItemsSource="{Binding Qualities}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" ColumnSpacing="12" RowSpacing="12"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QualityChoice">
                <c:QualityCard GroupName="TranslateQuality" VerticalAlignment="Stretch" Title="{Binding Title}" Description="{Binding Description}"
                               Price="{Binding Price}" Duration="{Binding Duration}"
                               IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowWhen}">
          <TextBlock Classes="overline" Text="Quando"/>
          <ItemsControl ItemsSource="{Binding Whens}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WhenChoice">
                <RadioButton Classes="option marked" GroupName="TranslateWhen" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Classes="radio-mark"/>
                      <TextBlock Grid.Column="1" Classes="title-sm" LineHeight="20" Text="{Binding Title}" VerticalAlignment="Center"/>
                      <!-- ".chipx.ai" do quadro: 24px de altura, 12/16 semibold, a lua em traço de 1,4 num quadro de 20 desenhado a 14px. -->
                      <Border Grid.Column="2" Height="24" Padding="10,0" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                              Background="{DynamicResource Vnf.StatusAiBg}" TextElement.Foreground="{DynamicResource Vnf.StatusAiFg}"
                              IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Viewbox Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"><Path Width="20" Height="20" Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Vnf.StatusAiFg}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"/></Viewbox>
                          <TextBlock FontSize="12" LineHeight="16" FontWeight="SemiBold" Text="{Binding Tag}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Quanto custa"/>
          <!-- ".card.in" do quadro: fundo bg-inset, raio de 12, respiro de 12 por 14; a trilha da barra tem a cor do cartão, então só os trechos coloridos aparecem. -->
          <Border Background="{DynamicResource Vnf.BgInset}" CornerRadius="{DynamicResource Vnf.RadiusMd}" Padding="14,12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="16" LineHeight="24" FontWeight="SemiBold" Text="{Binding RequestText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="caption secondary" LineHeight="18" Text="{Binding SpentText}" VerticalAlignment="Center"/>
              </Grid>
              <c:BudgetBar IsInset="True" Spent="{Binding SpentBrl}" Ask="{Binding AskBrl}" Limit="{Binding LimitBrl}"
                           AutomationProperties.Name="Gasto do projeto, este pedido e o limite"/>
              <TextBlock Classes="caption secondary" LineHeight="18" TextWrapping="Wrap" Text="{Binding BatchNote}"
                         IsVisible="{Binding BatchNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Classes="caption secondary" LineHeight="18" TextWrapping="Wrap" Text="{Binding RateNote}"
                         IsVisible="{Binding RateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="infobar banner error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding LoadError}"/>
          </Grid>
        </Border>

        <Border Classes="infobar banner warning" IsVisible="{Binding IsOverLimit}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OverLimitText}"/>
            <Button Grid.Column="2" Classes="sm accent" Command="{Binding SwitchToFitCommand}" Content="{Binding SwitchToFitText}"
                    IsVisible="{Binding CanSwitchToFit}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Classes="infobar banner warning" IsVisible="{Binding HasBudgetProblem}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding BudgetProblemText}"/>
          </Grid>
        </Border>

        <Border Classes="infobar banner warning" IsVisible="{Binding AboveWarning}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Este pedido custa mais que o valor de aviso que você definiu em Ajustes. Confira o valor antes de seguir."/>
          </Grid>
        </Border>

        <Border Classes="infobar banner warning" IsVisible="{Binding HasMissingGender}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MissingGenderText}"/>
            <Button Grid.Column="2" Classes="sm" Command="{Binding DefineGendersCommand}" Content="Definir agora" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- A passada de editor (#532): marcada, com o preço à parte do pedido. Nada é gravado sozinho. -->
        <Border x:Name="EditorPassCard" Classes="panel" Padding="16" IsVisible="{Binding !NothingToTranslate}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox x:Name="EditorPassCheck" IsChecked="{Binding EditorPass}" IsEnabled="{Binding CanChooseEditorPass}" AutomationProperties.Name="Depois, uma passada de editor em cada cena">
              <StackPanel Spacing="2">
                <TextBlock Classes="body" FontWeight="SemiBold" TextWrapping="Wrap" Text="Depois, uma passada de editor em cada cena"/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap"
                           Text="Outro pedido lê a cena traduzida inteira e deixa ajustes de fluidez, voz e consistência como sugestão na linha. Nada é gravado sozinho."/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" IsVisible="{Binding IsOvernight}"
                           Text="Não vale na tradução durante a noite: o lote só volta horas depois."/>
              </StackPanel>
            </CheckBox>
            <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Top" Text="{Binding EditorPassPriceText}" AutomationProperties.Name="Preço da passada de editor"/>
          </Grid>
        </Border>

        <Border Classes="infobar banner error" IsVisible="{Binding KeyMissing}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding KeyMissingText}"/>
            <Button Grid.Column="2" Classes="sm" Command="{Binding OpenSettingsCommand}" Content="Abrir Ajustes" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="Não há linhas sem tradução neste escopo." IsVisible="{Binding NothingToTranslate}"/>
        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding ContextText}"/>
      </StackPanel>
    </ScrollViewer>

    <c:ScreenDialog.Footer>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancelar" Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
        <Button Classes="accent lg" Command="{Binding StartCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding StartLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}" IsVisible="{Binding !IsOvernight}"/>
            <TextBlock Text="{Binding StartLabel}" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </c:ScreenDialog.Footer>
  </c:ScreenDialog>
</UserControl>
