<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.TranslateDialogView"
             x:DataType="vm:TranslateDialogViewModel">

  <!-- Traduzir com IA (U12): o diálogo vive na camada de sobreposição, sobre o Editor; Escape e o X fecham. Três perguntas: o que, com que qualidade e por quanto. -->
  <c:ScreenDialog Title="Traduzir com IA" DialogWidth="780" ShowClose="True" IsOpen="{Binding IsOpen, Mode=TwoWay}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Styles>
        <!-- Escopo sem linha pendente: o cartão fica apagado, como o QualityCard desligado. O diálogo sobe para a camada de sobreposição, então o estilo mora dentro dele. -->
        <Style Selector="RadioButton.option:disabled">
          <Setter Property="Opacity" Value="0.5"/>
        </Style>
      </ScrollViewer.Styles>
      <StackPanel Spacing="16" AutomationProperties.Name="Traduzir com IA">

        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="O que traduzir"/>
          <ItemsControl ItemsSource="{Binding Scopes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScopeChoice">
                <RadioButton Classes="option" GroupName="TranslateScope" VerticalAlignment="Stretch" VerticalContentAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}"/>
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Summary}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Com que qualidade"/>
          <ItemsControl ItemsSource="{Binding Qualities}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QualityChoice">
                <c:QualityCard GroupName="TranslateQuality" Margin="0,0,8,0" Title="{Binding Title}" Description="{Binding Description}"
                               Price="{Binding Price}" Duration="{Binding Duration}"
                               IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowWhen}">
          <c:OverlineText Classes="overline" Text="Quando"/>
          <ItemsControl ItemsSource="{Binding Whens}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WhenChoice">
                <RadioButton Classes="option" GroupName="TranslateWhen" Margin="0,0,8,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Height="20" Padding="6,0,8,0" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                              Background="{DynamicResource Vnf.StatusAiBg}" TextElement.Foreground="{DynamicResource Vnf.StatusAiFg}"
                              IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Moon}" AutomationProperties.AccessibilityView="Raw"/>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Tag}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Quanto custa"/>
          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="{Binding RequestText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding SpentText}" VerticalAlignment="Center"/>
              </Grid>
              <c:BudgetBar Spent="{Binding SpentBrl}" Ask="{Binding AskBrl}" Limit="{Binding LimitBrl}"
                           AutomationProperties.Name="Gasto do projeto, este pedido e o limite"/>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding BatchNote}"
                         IsVisible="{Binding BatchNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding RateNote}"
                         IsVisible="{Binding RateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="infobar error" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding LoadError}"/>
          </Grid>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding IsOverLimit}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OverLimitText}"/>
            <Button Grid.Column="2" Classes="sm accent" Command="{Binding SwitchToFitCommand}" Content="{Binding SwitchToFitText}"
                    IsVisible="{Binding CanSwitchToFit}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding HasBudgetProblem}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding BudgetProblemText}"/>
          </Grid>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding AboveWarning}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Este pedido custa mais que o valor de aviso que você definiu em Ajustes. Confira o valor antes de seguir."/>
          </Grid>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding HasMissingGender}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MissingGenderText}"/>
            <Button Grid.Column="2" Classes="sm" Command="{Binding DefineGendersCommand}" Content="Definir agora" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- A passada de editor (#532): marcada, com o preço à parte do pedido. Nada é gravado sozinho. -->
        <Border x:Name="EditorPassCard" Classes="panel" Padding="16" IsVisible="{Binding !NothingToTranslate}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox x:Name="EditorPassCheck" IsChecked="{Binding EditorPass}" IsEnabled="{Binding CanChooseEditorPass}" AutomationProperties.Name="Depois, uma passada de editor em cada cena">
              <StackPanel Spacing="2">
                <TextBlock Classes="body" FontWeight="SemiBold" TextWrapping="Wrap" Text="Depois, uma passada de editor em cada cena"/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap"
                           Text="Outro pedido lê a cena traduzida inteira e deixa ajustes de fluidez, voz e consistência como sugestão na linha. Nada é gravado sozinho."/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" IsVisible="{Binding IsOvernight}"
                           Text="Não vale na tradução durante a noite: o lote só volta horas depois."/>
              </StackPanel>
            </CheckBox>
            <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Top" Text="{Binding EditorPassPriceText}" AutomationProperties.Name="Preço da passada de editor"/>
          </Grid>
        </Border>

        <Border Classes="infobar error" IsVisible="{Binding KeyMissing}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding KeyMissingText}"/>
            <Button Grid.Column="2" Classes="sm" Command="{Binding OpenSettingsCommand}" Content="Abrir Ajustes" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="Não há linhas sem tradução neste escopo." IsVisible="{Binding NothingToTranslate}"/>
        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding ContextText}"/>
      </StackPanel>
    </ScrollViewer>

    <c:ScreenDialog.Footer>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancelar" Command="{Binding CancelCommand}"/>
        <Button Classes="accent" Command="{Binding StartCommand}" AutomationProperties.Name="{Binding StartLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}" IsVisible="{Binding !IsOvernight}"/>
            <TextBlock Text="{Binding StartLabel}" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </c:ScreenDialog.Footer>
  </c:ScreenDialog>
</UserControl>
