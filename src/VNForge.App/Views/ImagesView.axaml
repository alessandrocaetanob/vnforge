<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:vm="using:VNForge.App.ViewModels"
             x:Class="VNForge.App.Views.ImagesView"
             x:DataType="vm:ImagesViewModel">

  <UserControl.Styles>
    <!-- A faixa de miniaturas (decisão 1 do quadro): 120×68, estado num ponto no canto, a imagem em edição com contorno accent de 3px. -->
    <Style Selector="ListBox.thumbs">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,4,14,4"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.thumbs > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.thumbs > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem Border.thumb">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem:pointerover Border.thumb">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
    </Style>
    <Style Selector="ListBox.thumbs > ListBoxItem:selected Border.thumb">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    </Style>

    
    <!-- Segmentado em pílula (v3-seg do quadro): trilho inset arredondado, o segmento escolhido sobe para a cor de cartão com fio de 1px. -->
    <Style Selector="ListBox.pillseg">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4"/>
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.pillseg > ListBoxItem">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="14"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.pillseg > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    </Style>
    <Style Selector="ListBox.pillseg > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    </Style>

    <!-- Amostra de cor do texto: um círculo de 24px; a escolhida ganha o anel accent de 2px por fora. -->
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <Border MinHeight="{Binding #Scroller.Viewport.Height}" Padding="32,12,32,14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">

          <Border Classes="infobar error" Margin="0,0,0,12" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
              <SelectableTextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}" AutomationProperties.Name="Mensagem de erro"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ItemsControl ItemsSource="{Binding Chips}" AutomationProperties.Name="Filtros das imagens" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageFilterChipViewModel">
                  <c:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsChecked="{Binding IsSelected}" Margin="0,0,8,0"
                                Click="OnChipClick"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenInventoryCommand}" IsEnabled="{Binding CanOpenInventory}" AutomationProperties.Name="Abrir inventário">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                <TextBlock Text="Abrir inventário"/>
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Row="2" Grid.RowSpan="3" Spacing="12" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:EmptyState Message="O inventário das imagens com texto está vazio. A IA lê as imagens dos pacotes do jogo e anota o texto em japonês de cada uma."
                          ActionText="Ler as imagens com a IA" ActionCommand="{Binding ScanCommand}"
                          IsVisible="{Binding !IsScanBusy}"/>
            <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsScanBusy}">
              <ProgressBar IsIndeterminate="True" Width="320"/>
              <TextBlock Classes="body-sm secondary" HorizontalAlignment="Center" Text="{Binding ScanProgressText}" AutomationProperties.Name="Andamento da leitura"/>
              <Button HorizontalAlignment="Center" Content="Cancelar a leitura" Command="{Binding StopScanCommand}" IsVisible="{Binding IsScanning}"/>
            </StackPanel>
          </StackPanel>

          <ListBox Grid.Row="2" Classes="thumbs" Margin="0,10,0,0" ItemsSource="{Binding Visible}" SelectedItem="{Binding SelectedItem}" Height="76" AutomationProperties.Name="Imagens do inventário"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ImageItemViewModel">
                <Panel Width="120" Height="68" ToolTip.Tip="{Binding Caption}">
                  <Border Classes="thumb" BorderThickness="3" CornerRadius="{DynamicResource Vnf.RadiusSm}" Background="{DynamicResource Vnf.BgInset}" ClipToBounds="True">
                    <Image Source="{Binding ThumbnailPng, Converter={x:Static c:PngBytesConverter.Instance}}" Stretch="UniformToFill"/>
                  </Border>
                  <Border Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                          Background="{DynamicResource Vnf.BgLayer}" Padding="2">
                    <Panel>
                      <Ellipse Fill="{DynamicResource Vnf.StatusApprovedFg}" IsVisible="{Binding IsMarkedState}"/>
                      <Ellipse Fill="{DynamicResource Vnf.Accent}" IsVisible="{Binding IsDraftState}"/>
                      <Ellipse Fill="{DynamicResource Vnf.StatusPendingFg}" IsVisible="{Binding IsPendingState}"/>
                    </Panel>
                  </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8" IsVisible="{Binding HasImage}">
            <Button Classes="sm" Classes.accent="{Binding IsSelectTool}" Command="{Binding UseToolCommand}" CommandParameter="{x:Static vm:ImageTool.SelectArea}"
                    AutomationProperties.Name="Selecionar área">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="16" Height="16">
                  <Canvas Width="20" Height="20">
                    <Path StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stroke="{Binding $parent[Button].Foreground}" Data="M4,4 H16 V16 H4 Z" StrokeDashArray="1.7,1.4"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Selecionar área"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="sm" Classes.accent="{Binding IsEraseTool}" Command="{Binding UseToolCommand}" CommandParameter="{x:Static vm:ImageTool.Erase}"
                    Click="OnEraseToolClick" AutomationProperties.Name="Apagar">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="16" Height="16">
                  <Canvas Width="20" Height="20">
                    <Path StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stroke="{Binding $parent[Button].Foreground}" Data="M4,12.5 L10,6 L15.5,11 L11.5,15.5 H7.5 Z M8,16 H16"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Apagar"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="sm" Classes.accent="{Binding IsTextTool}" Command="{Binding UseToolCommand}" CommandParameter="{x:Static vm:ImageTool.Text}"
                    Click="OnTextToolClick" AutomationProperties.Name="Texto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="16" Height="16">
                  <Canvas Width="20" Height="20">
                    <Path StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stroke="{Binding $parent[Button].Foreground}" Data="M5,5 H15 M10,5 V15 M8,15 H12"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Texto"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="subtle sm" Command="{Binding UndoCommand}" AutomationProperties.Name="Desfazer">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Undo}"/>
                <TextBlock Text="Desfazer"/>
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="4" Classes="caption secondary" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding SelectedItem.Summary}"/>
          </Grid>

          <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding HasImage}">
            <StackPanel Spacing="14" VerticalAlignment="Top">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="title-sm" Text="Original"/>
                      <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="área marcada para apagar"/>
                    </Grid>
                    <Border CornerRadius="{DynamicResource Vnf.RadiusMd}" ClipToBounds="True">
                      <Viewbox Name="OriginalBox" Stretch="Uniform" SizeChanged="OnOriginalSizeChanged">
                        <Grid x:Name="OriginalSurface" SizeChanged="OnOriginalSizeChanged" Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Background="Transparent" Cursor="Cross"
                              AutomationProperties.Name="Imagem original">
                          <Image Source="{Binding OriginalPng, Converter={x:Static c:PngBytesConverter.Instance}}" Stretch="Fill"/>
                          <Canvas IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding RegionX}" Canvas.Top="{Binding RegionY}" Width="{Binding RegionWidth}" Height="{Binding RegionHeight}"
                                       Stroke="{DynamicResource Vnf.Accent}" StrokeThickness="{Binding OverlayStroke}" StrokeDashArray="3,2"/>
                            <Rectangle Canvas.Left="{Binding HandleLeft}" Canvas.Top="{Binding HandleTop}" Width="{Binding HandleSize}" Height="{Binding HandleSize}" Fill="{DynamicResource Vnf.Accent}"/>
                            <Rectangle Canvas.Left="{Binding HandleRight}" Canvas.Top="{Binding HandleTop}" Width="{Binding HandleSize}" Height="{Binding HandleSize}" Fill="{DynamicResource Vnf.Accent}"/>
                            <Rectangle Canvas.Left="{Binding HandleLeft}" Canvas.Top="{Binding HandleBottom}" Width="{Binding HandleSize}" Height="{Binding HandleSize}" Fill="{DynamicResource Vnf.Accent}"/>
                            <Rectangle Canvas.Left="{Binding HandleRight}" Canvas.Top="{Binding HandleBottom}" Width="{Binding HandleSize}" Height="{Binding HandleSize}" Fill="{DynamicResource Vnf.Accent}"/>
                          </Canvas>
                        </Grid>
                      </Viewbox>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="panel" Padding="12">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="title-sm" Text="Traduzida"/>
                      <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="prévia lado a lado"/>
                    </Grid>
                    <Border CornerRadius="{DynamicResource Vnf.RadiusMd}" ClipToBounds="True">
                      <Viewbox Stretch="Uniform">
                        <Image Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Stretch="Fill" AutomationProperties.Name="Imagem traduzida"
                               Source="{Binding PreviewPng, Converter={x:Static c:PngBytesConverter.Instance}}"/>
                      </Viewbox>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="panel" Padding="16,14">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Classes="title-sm" VerticalAlignment="Center" Text="O que muda no build"/>
                    <Button Grid.Column="1" Classes="sm" Command="{Binding RewriteCommand}" IsEnabled="{Binding CanRewrite}" Content="{Binding RewriteLabel}"
                            AutomationProperties.Name="Regravar as imagens no pacote"/>
                    <Border Grid.Column="2" Height="24" Background="{DynamicResource Vnf.StatusAiBg}" CornerRadius="12" Padding="10,0" VerticalAlignment="Center">
                      <TextBlock Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.StatusAiFg}" Text="{Binding MarkedText}"/>
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                    <TextBlock Classes="body-sm secondary" Text="Área apagada"/>
                    <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErasedText}"/>
                    <TextBlock Grid.Row="1" Classes="body-sm secondary" Text="Texto novo"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding NewTextSummary}"/>
                    <TextBlock Grid.Row="2" Classes="body-sm secondary" Text="{Binding PackageLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding PackageText}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Column="1" Classes="panel" Padding="16" IsEnabled="{Binding IsEditable}">
              <Grid RowDefinitions="*,Auto">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="6" IsVisible="{Binding SelectedItem.HasText}">
                    <TextBlock Classes="overline" Text="Lido pela IA · Haiku com visão"/>
                    <Border Background="{DynamicResource Vnf.BgInset}" CornerRadius="{DynamicResource Vnf.RadiusMd}" Padding="14,12">
                      <StackPanel Spacing="4">
                        <SelectableTextBlock TextWrapping="Wrap" FontFamily="{DynamicResource Vnf.FontJp}" FontSize="{DynamicResource Vnf.FontSize.JpRow}" LineHeight="{DynamicResource Vnf.LineHeight.JpRow}"
                                             Text="{Binding SelectedItem.JapaneseText}" AutomationProperties.Name="Texto em japonês lido na imagem"/>
                        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding SelectedItem.Translation}"
                                   IsVisible="{Binding SelectedItem.HasTranslation}" AutomationProperties.Name="Tradução sugerida pela IA"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Classes="overline" Text="Texto na imagem"/>
                    <TextBox Name="ImageText" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Texto da tradução na imagem"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,80" ColumnSpacing="10">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="overline" Text="Fonte"/>
                      <ComboBox ItemsSource="{Binding FontChoices}" SelectedItem="{Binding Font}" HorizontalAlignment="Stretch" AutomationProperties.Name="Fonte do texto"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Classes="overline" Text="Tamanho"/>
                      <TextBox Text="{Binding FontSizeText}" AutomationProperties.Name="Tamanho da fonte em pixels"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="overline" Text="Cor"/>
                      <ItemsControl ItemsSource="{Binding TextSwatches}" AutomationProperties.Name="Cor do texto">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ColorSwatchViewModel">
                            <Button Classes="swatch" Command="{Binding $parent[ItemsControl].((vm:ImagesViewModel)DataContext).PickTextColorCommand}" CommandParameter="{Binding Hex}"
                                    AutomationProperties.Name="{Binding Hex, StringFormat='Cor {0}'}">
                              <Panel Width="24" Height="24">
                                <Ellipse Fill="{Binding Hex}"/>
                                <Ellipse Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1" IsVisible="{Binding IsLight}"/>
                                <Ellipse Margin="-2" Stroke="{DynamicResource Vnf.Accent}" StrokeThickness="2" IsVisible="{Binding IsSelected}"/>
                              </Panel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Classes="overline" Text="Contorno"/>
                      <TextBox Text="{Binding OutlineText}" AutomationProperties.Name="Contorno do texto"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Classes="overline" Text="Apagar a área"/>
                    <ListBox Name="EraseModes" Classes="pillseg" ItemsSource="{Binding EraseChoices}" SelectedItem="{Binding SelectedEraseChoice}" AutomationProperties.Name="Como apagar a área"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding UsesSolidErase}">
                      <Ellipse Width="24" Height="24" Fill="{Binding EraseColor}" Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1"/>
                      <TextBox Grid.Column="1" Text="{Binding EraseColor}" AutomationProperties.Name="Cor lisa da área apagada"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="16" Height="16" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Data="{StaticResource Icon.Check}" IsVisible="{Binding FitsRegion}"/>
                    <PathIcon Width="16" Height="16" Foreground="{DynamicResource Vnf.SignalWarningFg}" Data="{StaticResource Icon.Warning}" IsVisible="{Binding !FitsRegion}"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding FitText}"
                               IsVisible="{Binding FitsRegion}" AutomationProperties.Name="Se o texto cabe na área"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding FitText}"
                               IsVisible="{Binding !FitsRegion}" AutomationProperties.Name="Aviso de que o texto não cabe na área"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,12,0,0">
                  <Button Classes="accent" Command="{Binding MarkCommand}" AutomationProperties.Name="Marcar para o build">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Check}"/>
                      <TextBlock Text="Marcar para o build"/>
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding UnmarkCommand}" IsEnabled="{Binding IsMarked}" AutomationProperties.Name="Tirar do build" ToolTip.Tip="Tira a imagem do build sem perder a edição">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Undo}"/>
                      <TextBlock Text="Desfazer"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </ScrollViewer>

    <c:ScreenDialog Title="{Binding ConfirmationTitle}" IsOpen="{Binding IsConfirming, Mode=OneWay}" CloseCommand="{Binding CancelRewriteCommand}">
      <StackPanel Spacing="16" MinWidth="520">
        <TextBlock Classes="body secondary" TextWrapping="Wrap"
                   Text="Só as imagens que você alterou entram no build. O resto do arquivo não muda: a reescrita é a mínima, e o teste de ida e volta confere o que ficou igual."/>
        <Border Background="{DynamicResource Vnf.BgInset}" CornerRadius="{DynamicResource Vnf.RadiusMd}" Padding="14,12">
          <ItemsControl ItemsSource="{Binding ConfirmationFiles}" AutomationProperties.Name="Imagens que entram no build">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RewriteFile">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Classes="mono" FontWeight="Medium" Text="{Binding Path}"/>
                  <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding Detail}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Border Background="{DynamicResource Vnf.BgInset}" CornerRadius="{DynamicResource Vnf.RadiusMd}" Padding="14,12">
          <ItemsControl ItemsSource="{Binding ConfirmationFacts}" AutomationProperties.Name="Resumo do build">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultFact">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Classes="body" Text="{Binding Label}"/>
                  <TextBlock Grid.Column="1" Classes="body" FontWeight="SemiBold" Text="{Binding Value}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
      <c:ScreenDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelRewriteCommand}"/>
          <Button Classes="accent lg" Content="{Binding ConfirmationButton}" Command="{Binding ConfirmRewriteCommand}" AutomationProperties.Name="{Binding ConfirmationButton}"/>
        </StackPanel>
      </c:ScreenDialog.Footer>
    </c:ScreenDialog>

    <c:ScreenDialog Title="{Binding ScanTitle}" IsOpen="{Binding IsScanConfirming, Mode=OneWay}" CloseCommand="{Binding CancelScanCommand}">
      <StackPanel Spacing="16" MinWidth="520">
        <TextBlock Classes="body secondary" TextWrapping="Wrap"
                   Text="A IA abre cada imagem do jogo, diz se tem texto em japonês, transcreve esse texto e sugere uma tradução. Nada no jogo muda: o resultado vai para o inventário do projeto (images.json)."/>
        <Border Background="{DynamicResource Vnf.BgInset}" CornerRadius="{DynamicResource Vnf.RadiusMd}" Padding="14,12">
          <ItemsControl ItemsSource="{Binding ScanFacts}" AutomationProperties.Name="Resumo da leitura">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultFact">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Classes="body" Text="{Binding Label}"/>
                  <TextBlock Grid.Column="1" Classes="body" FontWeight="SemiBold" Text="{Binding Value}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
      <c:ScreenDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelScanCommand}"/>
          <Button Classes="accent lg" Content="Ler as imagens" Command="{Binding ConfirmScanCommand}" AutomationProperties.Name="Ler as imagens"/>
        </StackPanel>
      </c:ScreenDialog.Footer>
    </c:ScreenDialog>
  </Grid>
</UserControl>
