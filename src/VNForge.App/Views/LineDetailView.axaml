<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:v="using:VNForge.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.LineDetailView"
             x:DataType="vm:LineDetailViewModel">

  <UserControl.Resources>
    <!-- A linha de estado dos marcadores: um só desenho, usado no inspetor compacto (ao lado do "Cabe") e no largo (abaixo). -->
    <DataTemplate x:Key="MarkerStateRow" x:DataType="vm:LineDetailViewModel">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding MarkersMatch}" Data="{StaticResource Icon.Check}" IsVisible="{Binding MarkersMatch}"/>
        <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding !MarkersMatch}"/>
        <TextBlock Classes="meta marker-state" Classes.ok="{Binding MarkersMatch}" Text="{Binding MarkerStateText}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineDetail.axaml"/>
    <!-- O botão "Usar sugestão" é o da linha de botões do inspetor; o do cartão fica só no controle da galeria. -->
    <Style Selector="c|AiSuggestion /template/ Button#PART_Use">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Nas abas o "Usar esta sugestão" também fica junto do cartão, na aba Sugestão; a barra fixa do rodapé vale nas duas disposições. -->
    <Style Selector="StackPanel.tab-only">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl).tabbed StackPanel.tab-only">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Na aba Sugestão o "Usar esta sugestão" do cartão faz o mesmo: o do rodapé sai para não haver dois botões iguais. -->
    <Style Selector=":is(UserControl).tabbed.suggestion-tab Button.use-in-row">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Inspetor estreito (janela mínima e abas): a tecla e o ícone saem dos botões para o texto não quebrar nem ser cortado. -->
    <!-- Nas abas (janela pequena) o cabeçalho perde o retrato e o papel: a caixa do jogo tem de continuar inteira na aba Tradução, e o papel e a voz já estão na aba Contexto. -->
    <Style Selector=":is(UserControl).tabbed c|Portrait, :is(UserControl).tabbed TextBlock.header-role">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl).compact Border.kbd, :is(UserControl).tight PathIcon.compact-hide">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Com a sugestão da passada de editor aberta, o "Usar sugestão" do rodapé (quadro do #532) aceita o texto dela, como o "Aceitar" do cartão; o botão da sugestão da IA dá lugar a ele.
         Por classe, e não por IsVisible, para a regra das abas acima seguir valendo. -->
    <Style Selector="Button.use-in-row.editor-suggestion">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.use-in-row.editor-use">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.use-in-row.editor-use.editor-suggestion">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.use-in-row">
      <Setter Property="Grid.Column" Value="1"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <!-- Texto grande num inspetor estreito: "Usar sugestão" desce para a linha de baixo, com a largura toda, em vez de espremer "Aprovar e próxima". -->
    <Style Selector=":is(UserControl).stacked Button.use-in-row">
      <Setter Property="Grid.Column" Value="0"/>
      <Setter Property="Grid.Row" Value="1"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveAndNextCommand}"/>
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding KeepCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseWordCardCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousCommand}"/>
    <KeyBinding Gesture="Alt+Down" Command="{Binding NextCommand}"/>
  </UserControl.KeyBindings>

  <!-- O conteúdo rola; a barra de ações fica fora da rolagem, no rodapé, para "Aprovar e próxima" estar sempre à vista. A margem de baixo de cada coluna que rola
       tem a altura da barra (LineDetailView.axaml.cs): o último bloco, como o "Usar em todos", para acima dela e do degradê quando se rola até o fim. -->
  <Grid RowDefinitions="*,Auto">
    <Panel>
      <!-- Janela larga: tudo numa coluna rolável, na ordem do artboard, com os 350 px do quadro: a rolagem avança 12 px sobre o respiro do cartão e a barra fica nessa folga, fora do texto. -->
      <ScrollViewer x:Name="WideScroll" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
        <StackPanel x:Name="WideStack" Spacing="10" Margin="0,0,12,20">

          <!-- Cabeçalho (quadro do #537): retrato de 64 px, o nome do falante na cor dele, o papel e o jeito de falar, e embaixo o id em mono com o tipo da linha; histórico e menu à direita.
               O selo de status fica na grade, como no quadro. -->
          <Grid x:Name="HeaderFragment" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <c:Portrait Size="Lg" Image="{Binding SpeakerImage}" Seed="{Binding SpeakerName}" Tint="{Binding SpeakerColor}" IsNarrator="{Binding !HasSpeaker}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
              <TextBlock Classes="title-md" Text="{Binding HeaderName}" TextTrimming="CharacterEllipsis" c:SpeakerColorTint.Color="{Binding SpeakerColor}" AutomationProperties.Name="Quem fala"/>
              <TextBlock FontSize="{DynamicResource Vnf.FontSize.Caption}" LineHeight="18" Classes="secondary header-role" Text="{Binding HeaderRoleLine}" IsVisible="{Binding HasHeaderRoleLine}" TextWrapping="Wrap"/>
              <TextBlock Classes="mono secondary" Text="{Binding HeaderIdLine}" TextWrapping="Wrap" AutomationProperties.Name="Linha"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="subtle icon sm" VerticalAlignment="Center" AutomationProperties.Name="Histórico da linha" ToolTip.Tip="Histórico da linha">
              <PathIcon Width="12" Height="12" Foreground="{DynamicResource Vnf.TextSecondary}" Opacity="0.7" Data="{StaticResource Icon.History}"/>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <TextBlock Classes="body-sm" MaxWidth="280" TextWrapping="Wrap" Text="{Binding HistoryText}"/>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="3" Classes="subtle icon sm" VerticalAlignment="Center" AutomationProperties.Name="Mais ações" ToolTip.Tip="Mais ações">
              <PathIcon Width="12" Height="12" Foreground="{DynamicResource Vnf.TextSecondary}" Opacity="0.7" Data="{StaticResource Icon.More}"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Copiar o original para a tradução" InputGesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
                  <MenuItem Header="Pedir sugestão à IA" InputGesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
                  <MenuItem Header="Não traduzir" InputGesture="Ctrl+Shift+N" Command="{Binding KeepCommand}" IsVisible="{Binding !IsKeep}"
                            ToolTip.Tip="A linha fica como no original e conta como pronta"/>
                  <MenuItem Header="Traduzir" Command="{Binding TranslateCommand}" IsVisible="{Binding IsKeep}"
                            ToolTip.Tip="Desfaz o Não traduzir: a linha volta a ficar sem tradução"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <!-- Original em fundo rebaixado, com os marcadores como chips. -->
          <StackPanel x:Name="OriginalFragment" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <c:OverlineText Classes="overline" FontWeight="Normal" Text="Original" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="sm" Foreground="{DynamicResource Vnf.TextSecondary}" HorizontalAlignment="Right" Command="{Binding ToggleExplainCommand}" IsEnabled="{Binding CanExplain}" IsVisible="{Binding IsCompactInspector}"
                      ToolTip.Tip="Mostra o original quebrado em partes, com o significado de cada uma. Só para você ler, não entra na tradução." AutomationProperties.Name="Entender o japonês">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Entender o japonês" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <SelectableTextBlock Grid.Column="2" FontFamily="{DynamicResource Vnf.FontJp}" FontSize="{DynamicResource Vnf.FontSize.Caption}" LineHeight="{DynamicResource Vnf.LineHeight.Caption}" FontWeight="Normal" Foreground="{DynamicResource Vnf.TextSecondary}" Text="{Binding SpeakerPair}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" c:SpeakerMenu.Original="{Binding Speaker}" c:SpeakerMenu.Translation="{Binding SpeakerTarget}" c:SpeakerMenu.ReviewCommand="{Binding ReviewSpeakerCommand}" AutomationProperties.Name="Falante"/>
            </Grid>
            <!-- Quadro da passada (#580): caixa de 84 px com duas linhas, o japonês em 19 px (.v3-org) (InspectorSource segue o tamanho do texto dos Ajustes). -->
            <Border x:Name="OriginalBox" Classes="original" Padding="10">
              <Panel>
                <!-- Piso de duas linhas do mesmo corpo do original (84 px a 100%): uma fala curta não encolhe a caixa nem o espaço dos cartões abaixo, e o piso acompanha o tamanho do texto dos Ajustes. -->
                <TextBlock x:Name="SourceFloor" Classes="jp-body" FontSize="{DynamicResource Vnf.FontSize.InspectorSource}" LineHeight="{DynamicResource Vnf.LineHeight.InspectorSource}"
                           Text="&#10;" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                <!-- Dicionário offline (#538): o realce da palavra sob o mouse fica atrás do texto, e a entrada abre num Popup embaixo do original, sem mexer no layout do inspetor. -->
                <c:WordHighlight x:Name="SourceHighlight" Target="{Binding #SourceText}" Start="{Binding WordStart}" Length="{Binding WordLength}"/>
                <TextBlock x:Name="SourceText" Classes="jp-body" FontSize="{DynamicResource Vnf.FontSize.InspectorSource}" LineHeight="{DynamicResource Vnf.LineHeight.InspectorSource}" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
                <Popup x:Name="WordPopup" PlacementTarget="{Binding #OriginalBox}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False"
                       PlacementConstraintAdjustment="SlideX, FlipY" VerticalOffset="6" IsOpen="{Binding ShowWordCard, Mode=OneWay}">
                  <!-- O cartão acompanha o conteúdo entre 360 e 372 px (os dois quadros do .pop), e nunca passa do original: por ligação, vale com o mouse e em qualquer outro caminho que abra o cartão. -->
                  <v:WordCardView x:Name="WordCardHost" MinWidth="{Binding #OriginalBox.Bounds.Width, Converter={x:Static v:WordCardWidth.FitMin}}"
                                  MaxWidth="{Binding #OriginalBox.Bounds.Width, Converter={x:Static v:WordCardWidth.FitMax}}"/>
                </Popup>
              </Panel>
            </Border>
          </StackPanel>

          <!-- Entender o japonês: fechado por padrão; só o clique pede a explicação e gasta. -->
          <!-- No inspetor compacto o botão mora na linha do Original; sem explicação aberta o bloco fica fora da pilha, para não somar dois vãos de 10 px entre o original e o cartão seguinte. -->
          <StackPanel x:Name="ExplainFragment" Spacing="6" IsVisible="{Binding ShowExplainBlock}">
            <!-- Quadro do #546: botão sm com contorno em text-secondary e o preço ao lado, fora do botão, em 12/18. -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsCompactInspector}">
              <Button Classes="sm" HorizontalAlignment="Left" Foreground="{DynamicResource Vnf.TextSecondary}" Command="{Binding ToggleExplainCommand}" IsEnabled="{Binding CanExplain}"
                      ToolTip.Tip="Mostra o original quebrado em partes, com o significado de cada uma. Só para você ler, não entra na tradução.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Entender o japonês" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock Classes="caption secondary" LineHeight="18" Text="{Binding ExplainPriceText}" VerticalAlignment="Center"
                         IsVisible="{Binding ExplainPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <TextBlock Classes="caption secondary" Text="Pedindo a explicação..." IsVisible="{Binding IsExplaining}"/>
            <c:ExplainCard x:Name="ExplainCard" ItemsSource="{Binding ExplainParts}" Footnote="Só para você ler, não entra na tradução."
                           IsVisible="{Binding ShowExplainCard}" AutomationProperties.Name="Explicação do original"/>
            <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding ExplainError}"
                       IsVisible="{Binding HasExplainError}"/>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding ExplainNotice}" IsVisible="{Binding HasExplainNotice}"/>
          </StackPanel>

          <!-- A sugestão da passada de editor (#532), no alto do inspetor, logo abaixo do original e acima de "Na cena" e da tradução, como no quadro: nada grava até "Aceitar". -->
          <!-- Quadro: os dois cartões (passada e memória) ficam 9 px abaixo do que vem antes (.insp.tight; a pilha dá 10). Sem sugestão o bloco sai da pilha, senão somaria mais um vão. -->
          <v:EditorSuggestionCardView x:Name="EditorSuggestionFragment" Margin="0,-1,0,0" IsVisible="{Binding HasEditorSuggestion}"/>

          <!-- Memória de tradução (#537): o que já foi aprovado em outros projetos para esta fala ou uma parecida. "Usar" põe o texto no campo; nada grava sozinho. -->
          <Border x:Name="MemoryFragment" Classes="memory" Margin="0,-1,0,0" IsVisible="{Binding ShowMemoryCard}" AutomationProperties.Name="Memória de tradução">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Width="14" Height="14" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Database}"/>
                  <c:OverlineText Classes="overline" FontWeight="Normal" Text="Memória de tradução"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding MemorySummary}" IsVisible="{Binding HasMemory}"/>
              </Grid>
              <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding MemoryProblem}" IsVisible="{Binding HasMemoryProblem}"
                         AutomationProperties.Name="Aviso da memória de tradução"/>
              <ItemsControl ItemsSource="{Binding MemorySuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemorySuggestionViewModel">
                    <Border Classes="memory-item">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <Border Classes="memory-pill" Classes.exact="{Binding IsExact}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PercentText}" AutomationProperties.Name="{Binding PercentText, StringFormat='Correspondência de {0}'}"/>
                          </Border>
                          <TextBlock Grid.Column="1" Classes="body-sm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Target}" ToolTip.Tip="{Binding Target}"/>
                          <Button Grid.Column="2" Classes="sm" Content="Usar" AutomationProperties.Name="{Binding UseName}"
                                  Command="{Binding $parent[UserControl].((vm:LineDetailViewModel)DataContext).UseMemoryCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                        <TextBlock Classes="caption secondary" TextTrimming="CharacterEllipsis" Text="{Binding Origin}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Resumo da cena (#530): o que a bíblia do jogo diz da cena e vai junto de cada pedido de tradução. -->
          <Border x:Name="SceneSummaryCard" Classes="panel" Background="{DynamicResource Vnf.BgInset}" Padding="12" IsVisible="{Binding HasSceneSummary}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <c:OverlineText Classes="overline" Text="Resumo da cena"/>
                <Border Grid.Column="1" Height="20" Padding="8,0" CornerRadius="10" Background="{DynamicResource Vnf.StatusAiBg}">
                  <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.StatusAiFg}" Text="Bíblia"/>
                </Border>
              </Grid>
              <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding SceneSummary}"/>
            </StackPanel>
          </Border>

          <!-- Na cena: a fala anterior e a seguinte. Com o cartão da memória aberto fica recolhido, e o cabeçalho abre. -->
          <StackPanel x:Name="SceneFragment" Spacing="4" IsVisible="{Binding HasScene}">
            <c:OverlineText Classes="overline" Text="Na cena" IsVisible="{Binding !UsesSceneToggle}"/>
            <Button x:Name="SceneToggle" Classes="memory-scene" IsVisible="{Binding UsesSceneToggle}" Command="{Binding ToggleSceneCommand}" AutomationProperties.Name="Na cena">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <PathIcon Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource Icon.ChevronRight}" IsVisible="{Binding IsSceneCollapsed}"/>
                <PathIcon Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource Icon.ChevronDown}" IsVisible="{Binding !IsSceneCollapsed}"/>
                <TextBlock Grid.Column="1" Classes="body-sm secondary" FontWeight="Normal" VerticalAlignment="Center" Text="Na cena"/>
                <TextBlock Grid.Column="2" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding SceneCountText}"/>
              </Grid>
            </Button>
            <c:ContextLines x:Name="SceneLines" ItemsSource="{Binding Scene}" IsVisible="{Binding !IsSceneCollapsed}" AutomationProperties.Name="Na cena"/>
          </StackPanel>

          <!-- Tradução: borda de destaque em volta do campo, medidas e estado dos marcadores. -->
          <StackPanel x:Name="TranslationFragment" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <c:OverlineText Classes="overline" FontWeight="Normal" Text="Tradução"/>
              <TextBlock Grid.Column="1" Classes="meta" Text="{Binding CharsText}" IsVisible="{Binding IsCompactInspector}"/>
            </Grid>
            <Border Classes="field">
              <Panel>
                <ae:TextEditor x:Name="TranslationEditor" Classes="translation" MinHeight="{Binding TranslationMinHeight}" Margin="10,8" AutomationProperties.Name="Tradução"/>
              </Panel>
            </Border>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{x:Static vm:LineDetailViewModel.FieldRawNotice}" IsVisible="{Binding FieldIsRaw}"/>
            <!-- A caixa do jogo logo abaixo do campo, com o que cabe ou o quanto passa. -->
            <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
              <!-- Sem rolagem: a caixa encolhe em proporção quando as colunas do perfil não cabem na largura do inspetor (#392). -->
              <Panel IsVisible="{Binding Preview.HasLayout}">
                <c:GameTextbox x:Name="GameBox" HorizontalAlignment="Stretch" Flat="True" FontFamily="{DynamicResource Vnf.FontMono}" FitToWidth="True" Layout="{Binding Preview.Layout}" AutomationProperties.Name="Caixa do jogo"/>
              </Panel>
              <StackPanel Spacing="4" DataContext="{Binding Preview}" x:DataType="vm:TextboxPreviewViewModel">
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"/>
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding Problem}"
                           IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </StackPanel>
            <!-- Quadro do #546: "Cabe · 2 de 3 linhas" e "49 caracteres" na mesma linha (vão de 14 e 4) e o estado dos marcadores na linha de baixo. No inspetor compacto (quadro do #537) os caracteres vão para o cabeçalho e os marcadores sobem para a linha do "Cabe". -->
            <StackPanel Spacing="4" AutomationProperties.Name="Medidas da tradução">
            <WrapPanel ItemSpacing="14" LineSpacing="4">
              <StackPanel IsVisible="{Binding IsCompactInspector}">
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsShown}">
                  <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding !DoesNotFit}" Data="{StaticResource Icon.Check}" IsVisible="{Binding !DoesNotFit}"/>
                  <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding DoesNotFit}"/>
                  <TextBlock Classes="meta marker-state" Classes.ok="{Binding !DoesNotFit}" Text="{Binding FitText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsNeutral}">
                  <PathIcon Width="14" Height="14" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Info}"/>
                  <TextBlock Classes="meta secondary" Text="{Binding FitText}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding !IsCompactInspector}">
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsShown}">
                  <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding !DoesNotFit}" Data="{StaticResource Icon.Check}" IsVisible="{Binding !DoesNotFit}"/>
                  <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding DoesNotFit}"/>
                  <TextBlock Classes="meta marker-state" Classes.ok="{Binding !DoesNotFit}" Text="{Binding FitText}" AutomationProperties.Name="Se a tradução cabe na caixa do jogo"/>
                </StackPanel>
                <StackPanel x:Name="WrapOffRow" Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsNeutral}">
                  <PathIcon Width="14" Height="14" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Info}"/>
                  <TextBlock Classes="meta secondary" Text="{Binding FitText}" AutomationProperties.Name="A quebra de linha está desligada no perfil"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Classes="meta" Text="{Binding CharsText}" IsVisible="{Binding !IsCompactInspector}"/>
              <ContentControl ContentTemplate="{StaticResource MarkerStateRow}" Content="{Binding}">
                <ContentControl.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsCompactInspector"/>
                    <Binding Path="HasMarkerState"/>
                  </MultiBinding>
                </ContentControl.IsVisible>
              </ContentControl>
            </WrapPanel>
              <ContentControl ContentTemplate="{StaticResource MarkerStateRow}" Content="{Binding}">
                <ContentControl.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsCompactInspector"/>
                    <Binding Path="HasMarkerState"/>
                  </MultiBinding>
                </ContentControl.IsVisible>
              </ContentControl>
            </StackPanel>
          </StackPanel>

          <!-- "Não cabe na caixa do jogo": dividir em páginas ou pedir uma versão mais curta à IA. -->
          <c:FitWarning x:Name="FitFragment" IsVisible="{Binding Fit.IsVisible, FallbackValue=False}" Message="{Binding Fit.Message}" SplitText="{Binding Fit.SplitText}" ShortenText="{Binding Fit.ShortenText}"
                        SplitCommand="{Binding Fit.SplitCommand}" ShortenCommand="{Binding Fit.ShortenCommand}" ShowShorten="{Binding Fit.HasShortener}"
                        ErrorText="{Binding Fit.Error}" AutomationProperties.Name="Aviso: não cabe na caixa do jogo"/>

          <!-- A mesma fala em outras linhas: usa a tradução do campo em todas elas. -->
          <StackPanel x:Name="SameSourceFragment" Spacing="6" IsVisible="{Binding HasSameSource}">
            <!-- Quadro do #546: o aviso e o botão na mesma linha, o aviso em 12/18 text-secondary à esquerda e o botão sm à direita. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsCompactInspector}">
              <TextBlock Classes="caption secondary" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding SameSourceText}"/>
              <Button Grid.Column="1" Classes="sm" Command="{Binding UseForAllCommand}"
                      ToolTip.Tip="Grava a tradução desta linha em todas as outras com o mesmo original">
                <TextBlock Text="Usar em todos"/>
              </Button>
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding IsApplyingToAll}" AutomationProperties.Name="Andamento do Usar em todos">
              <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding ApplyProgress}"/>
              <TextBlock Classes="body-sm secondary" Text="{Binding ApplyProgressText}"/>
              <Button Classes="sm" HorizontalAlignment="Left" Content="Cancelar" Command="{Binding CancelApplyToAllCommand}"
                      ToolTip.Tip="Para entre um script e outro; o que já foi gravado fica gravado"/>
            </StackPanel>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SameSourceResult}"
                       IsVisible="{Binding SameSourceResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <c:ScreenDialog Title="Substituir as outras traduções?" IsOpen="{Binding IsUseForAllConfirmOpen, Mode=TwoWay}">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding UseForAllConfirmText}"/>
              <c:ScreenDialog.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Cancelar" Command="{Binding CancelUseForAllCommand}"/>
                  <Button Classes="accent" Content="Substituir todas" Command="{Binding ConfirmUseForAllCommand}"/>
                </StackPanel>
              </c:ScreenDialog.Footer>
            </c:ScreenDialog>
          </StackPanel>

          <StackPanel x:Name="SuggestFragment" Spacing="16">
            <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding SuggestCommand}" IsVisible="{Binding ShowSuggestButton}"
                    ToolTip.Tip="Pede à IA uma sugestão para esta linha (Ctrl+Espaço)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Sparkle}"/>
                <TextBlock Text="{Binding SuggestButtonText}"/>
              </StackPanel>
            </Button>

            <!-- Cartão da IA: modelo, esforço, há quanto tempo e a diferença em relação à tradução do campo. -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowSuggestionCard}">
              <c:AiSuggestion x:Name="SuggestionCard" Model="{Binding SuggestionModel}" Details="{Binding SuggestionDetails}" Current="{Binding Translation}"
                              Suggestion="{Binding Suggestion}" IsBusy="{Binding IsSuggesting}"
                              CancelCommand="{Binding CancelSuggestionCommand}" AutomationProperties.Name="Sugestão da IA"/>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding SuggestionSource}" IsVisible="{Binding HasSuggestion}"/>
              <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding DiscardSuggestionCommand}" IsVisible="{Binding HasSuggestion}"
                      ToolTip.Tip="Descarta a sugestão e mantém a tradução">
                <TextBlock Text="Descartar sugestão"/>
              </Button>
            </StackPanel>
            <!-- Nas abas: "Usar" e "Pedir outra" ficam junto do cartão. -->
            <StackPanel Classes="tab-only" Orientation="Horizontal" Spacing="8">
              <Button x:Name="UseSuggestionButton" Classes="accent" Click="OnUseSuggestionClick" IsVisible="{Binding HasSuggestion}" Command="{Binding AcceptSuggestionCommand}"
                      ToolTip.Tip="Troca a tradução pela sugestão da IA">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Usar esta sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="sm" IsVisible="{Binding HasSuggestion}" Command="{Binding SuggestCommand}" ToolTip.Tip="Pede outra sugestão à IA para esta linha (Ctrl+Espaço)">
                <TextBlock Text="Pedir outra" TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
            <Border Classes="infobar error" IsVisible="{Binding SuggestionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionError}"/>
              </Grid>
            </Border>
            <c:RewriteBar IsVisible="{Binding OffersSuggestions}"/>

          </StackPanel>
          <StackPanel x:Name="ProblemsFragment" Spacing="16">
            <!-- A dúvida que a IA registrou ao traduzir (b2): o tipo e a frase dela. Aprovar a linha encerra a dúvida e o cartão some. -->
            <Border x:Name="DoubtCard" Classes="infobar" IsVisible="{Binding HasDoubt}" AutomationProperties.Name="Dúvida da IA">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Info}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="body-sm" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DoubtTitle}"/>
                  <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding DoubtNote}"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Os avisos e erros do QA desta linha: os mesmos que dão o ícone na grade, com o nome da regra e a mensagem. -->
            <ItemsControl x:Name="QaIssuesList" ItemsSource="{Binding QaIssues}" IsVisible="{Binding HasQaIssues}" AutomationProperties.Name="Avisos do QA desta linha">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineIssueViewModel">
                  <Border Classes="infobar" Classes.error="{Binding IsError}" Classes.warning="{Binding !IsError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}" IsVisible="{Binding !IsError}"/>
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}" IsVisible="{Binding IsError}"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="body-sm" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}"/>
                        <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Message}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- O aviso de "mesmo original, traduções diferentes" com as outras variantes, as linhas de cada uma e a diferença marcada (#457). -->
            <v:ConsistencyCardView DataContext="{Binding ConsistencyCard}" IsVisible="{Binding $parent[UserControl].((vm:LineDetailViewModel)DataContext).HasConsistencyCard}"/>
            <Border Classes="infobar error" IsVisible="{Binding HasMissingMarkers}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MissingMarkersText}"/>
              </Grid>
            </Border>
            <Border Classes="infobar error" IsVisible="{Binding MarkerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MarkerProblem}"/>
              </Grid>
            </Border>
            <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
              </Grid>
            </Border>

          </StackPanel>
          <!-- Contexto: o personagem com a voz e os termos do glossário que aparecem na linha. -->
          <Border x:Name="ContextFragment" Classes="divider-top" Padding="0,12,0,0">
            <StackPanel Spacing="8">
              <c:OverlineText Classes="overline" Text="Contexto"/>
              <!-- Falante da linha: o do jogo, Narração, um personagem do Glossário ou um nome digitado. Vale só nesta linha. -->
              <Grid x:Name="SpeakerChoiceRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock FontSize="{DynamicResource Vnf.FontSize.BodySm}" LineHeight="{DynamicResource Vnf.LineHeight.BodySm}" TextWrapping="Wrap" Classes="secondary" Text="{Binding SpeakerSummary}" VerticalAlignment="Center"
                           AutomationProperties.Name="Falante da linha"/>
                <Button Grid.Column="1" Classes="subtle sm" AutomationProperties.Name="Trocar o falante da linha"
                        ToolTip.Tip="Troca o falante só nesta linha. O jogo mostra o nome escolhido; uma nova extração mantém a troca.">
                  <TextBlock Text="Trocar falante" VerticalAlignment="Center"/>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <StackPanel Spacing="8" Width="280">
                        <ListBox ItemsSource="{Binding SpeakerChoices}" SelectedItem="{Binding SelectedSpeakerChoice}" MaxHeight="220" AutomationProperties.Name="Falantes">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerChoice">
                              <TextBlock Classes="body-sm" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBox Text="{Binding SpeakerDraft}" PlaceholderText="Outro nome" AutomationProperties.Name="Outro nome para o falante"/>
                          <Button Grid.Column="1" Classes="subtle sm" Content="Usar" Command="{Binding UseSpeakerDraftCommand}" AutomationProperties.Name="Usar o nome digitado"/>
                        </Grid>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasSpeaker}">
                <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Person}"/>
                <SelectableTextBlock Grid.Column="1" FontSize="{DynamicResource Vnf.FontSize.BodySm}" LineHeight="{DynamicResource Vnf.LineHeight.BodySm}" TextWrapping="Wrap" c:SpeakerMenu.Original="{Binding Speaker}" c:SpeakerMenu.Translation="{Binding SpeakerTarget}" c:SpeakerMenu.ReviewCommand="{Binding ReviewSpeakerCommand}" AutomationProperties.Name="Quem fala no contexto">
                  <Run FontWeight="SemiBold" Text="{Binding SpeakerName}"/><Run Foreground="{DynamicResource Vnf.TextSecondary}" Text="{Binding VoiceText}"/>
                </SelectableTextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Book}"/>
                <TextBlock Grid.Column="1" FontSize="{DynamicResource Vnf.FontSize.BodySm}" LineHeight="{DynamicResource Vnf.LineHeight.BodySm}" TextWrapping="Wrap" Classes="secondary" Text="{Binding GlossaryText}"/>
              </Grid>
              <c:OverlineText Classes="overline" Text="Notas" Margin="0,8,0,0"/>
              <TextBox FontSize="{DynamicResource Vnf.FontSize.Body}" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Notas da linha"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Janela pequena (EditorBreakpoints): os mesmos blocos, trocados de lugar pelo LineDetailView para as três abas. -->
      <DockPanel x:Name="TabbedRoot" IsVisible="False">
        <Border x:Name="TabbedHeaderHost" DockPanel.Dock="Top" Padding="0,0,0,8"/>
        <TabControl x:Name="InspectorTabs" Classes="tabs" SelectedIndex="0">
          <TabItem Header="Tradução" AutomationProperties.Name="Aba Tradução">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TranslationTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
          <TabItem Header="Sugestão" AutomationProperties.Name="Aba Sugestão">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SuggestionTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
          <TabItem Header="Contexto" AutomationProperties.Name="Aba Contexto">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContextTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>

      <!-- Degradê curto do fundo do painel para transparente logo acima da barra fixa: o que rola por baixo some em vez de aparecer cortado.
           Só o canal alfa da máscara importa; a cor vem do token. -->
      <Border Height="20" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{DynamicResource Vnf.BgCard}">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00000000"/>
            <GradientStop Offset="1" Color="#FF000000"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
    </Panel>

    <Border x:Name="ActionsBar" Grid.Row="1" Padding="0,12,0,0" Margin="0,8,0,0">
      <!-- Aprovar e próxima ocupa o que sobra da linha; "Usar sugestão" tem a largura do texto. Nada quebra com o inspetor em 400 px. -->
      <Grid x:Name="ActionsFragment" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <Button x:Name="ApproveButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApproveAndNextCommand}"
                ToolTip.Tip="Aprova a linha e vai para a próxima (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Aprovar e próxima" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Ctrl+Enter"/></Border>
          </StackPanel>
        </Button>
        <Button Classes="use-in-row" Classes.editor-suggestion="{Binding HasEditorSuggestion}" Command="{Binding AcceptSuggestionCommand}" ToolTip.Tip="Troca a tradução pela sugestão da IA">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="compact-hide" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Usar sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="UseEditorSuggestionButton" Classes="use-in-row editor-use" Classes.editor-suggestion="{Binding HasEditorSuggestion}" Command="{Binding AcceptEditorSuggestionCommand}"
                ToolTip.Tip="Troca a tradução pelo texto proposto pela passada de editor">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="compact-hide" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Usar sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
