<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.LineDetailView"
             x:DataType="vm:LineDetailViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineDetail.axaml"/>
    <!-- O botão "Usar sugestão" é o da linha de botões do inspetor; o do cartão fica só no controle da galeria. -->
    <Style Selector="c|AiSuggestion /template/ Button#PART_Use">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Inspetor estreito (janela mínima): a tecla e o ícone saem dos botões para o texto não quebrar nem ser cortado. -->
    <Style Selector=":is(UserControl).compact Border.kbd, :is(UserControl).compact PathIcon.compact-hide">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveAndNextCommand}"/>
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousCommand}"/>
    <KeyBinding Gesture="Alt+Down" Command="{Binding NextCommand}"/>
  </UserControl.KeyBindings>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">

      <!-- Cabeçalho: id em mono, selo de status, tipo da linha, histórico e menu. -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Classes="mono secondary" Text="{Binding FullId}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <c:StatusBadge Grid.Column="1" Status="{Binding Status}" VerticalAlignment="Center" AutomationProperties.Name="Status da linha"/>
        <TextBlock Grid.Column="2" FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding KindLabel}" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Classes="subtle icon sm" AutomationProperties.Name="Histórico da linha" ToolTip.Tip="Histórico da linha">
          <PathIcon Width="16" Height="16" Data="{StaticResource Icon.History}"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <TextBlock Classes="body-sm" MaxWidth="280" TextWrapping="Wrap" Text="{Binding HistoryText}"/>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="5" Classes="subtle icon sm" AutomationProperties.Name="Mais ações" ToolTip.Tip="Mais ações">
          <PathIcon Width="16" Height="16" Data="{StaticResource Icon.More}"/>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Copiar o original para a tradução" InputGesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
              <MenuItem Header="Pedir sugestão à IA" InputGesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <!-- Original em fundo rebaixado, com os marcadores como chips. -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="overline" Text="Original" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding SpeakerPair}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" AutomationProperties.Name="Falante"/>
        </Grid>
        <Border Classes="original">
          <TextBlock x:Name="SourceText" Classes="jp-body" LineHeight="NaN" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
        </Border>
      </StackPanel>

      <!-- Na cena: a fala anterior e a seguinte. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasScene}">
        <TextBlock Classes="overline" Text="Na cena"/>
        <c:ContextLines ItemsSource="{Binding Scene}" AutomationProperties.Name="Na cena"/>
      </StackPanel>

      <!-- Tradução: borda inferior de destaque, medidas e estado dos marcadores. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="overline" Text="Tradução"/>
        <Border Classes="field">
          <Panel>
            <ae:TextEditor x:Name="TranslationEditor" Classes="translation" Margin="10,8" AutomationProperties.Name="Tradução"/>
            <Border Classes="fieldline"/>
          </Panel>
        </Border>
        <!-- A caixa do jogo logo abaixo do campo, com o que cabe ou o quanto passa. -->
        <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding Preview.HasLayout}">
            <c:GameTextbox HorizontalAlignment="Left" Layout="{Binding Preview.Layout}" AutomationProperties.Name="Caixa do jogo"/>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding !DoesNotFit}" Data="{StaticResource Icon.Check}" IsVisible="{Binding !DoesNotFit}"/>
            <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding DoesNotFit}"/>
            <TextBlock Classes="meta marker-state" Classes.ok="{Binding !DoesNotFit}" Text="{Binding FitText}" AutomationProperties.Name="Se a tradução cabe na caixa do jogo"/>
          </StackPanel>
          <StackPanel Spacing="4" DataContext="{Binding Preview}" x:DataType="vm:TextboxPreviewViewModel">
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"/>
            <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding Problem}"
                       IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </StackPanel>
        <WrapPanel ItemSpacing="12" LineSpacing="2" AutomationProperties.Name="Medidas da tradução">
          <TextBlock Classes="meta" Text="{Binding CharsText}"/>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding MarkerStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding MarkersMatch}" Data="{StaticResource Icon.Check}" IsVisible="{Binding MarkersMatch}"/>
            <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding !MarkersMatch}"/>
            <TextBlock Classes="meta marker-state" Classes.ok="{Binding MarkersMatch}" Text="{Binding MarkerStateText}"/>
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <!-- Aprovar e próxima ocupa o que sobra da linha; "Usar sugestão" tem a largura do texto. Nada quebra com o inspetor em 400 px. -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApproveAndNextCommand}"
                ToolTip.Tip="Aprova a linha e vai para a próxima (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Aprovar e próxima" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Ctrl+Enter"/></Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Command="{Binding AcceptSuggestionCommand}" ToolTip.Tip="Troca a tradução pela sugestão da IA">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="compact-hide" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Usar sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- A mesma fala em outras linhas: usa a tradução do campo em todas elas. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasSameSource}">
        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SameSourceText}"/>
        <Button Classes="sm" HorizontalAlignment="Left" Command="{Binding UseForAllCommand}"
                ToolTip.Tip="Grava a tradução desta linha em todas as outras com o mesmo original">
          <TextBlock Text="Usar em todos"/>
        </Button>
        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SameSourceResult}"
                   IsVisible="{Binding SameSourceResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>

      <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding SuggestCommand}" IsVisible="{Binding !ShowSuggestionCard}"
              ToolTip.Tip="Pede à IA uma sugestão para esta linha (Ctrl+Espaço)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Sparkle}"/>
          <TextBlock Text="{Binding SuggestButtonText}"/>
        </StackPanel>
      </Button>

      <!-- Cartão da IA: modelo, esforço, há quanto tempo e a diferença em relação à tradução do campo. -->
      <StackPanel Spacing="6" IsVisible="{Binding ShowSuggestionCard}">
        <c:AiSuggestion Model="{Binding SuggestionModel}" Details="{Binding SuggestionDetails}" Current="{Binding Translation}"
                        Suggestion="{Binding Suggestion}" IsBusy="{Binding IsSuggesting}"
                        CancelCommand="{Binding CancelSuggestionCommand}" AutomationProperties.Name="Sugestão da IA"/>
        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding SuggestionSource}" IsVisible="{Binding HasSuggestion}"/>
        <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding DiscardSuggestionCommand}" IsVisible="{Binding HasSuggestion}"
                ToolTip.Tip="Descarta a sugestão e mantém a tradução">
          <TextBlock Text="Descartar sugestão"/>
        </Button>
      </StackPanel>
      <Border Classes="infobar error" IsVisible="{Binding SuggestionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionError}"/>
        </Grid>
      </Border>

      <Border Classes="infobar error" IsVisible="{Binding HasMissingMarkers}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MissingMarkersText}"/>
        </Grid>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding MarkerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MarkerProblem}"/>
        </Grid>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <!-- Contexto: o personagem com a voz e os termos do glossário que aparecem na linha. -->
      <Border Classes="divider-top" Padding="0,12,0,0">
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Contexto"/>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasSpeaker}">
            <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Person}"/>
            <TextBlock Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="{Binding SpeakerName}"/><Run Foreground="{DynamicResource Vnf.TextSecondary}" Text="{Binding VoiceText}"/>
            </TextBlock>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Book}"/>
            <TextBlock Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap" Classes="secondary" Text="{Binding GlossaryText}"/>
          </Grid>
          <TextBlock Classes="overline" Text="Notas" Margin="0,8,0,0"/>
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Notas da linha"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
