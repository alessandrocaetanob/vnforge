<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.LineDetailView"
             x:DataType="vm:LineDetailViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/MarkerChip.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineDetail.axaml"/>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveAndNextCommand}"/>
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousCommand}"/>
    <KeyBinding Gesture="Alt+Down" Command="{Binding NextCommand}"/>
  </UserControl.KeyBindings>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="overline" Text="ORIGINAL"/>
          <TextBlock Classes="mono secondary" Text="{Binding Id}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="body-sm" VerticalAlignment="Center" Text="{Binding StatusText}" AutomationProperties.Name="Status da linha"/>
      </Grid>

      <TextBlock Classes="body-strong" Text="{Binding Speaker}" IsVisible="{Binding Speaker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock x:Name="SourceText" Classes="jp-body" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>

      <TextBlock Classes="overline" Text="TRADUÇÃO"/>
      <Border Classes="field">
        <ae:TextEditor x:Name="TranslationEditor" Classes="translation" AutomationProperties.Name="Tradução"/>
      </Border>

      <Button Command="{Binding SuggestCommand}" HorizontalAlignment="Left" ToolTip.Tip="Pede à IA uma sugestão para esta linha (Ctrl+Espaço)">
        <TextBlock Text="{Binding SuggestButtonText}"/>
      </Button>
      <Border Classes="infobar" IsVisible="{Binding HasSuggestion}">
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="SUGESTÃO DA IA"/>
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SuggestionSource}"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding Suggestion}" AutomationProperties.Name="Sugestão da IA"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Command="{Binding AcceptSuggestionCommand}" ToolTip.Tip="Troca a tradução pela sugestão">
              <TextBlock Text="Usar sugestão"/>
            </Button>
            <Button Command="{Binding DiscardSuggestionCommand}" ToolTip.Tip="Descarta a sugestão e mantém a tradução">
              <TextBlock Text="Descartar"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding SuggestionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionError}"/>
        </Grid>
      </Border>

      <Border Classes="infobar warning" IsVisible="{Binding HasMissingMarkers}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MissingMarkersText}"/>
        </Grid>
      </Border>
      <Border Classes="infobar warning" IsVisible="{Binding MarkerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MarkerProblem}"/>
        </Grid>
      </Border>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="overline" Text="CAIXA DE TEXTO"/>
        <StackPanel Spacing="6" DataContext="{Binding Preview}" x:DataType="vm:TextboxPreviewViewModel">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasLayout}">
            <c:TextboxPreview HorizontalAlignment="Left" Layout="{Binding Layout}" FontFamily="{DynamicResource Vnf.FontMono}"
                              AutomationProperties.Name="Prévia da caixa de texto"/>
          </ScrollViewer>
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Summary}"/>
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"/>
          <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding Problem}"
                     IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="overline" Text="NOTAS"/>
      <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Notas da linha"/>

      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <WrapPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Height" Value="{DynamicResource Vnf.ControlMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>
        </WrapPanel.Styles>
        <Button Classes="icon" Command="{Binding PreviousCommand}" AutomationProperties.Name="Linha anterior" ToolTip.Tip="Linha anterior (Alt+↑)">
          <TextBlock Text="↑"/>
        </Button>
        <Button Classes="icon" Command="{Binding NextCommand}" AutomationProperties.Name="Próxima linha" ToolTip.Tip="Próxima linha (Alt+↓)">
          <TextBlock Text="↓"/>
        </Button>
        <Button Command="{Binding ApproveCommand}" ToolTip.Tip="Aprova a linha e fica nela">
          <TextBlock Text="Aprovar"/>
        </Button>
        <Button Classes="accent" Command="{Binding ApproveAndNextCommand}" ToolTip.Tip="Aprova e vai para a próxima linha (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Check}"/>
            <TextBlock Text="Aprovar e avançar" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
