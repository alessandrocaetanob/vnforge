<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:v="using:VNForge.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.LineDetailView"
             x:DataType="vm:LineDetailViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineDetail.axaml"/>
    <!-- O botão "Usar sugestão" é o da linha de botões do inspetor; o do cartão fica só no controle da galeria. -->
    <Style Selector="c|AiSuggestion /template/ Button#PART_Use">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Nas abas o "Usar esta sugestão" também fica junto do cartão, na aba Sugestão; a barra fixa do rodapé vale nas duas disposições. -->
    <Style Selector="StackPanel.tab-only">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl).tabbed StackPanel.tab-only">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Na aba Sugestão o "Usar esta sugestão" do cartão faz o mesmo: o do rodapé sai para não haver dois botões iguais. -->
    <Style Selector=":is(UserControl).tabbed.suggestion-tab Button.use-in-row">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Inspetor estreito (janela mínima e abas): a tecla e o ícone saem dos botões para o texto não quebrar nem ser cortado. -->
    <Style Selector=":is(UserControl).compact Border.kbd, :is(UserControl).compact PathIcon.compact-hide">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveAndNextCommand}"/>
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding KeepCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousCommand}"/>
    <KeyBinding Gesture="Alt+Down" Command="{Binding NextCommand}"/>
  </UserControl.KeyBindings>

  <!-- O conteúdo rola; a barra de ações fica fora da rolagem, no rodapé, para "Aprovar e próxima" estar sempre à vista. -->
  <Grid RowDefinitions="*,Auto">
    <Panel>
      <!-- Janela larga: tudo numa coluna rolável, na ordem do artboard. A margem direita deixa a barra de rolagem fora do texto. -->
      <ScrollViewer x:Name="WideScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="WideStack" Spacing="16" Margin="0,0,12,20">

          <!-- Cabeçalho: id em mono, selo de status, tipo da linha, histórico e menu. -->
          <Grid x:Name="HeaderFragment" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="mono secondary" Text="{Binding FullId}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <c:StatusBadge Grid.Column="1" Status="{Binding Status}" VerticalAlignment="Center" AutomationProperties.Name="Status da linha"/>
            <TextBlock Grid.Column="2" FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding KindLabel}" VerticalAlignment="Center"/>
            <Button Grid.Column="4" Classes="subtle icon sm" AutomationProperties.Name="Histórico da linha" ToolTip.Tip="Histórico da linha">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.History}"/>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <TextBlock Classes="body-sm" MaxWidth="280" TextWrapping="Wrap" Text="{Binding HistoryText}"/>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="5" Classes="subtle icon sm" AutomationProperties.Name="Mais ações" ToolTip.Tip="Mais ações">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.More}"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Copiar o original para a tradução" InputGesture="Ctrl+Shift+Enter" Command="{Binding CopyOriginalCommand}"/>
                  <MenuItem Header="Pedir sugestão à IA" InputGesture="Ctrl+Space" Command="{Binding SuggestCommand}"/>
                  <MenuItem Header="Não traduzir" InputGesture="Ctrl+Shift+N" Command="{Binding KeepCommand}" IsVisible="{Binding !IsKeep}"
                            ToolTip.Tip="A linha fica como no original e conta como pronta"/>
                  <MenuItem Header="Traduzir" Command="{Binding TranslateCommand}" IsVisible="{Binding IsKeep}"
                            ToolTip.Tip="Desfaz o Não traduzir: a linha volta a ficar sem tradução"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <!-- Original em fundo rebaixado, com os marcadores como chips. -->
          <StackPanel x:Name="OriginalFragment" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="overline" Text="Original" VerticalAlignment="Center"/>
              <SelectableTextBlock Grid.Column="1" FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding SpeakerPair}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" c:SpeakerMenu.Original="{Binding Speaker}" c:SpeakerMenu.Translation="{Binding SpeakerTarget}" AutomationProperties.Name="Falante"/>
            </Grid>
            <Border Classes="original">
              <TextBlock x:Name="SourceText" Classes="jp-body" LineHeight="NaN" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
            </Border>
          </StackPanel>

          <!-- Entender o japonês: fechado por padrão; só o clique pede a explicação e gasta. -->
          <StackPanel x:Name="ExplainFragment" Spacing="6">
            <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding ToggleExplainCommand}" IsEnabled="{Binding CanExplain}"
                    ToolTip.Tip="Mostra o original quebrado em partes, com o significado de cada uma. Só para você ler, não entra na tradução.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Sparkle}"/>
                <TextBlock Text="Entender o japonês" VerticalAlignment="Center"/>
                <TextBlock Classes="caption secondary" Text="{Binding ExplainPriceText, StringFormat='· {0}'}" VerticalAlignment="Center"
                           IsVisible="{Binding ExplainPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Button>
            <TextBlock Classes="caption secondary" Text="Pedindo a explicação..." IsVisible="{Binding IsExplaining}"/>
            <c:ExplainCard x:Name="ExplainCard" ItemsSource="{Binding ExplainParts}" Footnote="Só para você ler, não entra na tradução."
                           IsVisible="{Binding ShowExplainCard}" AutomationProperties.Name="Explicação do original"/>
            <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding ExplainError}"
                       IsVisible="{Binding HasExplainError}"/>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding ExplainNotice}" IsVisible="{Binding HasExplainNotice}"/>
          </StackPanel>

          <!-- Na cena: a fala anterior e a seguinte. -->
          <StackPanel x:Name="SceneFragment" Spacing="6" IsVisible="{Binding HasScene}">
            <TextBlock Classes="overline" Text="Na cena"/>
            <c:ContextLines x:Name="SceneLines" ItemsSource="{Binding Scene}" AutomationProperties.Name="Na cena"/>
          </StackPanel>

          <!-- Tradução: borda inferior de destaque, medidas e estado dos marcadores. -->
          <StackPanel x:Name="TranslationFragment" Spacing="6">
            <TextBlock Classes="overline" Text="Tradução"/>
            <Border Classes="field">
              <Panel>
                <ae:TextEditor x:Name="TranslationEditor" Classes="translation" Margin="10,8" AutomationProperties.Name="Tradução"/>
                <Border Classes="fieldline"/>
              </Panel>
            </Border>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{x:Static vm:LineDetailViewModel.FieldRawNotice}" IsVisible="{Binding FieldIsRaw}"/>
            <!-- A caixa do jogo logo abaixo do campo, com o que cabe ou o quanto passa. -->
            <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
              <!-- Sem rolagem: a caixa encolhe em proporção quando as colunas do perfil não cabem na largura do inspetor (#392). -->
              <Panel IsVisible="{Binding Preview.HasLayout}">
                <c:GameTextbox x:Name="GameBox" HorizontalAlignment="Left" FitToWidth="True" Layout="{Binding Preview.Layout}" AutomationProperties.Name="Caixa do jogo"/>
              </Panel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsShown}">
                <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding !DoesNotFit}" Data="{StaticResource Icon.Check}" IsVisible="{Binding !DoesNotFit}"/>
                <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding DoesNotFit}"/>
                <TextBlock Classes="meta marker-state" Classes.ok="{Binding !DoesNotFit}" Text="{Binding FitText}" AutomationProperties.Name="Se a tradução cabe na caixa do jogo"/>
              </StackPanel>
              <StackPanel x:Name="WrapOffRow" Orientation="Horizontal" Spacing="4" IsVisible="{Binding FitIsNeutral}">
                <PathIcon Width="14" Height="14" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Info}"/>
                <TextBlock Classes="meta secondary" Text="{Binding FitText}" AutomationProperties.Name="A quebra de linha está desligada no perfil"/>
              </StackPanel>
              <StackPanel Spacing="4" DataContext="{Binding Preview}" x:DataType="vm:TextboxPreviewViewModel">
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"/>
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding Problem}"
                           IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </StackPanel>
            <WrapPanel ItemSpacing="12" LineSpacing="2" AutomationProperties.Name="Medidas da tradução">
              <TextBlock Classes="meta" Text="{Binding CharsText}"/>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding MarkerStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <PathIcon Width="14" Height="14" Classes="marker-state" Classes.ok="{Binding MarkersMatch}" Data="{StaticResource Icon.Check}" IsVisible="{Binding MarkersMatch}"/>
                <PathIcon Width="14" Height="14" Classes="marker-state" Data="{StaticResource Icon.Error}" IsVisible="{Binding !MarkersMatch}"/>
                <TextBlock Classes="meta marker-state" Classes.ok="{Binding MarkersMatch}" Text="{Binding MarkerStateText}"/>
              </StackPanel>
            </WrapPanel>
          </StackPanel>

          <!-- "Não cabe na caixa do jogo": dividir em páginas ou pedir uma versão mais curta à IA. -->
          <c:FitWarning x:Name="FitFragment" IsVisible="{Binding Fit.IsVisible, FallbackValue=False}" Message="{Binding Fit.Message}" SplitText="{Binding Fit.SplitText}" ShortenText="{Binding Fit.ShortenText}"
                        SplitCommand="{Binding Fit.SplitCommand}" ShortenCommand="{Binding Fit.ShortenCommand}" ShowShorten="{Binding Fit.HasShortener}"
                        ErrorText="{Binding Fit.Error}" AutomationProperties.Name="Aviso: não cabe na caixa do jogo"/>

          <!-- A mesma fala em outras linhas: usa a tradução do campo em todas elas. -->
          <StackPanel x:Name="SameSourceFragment" Spacing="6" IsVisible="{Binding HasSameSource}">
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SameSourceText}"/>
            <Button Classes="sm" HorizontalAlignment="Left" Command="{Binding UseForAllCommand}"
                    ToolTip.Tip="Grava a tradução desta linha em todas as outras com o mesmo original">
              <TextBlock Text="Usar em todos"/>
            </Button>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding SameSourceResult}"
                       IsVisible="{Binding SameSourceResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <c:ScreenDialog Title="Substituir as outras traduções?" IsOpen="{Binding IsUseForAllConfirmOpen, Mode=TwoWay}">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding UseForAllConfirmText}"/>
              <c:ScreenDialog.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Cancelar" Command="{Binding CancelUseForAllCommand}"/>
                  <Button Classes="accent" Content="Substituir todas" Command="{Binding ConfirmUseForAllCommand}"/>
                </StackPanel>
              </c:ScreenDialog.Footer>
            </c:ScreenDialog>
          </StackPanel>

          <StackPanel x:Name="SuggestFragment" Spacing="16">
            <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding SuggestCommand}" IsVisible="{Binding !ShowSuggestionCard}"
                    ToolTip.Tip="Pede à IA uma sugestão para esta linha (Ctrl+Espaço)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Sparkle}"/>
                <TextBlock Text="{Binding SuggestButtonText}"/>
              </StackPanel>
            </Button>

            <!-- Cartão da IA: modelo, esforço, há quanto tempo e a diferença em relação à tradução do campo. -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowSuggestionCard}">
              <c:AiSuggestion x:Name="SuggestionCard" Model="{Binding SuggestionModel}" Details="{Binding SuggestionDetails}" Current="{Binding Translation}"
                              Suggestion="{Binding Suggestion}" IsBusy="{Binding IsSuggesting}"
                              CancelCommand="{Binding CancelSuggestionCommand}" AutomationProperties.Name="Sugestão da IA"/>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding SuggestionSource}" IsVisible="{Binding HasSuggestion}"/>
              <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding DiscardSuggestionCommand}" IsVisible="{Binding HasSuggestion}"
                      ToolTip.Tip="Descarta a sugestão e mantém a tradução">
                <TextBlock Text="Descartar sugestão"/>
              </Button>
            </StackPanel>
            <!-- Nas abas: "Usar" e "Pedir outra" ficam junto do cartão. -->
            <StackPanel Classes="tab-only" Orientation="Horizontal" Spacing="8">
              <Button x:Name="UseSuggestionButton" Classes="accent" Click="OnUseSuggestionClick" IsVisible="{Binding HasSuggestion}" Command="{Binding AcceptSuggestionCommand}"
                      ToolTip.Tip="Troca a tradução pela sugestão da IA">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Usar esta sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="sm" IsVisible="{Binding HasSuggestion}" Command="{Binding SuggestCommand}" ToolTip.Tip="Pede outra sugestão à IA para esta linha (Ctrl+Espaço)">
                <TextBlock Text="Pedir outra" TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
            <Border Classes="infobar error" IsVisible="{Binding SuggestionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionError}"/>
              </Grid>
            </Border>

          </StackPanel>
          <StackPanel x:Name="ProblemsFragment" Spacing="16">
            <!-- Os avisos e erros do QA desta linha: os mesmos que dão o ícone na grade, com o nome da regra e a mensagem. -->
            <ItemsControl x:Name="QaIssuesList" ItemsSource="{Binding QaIssues}" IsVisible="{Binding HasQaIssues}" AutomationProperties.Name="Avisos do QA desta linha">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineIssueViewModel">
                  <Border Classes="infobar" Classes.error="{Binding IsError}" Classes.warning="{Binding !IsError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}" IsVisible="{Binding !IsError}"/>
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}" IsVisible="{Binding IsError}"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="body-sm" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}"/>
                        <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Message}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- O aviso de "mesmo original, traduções diferentes" com as outras variantes, as linhas de cada uma e a diferença marcada (#457). -->
            <v:ConsistencyCardView DataContext="{Binding ConsistencyCard}" IsVisible="{Binding $parent[UserControl].((vm:LineDetailViewModel)DataContext).HasConsistencyCard}"/>
            <Border Classes="infobar error" IsVisible="{Binding HasMissingMarkers}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MissingMarkersText}"/>
              </Grid>
            </Border>
            <Border Classes="infobar error" IsVisible="{Binding MarkerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding MarkerProblem}"/>
              </Grid>
            </Border>
            <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
              </Grid>
            </Border>

          </StackPanel>
          <!-- Contexto: o personagem com a voz e os termos do glossário que aparecem na linha. -->
          <Border x:Name="ContextFragment" Classes="divider-top" Padding="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="overline" Text="Contexto"/>
              <!-- Falante da linha: o do jogo, Narração, um personagem do Glossário ou um nome digitado. Vale só nesta linha. -->
              <Grid x:Name="SpeakerChoiceRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock FontSize="13" LineHeight="18" TextWrapping="Wrap" Classes="secondary" Text="{Binding SpeakerSummary}" VerticalAlignment="Center"
                           AutomationProperties.Name="Falante da linha"/>
                <Button Grid.Column="1" Classes="subtle sm" AutomationProperties.Name="Trocar o falante da linha"
                        ToolTip.Tip="Troca o falante só nesta linha. O jogo mostra o nome escolhido; uma nova extração mantém a troca.">
                  <TextBlock Text="Trocar falante" VerticalAlignment="Center"/>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <StackPanel Spacing="8" Width="280">
                        <ListBox ItemsSource="{Binding SpeakerChoices}" SelectedItem="{Binding SelectedSpeakerChoice}" MaxHeight="220" AutomationProperties.Name="Falantes">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerChoice">
                              <TextBlock Classes="body-sm" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBox Text="{Binding SpeakerDraft}" PlaceholderText="Outro nome" AutomationProperties.Name="Outro nome para o falante"/>
                          <Button Grid.Column="1" Classes="subtle sm" Content="Usar" Command="{Binding UseSpeakerDraftCommand}" AutomationProperties.Name="Usar o nome digitado"/>
                        </Grid>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasSpeaker}">
                <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Person}"/>
                <SelectableTextBlock Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap" c:SpeakerMenu.Original="{Binding Speaker}" c:SpeakerMenu.Translation="{Binding SpeakerTarget}" AutomationProperties.Name="Quem fala no contexto">
                  <Run FontWeight="SemiBold" Text="{Binding SpeakerName}"/><Run Foreground="{DynamicResource Vnf.TextSecondary}" Text="{Binding VoiceText}"/>
                </SelectableTextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Book}"/>
                <TextBlock Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap" Classes="secondary" Text="{Binding GlossaryText}"/>
              </Grid>
              <TextBlock Classes="overline" Text="Notas" Margin="0,8,0,0"/>
              <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Notas da linha"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Janela pequena (EditorBreakpoints): os mesmos blocos, trocados de lugar pelo LineDetailView para as três abas. -->
      <DockPanel x:Name="TabbedRoot" IsVisible="False">
        <Border x:Name="TabbedHeaderHost" DockPanel.Dock="Top" Padding="0,0,0,8"/>
        <TabControl x:Name="InspectorTabs" Classes="tabs" SelectedIndex="0">
          <TabItem Header="Tradução" AutomationProperties.Name="Aba Tradução">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TranslationTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
          <TabItem Header="Sugestão" AutomationProperties.Name="Aba Sugestão">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SuggestionTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
          <TabItem Header="Contexto" AutomationProperties.Name="Aba Contexto">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContextTab" Spacing="16" Margin="0,12,12,20"/></ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>

      <!-- Degradê curto do fundo do painel para transparente logo acima da barra fixa: o que rola por baixo some em vez de aparecer cortado.
           Só o canal alfa da máscara importa; a cor vem do token. -->
      <Border Height="20" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{DynamicResource Vnf.BgCard}">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00000000"/>
            <GradientStop Offset="1" Color="#FF000000"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
    </Panel>

    <Border Grid.Row="1" Classes="divider-top" Padding="0,12,0,0" Margin="0,8,0,0">
      <!-- Aprovar e próxima ocupa o que sobra da linha; "Usar sugestão" tem a largura do texto. Nada quebra com o inspetor em 400 px. -->
      <Grid x:Name="ActionsFragment" ColumnDefinitions="*,Auto">
        <Button x:Name="ApproveButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApproveAndNextCommand}"
                ToolTip.Tip="Aprova a linha e vai para a próxima (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Aprovar e próxima" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Ctrl+Enter"/></Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="use-in-row" Margin="8,0,0,0" Command="{Binding AcceptSuggestionCommand}" ToolTip.Tip="Troca a tradução pela sugestão da IA">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="compact-hide" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Usar sugestão" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
