<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:v="using:VNForge.App.Views"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.ConferenceView"
             x:DataType="vm:ConferenceViewModel">

  <UserControl.Styles>
    <!-- O original do painel (v3-org do quadro): fundo rebaixado, raio 12, 17/26. A tradução de hoje é o campo do quadro (v3-field): cartão, contorno de controle, raio 12, 14/20. -->
    <Style Selector="Border.original">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style Selector="Border.original.field">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- Cartão do quadro (x-card): raio 16 sobre o painel comum. -->
    <Style Selector="Border.panel.card">
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    </Style>
    <!-- Selo de gravidade do painel (v3-pill): 20px, 11/600, sem ícone. -->
    <Style Selector="Border.sev">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Vnf.SignalWarningBg}"/>
    </Style>
    <Style Selector="Border.sev > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
    </Style>
    <Style Selector="Border.sev.ai">
      <Setter Property="Background" Value="{DynamicResource Vnf.StatusAiBg}"/>
    </Style>
    <Style Selector="Border.sev.ai > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusAiFg}"/>
    </Style>
    <Style Selector="Border.sev.error">
      <Setter Property="Background" Value="{DynamicResource Vnf.SignalErrorBg}"/>
    </Style>
    <Style Selector="Border.sev.error > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalErrorFg}"/>
    </Style>
    <!-- A barra da linha selecionada vai de ponta a ponta (x-is.on). -->
    <Style Selector="ListBox.rows > ListBoxItem /template/ Border#SelectionBar">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- O selo tem 20px: a linha do detalhe que leva selo cresce para 22 em vez de cortar o texto. -->
    <Style Selector="TextBlock.body-sm.chips">
      <Setter Property="LineHeight" Value="22"/>
    </Style>
    <!-- Lista dos cartões de "mesmo original": o cartão não é um item selecionável, então o item não muda de cor. -->
    <Style Selector="ListBox.cards">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.cards > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.original.proposal">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" RowDefinitions="Auto,Auto,*" Margin="32,20,32,16" Focusable="True">

    <!-- Faixa do topo (v3-banner do quadro): ponto, título, frase e as ações da conferência. Erros travam o teste no jogo (contorno e ponto vermelhos), só avisos não travam nada (ponto âmbar), conferência limpa leva ao teste (ponto verde). Depois dela, a falha da última ação e o resultado dela. -->
    <StackPanel Grid.Row="0" Spacing="8">
      <Button Classes="subtle" HorizontalAlignment="Right" IsVisible="{Binding !HasBanner}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Conferir de novo">
        <TextBlock Text="Conferir de novo"/>
      </Button>
      <c:GameStateBanner State="{Binding BannerState}" Title="{Binding BannerTitle}" Message="{Binding BannerMessage}" IsVisible="{Binding HasBanner}"
                         AutomationProperties.Name="{Binding BannerTitle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="accent" FontSize="13" IsVisible="{Binding HasFixable}" Command="{Binding FixAllCommand}"
                  AutomationProperties.Name="Corrigir de uma vez os problemas que têm correção de um clique">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
              <TextBlock Text="{Binding FixAllLabel}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="accent" FontSize="13" IsVisible="{Binding ShowTestButton}" Command="{Binding TestCommand}" AutomationProperties.Name="Testar no jogo">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
              <TextBlock Text="Testar no jogo" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="subtle" FontSize="13" Command="{Binding RefreshCommand}" AutomationProperties.Name="Conferir de novo">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.ArrowSync}"/>
              <TextBlock Text="Conferir de novo" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </c:GameStateBanner>
      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap"
                     c:LineLinks.Source="{Binding ErrorMessage}" c:LineLinks.Command="{Binding OpenLineByIdCommand}"/>
        </Grid>
      </Border>
      <Border Classes="infobar success" IsVisible="{Binding NoticeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Check}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding NoticeMessage}"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Filtros em linguagem comum; os números são do projeto inteiro. -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="0,14" AutomationProperties.Name="Filtros">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="8" LineSpacing="8"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ConferenceFilterViewModel">
          <c:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsChecked="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectFilterCommand}"
                        CommandParameter="{Binding}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Grid.Row="2" ColumnDefinitions="*,384" ColumnSpacing="20">

      <!-- Problemas: o que é, a cena e a linha; "não traduzida" resumida por cena. -->
      <Border Classes="panel card" ClipToBounds="True" AutomationProperties.Name="Problemas">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <!-- Um card por ajuste de formatação que a estratégia de acentuação não grava, no lugar das linhas que ele causa; o botão troca o ajuste. -->
          <ItemsControl ItemsSource="{Binding SettingCards}" IsVisible="{Binding HasSettingCards}" Margin="16,16,16,4"
                        AutomationProperties.Name="Ajustes que o jogo não grava">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConferenceSettingCardViewModel">
                <Border Classes="infobar error" Padding="14,12" AutomationProperties.Name="{Binding Title}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                    <StackPanel Grid.Column="1" Spacing="6" MinWidth="0">
                      <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                      <TextBlock Classes="body-sm" Text="{Binding Text}" TextWrapping="Wrap"/>
                      <Button Classes="sm accent" HorizontalAlignment="Left" Margin="0,4,0,0"
                              Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).ApplySettingCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding ButtonLabel}">
                        <TextBlock Text="{Binding ButtonLabel}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Um cartão por original com mais de uma tradução, no lugar de um aviso por linha: as variantes, as linhas de cada uma (links para o Editor) e o que difere da mais usada. -->
          <!-- Virtualizada: um projeto pode ter milhares de originais repetidos. Sem seleção visível; os botões do cartão são o que se clica. -->
          <ListBox Grid.Row="1" Classes="cards" MaxHeight="300" ItemsSource="{Binding ConsistencyCards}" IsVisible="{Binding HasConsistencyCards}"
                   SelectionMode="Toggle" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Originais com traduções diferentes">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConferenceConsistencyCardViewModel">
                  <v:ConferenceGroupView/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          <Panel Grid.Row="2">
            <ListBox Classes="projects rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                     AutomationProperties.Name="Problemas encontrados">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConferenceIssueRowViewModel">
                  <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="14" Margin="16,10" MinHeight="42"
                        Background="Transparent" DoubleTapped="OnIssueDoubleTapped">
                    <Panel Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                      <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Error}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                                IsVisible="{Binding IsError}" AutomationProperties.Name="Trava o teste"/>
                      <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource Vnf.SignalWarningFg}"
                                IsVisible="{Binding !IsError}" AutomationProperties.Name="Aviso"/>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                      <TextBlock FontSize="14" LineHeight="20" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Classes="caption secondary" Text="{Binding Where}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <TextBlock Classes="caption secondary" Text="{Binding OriginNote}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding IsMachineDraft}"/>
                      <TextBlock Classes="body-sm" Classes.chips="{Binding HasDetailMarkers}" c:MarkedText.Source="{Binding DetailMarked}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                 ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="caption secondary" Text="{Binding Where}" VerticalAlignment="Top" Margin="0,2,0,0"
                               IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    <Border Grid.Column="2" Classes="sev ai" VerticalAlignment="Top" IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Tag}" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="body-sm secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding ShowEmptyText}" Text="{Binding EmptyMessage}"/>
            <!-- Conferência limpa: a frase acima cede lugar ao estado vazio com o selo 訳. -->
            <c:EmptyState IsVisible="{Binding IsClear}"
                          Message="Nenhum problema aberto. A conferência de agora não achou nada; ela roda de novo quando você aprova linhas."/>
          </Panel>
          <Border Grid.Row="3" Classes="divider-top" Padding="16,10">
            <TextBlock Classes="caption secondary" Text="{Binding ListFooter}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- Painel do problema: o que é, o original, a tradução de hoje, como vai ficar e as ações. -->
      <Border Grid.Column="1" Classes="panel card" Padding="16,14" AutomationProperties.Name="Problema selecionado">
        <Panel>
          <TextBlock Classes="body-sm secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding !HasSelection}" Text="Selecione um problema para ver o que fazer."/>
          <Panel IsVisible="{Binding HasSelection}">
            <Grid RowDefinitions="*,Auto" DataContext="{Binding SelectedRow}" x:DataType="vm:ConferenceIssueRowViewModel">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Classes="sev" Classes.error="{Binding IsError}"><TextBlock Text="{Binding SeverityLabel}" VerticalAlignment="Center"/></Border>
                    <TextBlock Classes="caption secondary" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Classes="title-md" Text="{Binding DetailTitle}" TextWrapping="Wrap"/>
                  <StackPanel Spacing="6">
                    <c:OverlineText Classes="overline" Text="O que é isso"/>
                    <TextBlock Classes="body-sm secondary" Text="{Binding Explanation}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <!-- O nome como está no texto extraído, para copiar para o Glossário sem digitar de cabeça (um C largo e um C latino não casam). -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasSpeaker}">
                    <c:OverlineText Classes="overline" Text="Quem fala"/>
                    <Border Classes="original">
                      <SelectableTextBlock Classes="jp-body" Text="{Binding Speaker}" TextWrapping="Wrap" c:SpeakerMenu.Original="{Binding Speaker}" AutomationProperties.Name="Quem fala"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasCharacterList}">
                    <c:OverlineText Classes="overline" Text="Nesta fala"/>
                    <TextBlock Classes="body-sm" Text="{Binding CharacterSentence}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasOriginal}">
                    <c:OverlineText Classes="overline" Text="Original"/>
                    <Border Classes="original">
                      <TextBlock Classes="jp-body" c:MarkedText.Source="{Binding Original}" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasTranslation}">
                    <c:OverlineText Classes="overline" Text="{Binding TranslationLabel}"/>
                    <Border Classes="original field">
                      <TextBlock FontSize="14" LineHeight="20" c:MarkedText.Source="{Binding Translation}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TranslationLabel}"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasProposal}">
                    <c:OverlineText Classes="overline" Text="Como vai ficar"/>
                    <Border Classes="original field proposal">
                      <TextBlock FontSize="14" LineHeight="20" c:MarkedText.Source="{Binding ProposedText}" TextWrapping="Wrap" AutomationProperties.Name="Como vai ficar"/>
                    </Border>
                  </StackPanel>
                  <!-- Não cabe na caixa: a caixa do jogo com a tradução de hoje e as duas saídas do Editor, dividir em páginas ou encurtar com a IA. -->
                  <StackPanel Spacing="10" IsVisible="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).HasSelectedFit}">
                    <c:OverlineText Classes="overline" Text="Como fica na caixa do jogo"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <c:GameTextbox HorizontalAlignment="Left" Size="Small"
                                     Layout="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectedLayout}"
                                     AutomationProperties.Name="Caixa do jogo"/>
                    </ScrollViewer>
                    <c:FitWarning DataContext="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectedFit}" x:DataType="vm:FitWarningViewModel"
                                  Message="{Binding Message}" SplitText="{Binding SplitText}" ShortenText="{Binding ShortenText}"
                                  SplitCommand="{Binding SplitCommand}" ShortenCommand="{Binding ShortenCommand}" ShowShorten="{Binding HasShortener}"
                                  ErrorText="{Binding Error}" AutomationProperties.Name="Aviso: não cabe na caixa do jogo"/>
                  </StackPanel>
                  <c:TechnicalDetails Key="conference" AutomationProperties.Name="Detalhes técnicos">
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                      <TextBlock Classes="mono secondary" FontSize="12" LineHeight="16" Text="{Binding LineLabel, StringFormat='Linha {0}'}"/>
                      <TextBlock Classes="mono secondary" FontSize="12" LineHeight="16" Text="{Binding RuleId, StringFormat='Regra {0}'}"/>
                    </StackPanel>
                  </c:TechnicalDetails>
                </StackPanel>
              </ScrollViewer>
              <!-- Barra fixa no pé do painel: a ação principal em destaque (Enter), as outras duas ao lado uma da outra. Sem correção automática, "Abrir no editor" é a principal. -->
              <Border Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          IsVisible="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).ShowFixAndNext}"
                          Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).FixAndNextCommand}"
                          AutomationProperties.Name="Corrigir e ir para o próximo problema">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Corrigir e ir para o próximo" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Enter"/></Border>
                    </StackPanel>
                  </Button>
                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanRegisterCharacter}"
                          Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).RegisterCharacterCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Cadastrar personagem">
                    <TextBlock Text="Cadastrar personagem" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes.accent="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).OpenIsPrimary}"
                            Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).OpenLineCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Abrir a linha no Editor">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Edit}"/>
                        <TextBlock Text="Abrir no editor" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="subtle" IsVisible="{Binding CanMarkOk}"
                            Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).MarkOkCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Está certo assim: deixar de avisar desta linha">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
                        <TextBlock Text="Está certo assim"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Panel>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
