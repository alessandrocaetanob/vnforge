<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.ConferenceView"
             x:DataType="vm:ConferenceViewModel">

  <UserControl.Styles>
    <!-- A caixa de original e tradução do painel: fundo rebaixado, raio 4. -->
    <Style Selector="Border.original">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <!-- O selo tem 20px: a linha do detalhe que leva selo cresce para 22 em vez de cortar o texto. -->
    <Style Selector="TextBlock.body-sm.chips">
      <Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style Selector="Border.original.proposal">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,*" Focusable="True">

    <!-- Cabeçalho: última conferência e título à esquerda; à direita, na base do título, um só botão de destaque: "Corrigir N com um clique" quando há correção, senão "Conferir de novo". -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="24,16,24,12">
      <StackPanel Spacing="2" VerticalAlignment="Bottom" MinWidth="0">
        <TextBlock Classes="caption secondary" Text="{Binding CheckedSummary}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Classes="title-lg" Text="Conferir a tradução"/>
        <TextBlock Classes="body-sm secondary" Text="O que impede de testar no jogo."/>
      </StackPanel>
      <Button Grid.Column="1" Classes="sm" Classes.accent="{Binding HasFixable}" IsVisible="{Binding HasFixable}" VerticalAlignment="Bottom" Command="{Binding FixAllCommand}"
              AutomationProperties.Name="Corrigir de uma vez os problemas que têm correção de um clique">
        <TextBlock Text="{Binding FixAllLabel}"/>
      </Button>
      <Button Grid.Column="2" Classes="sm" Classes.accent="{Binding RefreshIsPrimary}" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" AutomationProperties.Name="Conferir de novo">
        <TextBlock Text="Conferir de novo"/>
      </Button>
    </Grid>

    <!-- Faixa do topo: os erros travam o teste no jogo, os avisos não travam nada; depois a falha da última ação e o resultado dela. -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="24,0,24,12">
      <!-- Neutra: fundo de cartão, ícone de erro e só o número em vermelho; a barra à esquerda guarda o sinal sem gritar. -->
      <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding HasBlockingErrors}" AutomationProperties.Name="{Binding BlockingMessage}">
        <Grid ColumnDefinitions="3,*">
          <Border Background="{DynamicResource Vnf.SignalErrorFg}"/>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="12,10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}" Foreground="{DynamicResource Vnf.SignalErrorFg}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
              <Run FontWeight="Bold" Foreground="{DynamicResource Vnf.SignalErrorFg}" Text="{Binding BlockingCount}"/>
              <Run FontWeight="SemiBold" Text="{Binding BlockingRest}"/>
              <Run Text="Corrija esses antes de testar no jogo. Os avisos não travam nada."/>
            </TextBlock>
          </Grid>
        </Grid>
      </Border>
      <Border Classes="infobar warning" IsVisible="{Binding HasOnlyWarnings}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="Nada trava o teste no jogo."/>
            <Run Text="Os avisos não travam nada; corrija quando puder."/>
          </TextBlock>
        </Grid>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap"
                     c:LineLinks.Source="{Binding ErrorMessage}" c:LineLinks.Command="{Binding OpenLineByIdCommand}"/>
        </Grid>
      </Border>
      <Border Classes="infobar success" IsVisible="{Binding NoticeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Check}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding NoticeMessage}"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Filtros em linguagem comum; os números são do projeto inteiro. -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}" Margin="24,0,24,12" AutomationProperties.Name="Filtros">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="6"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ConferenceFilterViewModel">
          <c:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsChecked="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectFilterCommand}"
                        CommandParameter="{Binding}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Grid.Row="3" ColumnDefinitions="*,420" ColumnSpacing="12" Margin="24,0,24,16">

      <!-- Problemas: o que é, a cena e a linha; "não traduzida" resumida por cena. -->
      <Border Classes="panel" ClipToBounds="True" AutomationProperties.Name="Problemas">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <!-- Um card por ajuste de formatação que a estratégia de acentuação não grava, no lugar das linhas que ele causa; o botão troca o ajuste. -->
          <ItemsControl ItemsSource="{Binding SettingCards}" IsVisible="{Binding HasSettingCards}" Margin="12,12,12,4"
                        AutomationProperties.Name="Ajustes que o jogo não grava">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConferenceSettingCardViewModel">
                <Border Classes="infobar error" Padding="14,12" AutomationProperties.Name="{Binding Title}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
                    <StackPanel Grid.Column="1" Spacing="6" MinWidth="0">
                      <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                      <TextBlock Classes="body-sm" Text="{Binding Text}" TextWrapping="Wrap"/>
                      <Button Classes="sm accent" HorizontalAlignment="Left" Margin="0,4,0,0"
                              Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).ApplySettingCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding ButtonLabel}">
                        <TextBlock Text="{Binding ButtonLabel}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Um cartão por original com mais de uma tradução, no lugar de um aviso por linha: as variantes, as linhas de cada uma (links para o Editor) e o que difere da mais usada. -->
          <ScrollViewer Grid.Row="1" MaxHeight="300" Margin="0,0,0,4" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasConsistencyCards}">
            <ItemsControl ItemsSource="{Binding ConsistencyCards}" Margin="12,8,12,4" AutomationProperties.Name="Originais com traduções diferentes">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConferenceConsistencyCardViewModel">
                  <Border Classes="original" Padding="14,12" AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource Vnf.SignalWarningFg}"/>
                          <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding LinesText}" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Classes="jp-body" Text="{Binding Source}" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
                      <ItemsControl ItemsSource="{Binding Variants}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConferenceVariantViewModel">
                            <Border Classes="divider-top" Padding="0,10,0,10">
                              <Grid ColumnDefinitions="88,*" ColumnSpacing="10" AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding Marker}" Foreground="{DynamicResource Vnf.AccentText}"/>
                                  <TextBlock Classes="caption secondary" Text="{Binding CountText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" MinWidth="0">
                                  <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" c:DiffText.Segments="{Binding Segments}"/>
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <ItemsControl ItemsSource="{Binding VisibleLines}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <WrapPanel ItemSpacing="4" LineSpacing="0"/>
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConferenceLineLink">
                                          <Button Classes="link sm" Content="{Binding Label}"
                                                  Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).OpenLineByIdCommand}"
                                                  CommandParameter="{Binding Request}" AutomationProperties.Name="{Binding Label, StringFormat='Abrir {0} no Editor'}"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Column="1" Classes="link sm" VerticalAlignment="Top" IsVisible="{Binding HasMore}" Command="{Binding ToggleLinesCommand}"
                                            Content="{Binding MoreLabel}" AutomationProperties.Name="Mostrar ou esconder as outras linhas desta tradução"/>
                                    <Button Grid.Column="2" Classes="sm" VerticalAlignment="Top" Content="{Binding UseLabel}"
                                            Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).UseVariantCommand}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding UseAutomationName}"/>
                                  </Grid>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="subtle sm" HorizontalAlignment="Right" Content="{Binding KeepLabel}"
                              Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).KeepDifferentCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="Manter as traduções diferentes de propósito e deixar de avisar deste original"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Panel Grid.Row="2">
            <ListBox Classes="projects" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                     AutomationProperties.Name="Problemas encontrados">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConferenceIssueRowViewModel">
                  <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" Margin="16,6" MinHeight="48"
                        Background="Transparent" DoubleTapped="OnIssueDoubleTapped">
                    <Panel Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Error}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                                IsVisible="{Binding IsError}" AutomationProperties.Name="Trava o teste"/>
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource Vnf.SignalWarningFg}"
                                IsVisible="{Binding !IsError}" AutomationProperties.Name="Aviso"/>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                      <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Classes="caption secondary" Text="{Binding Where}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Classes="caption secondary" Text="{Binding OriginNote}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding IsMachineDraft}"/>
                      <TextBlock Classes="body-sm secondary" Classes.chips="{Binding HasDetailMarkers}" c:MarkedText.Source="{Binding DetailMarked}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                 ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="caption secondary" Text="{Binding Tag}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="body-sm secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding ShowEmptyText}" Text="{Binding EmptyMessage}"/>
            <!-- Conferência limpa: a frase acima cede lugar ao estado vazio com o selo 訳. -->
            <c:EmptyState IsVisible="{Binding IsClear}"
                          Message="Nada trava o teste no jogo. A tradução está pronta para testar."
                          ActionText="Conferir de novo" ActionCommand="{Binding RefreshCommand}"/>
          </Panel>
          <Border Grid.Row="3" Classes="divider-top" Padding="16,10">
            <TextBlock Classes="caption secondary" Text="{Binding ListFooter}" TextTrimming="CharacterEllipsis"/>
          </Border>
        </Grid>
      </Border>

      <!-- Painel do problema: o que é, o original, a tradução de hoje, como vai ficar e as ações. -->
      <Border Grid.Column="1" Classes="panel" Padding="16" AutomationProperties.Name="Problema selecionado">
        <Panel>
          <TextBlock Classes="body-sm secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding !HasSelection}" Text="Selecione um problema para ver o que fazer."/>
          <Panel IsVisible="{Binding HasSelection}">
            <Grid RowDefinitions="*,Auto" DataContext="{Binding SelectedRow}" x:DataType="vm:ConferenceIssueRowViewModel">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:SeverityTag Level="{Binding Level}"/>
                    <TextBlock Classes="body-sm secondary" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Classes="title-md" Text="{Binding DetailTitle}" TextWrapping="Wrap"/>
                  <StackPanel Spacing="6">
                    <TextBlock Classes="overline" Text="O que é isso"/>
                    <TextBlock Classes="body-sm secondary" Text="{Binding Explanation}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <!-- O nome como está no texto extraído, para copiar para o Glossário sem digitar de cabeça (um C largo e um C latino não casam). -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasSpeaker}">
                    <TextBlock Classes="overline" Text="Quem fala"/>
                    <Border Classes="original">
                      <SelectableTextBlock Classes="jp-body" Text="{Binding Speaker}" TextWrapping="Wrap" c:SpeakerMenu.Original="{Binding Speaker}" AutomationProperties.Name="Quem fala"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasCharacterList}">
                    <TextBlock Classes="overline" Text="Nesta fala"/>
                    <TextBlock Classes="body-sm" Text="{Binding CharacterSentence}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasOriginal}">
                    <TextBlock Classes="overline" Text="Original"/>
                    <Border Classes="original">
                      <TextBlock Classes="jp-body" c:MarkedText.Source="{Binding Original}" TextWrapping="Wrap" AutomationProperties.Name="Texto original"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasTranslation}">
                    <TextBlock Classes="overline" Text="{Binding TranslationLabel}"/>
                    <Border Classes="original">
                      <TextBlock FontSize="14" LineHeight="26" c:MarkedText.Source="{Binding Translation}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TranslationLabel}"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasProposal}">
                    <TextBlock Classes="overline" Text="Como vai ficar"/>
                    <Border Classes="original proposal">
                      <TextBlock FontSize="14" LineHeight="26" c:MarkedText.Source="{Binding ProposedText}" TextWrapping="Wrap" AutomationProperties.Name="Como vai ficar"/>
                    </Border>
                  </StackPanel>
                  <!-- Não cabe na caixa: a caixa do jogo com a tradução de hoje e as duas saídas do Editor, dividir em páginas ou encurtar com a IA. -->
                  <StackPanel Spacing="10" IsVisible="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).HasSelectedFit}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <c:GameTextbox HorizontalAlignment="Left" Size="Small"
                                     Layout="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectedLayout}"
                                     AutomationProperties.Name="Caixa do jogo"/>
                    </ScrollViewer>
                    <c:FitWarning DataContext="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).SelectedFit}" x:DataType="vm:FitWarningViewModel"
                                  Message="{Binding Message}" SplitText="{Binding SplitText}" ShortenText="{Binding ShortenText}"
                                  SplitCommand="{Binding SplitCommand}" ShortenCommand="{Binding ShortenCommand}" ShowShorten="{Binding HasShortener}"
                                  ErrorText="{Binding Error}" AutomationProperties.Name="Aviso: não cabe na caixa do jogo"/>
                  </StackPanel>
                  <c:TechnicalDetails Key="conference" AutomationProperties.Name="Detalhes técnicos">
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                      <TextBlock Classes="mono secondary" FontSize="12" LineHeight="16" Text="{Binding LineLabel, StringFormat='Linha {0}'}"/>
                      <TextBlock Classes="mono secondary" FontSize="12" LineHeight="16" Text="{Binding RuleId, StringFormat='Regra {0}'}"/>
                    </StackPanel>
                  </c:TechnicalDetails>
                </StackPanel>
              </ScrollViewer>
              <!-- Barra fixa no pé do painel: a ação principal em destaque (Enter), as outras duas ao lado uma da outra. Sem correção automática, "Abrir no editor" é a principal. -->
              <Border Grid.Row="1" Classes="divider-top" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          IsVisible="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).ShowFixAndNext}"
                          Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).FixAndNextCommand}"
                          AutomationProperties.Name="Corrigir e ir para o próximo problema">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Corrigir e ir para o próximo" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Enter"/></Border>
                    </StackPanel>
                  </Button>
                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanRegisterCharacter}"
                          Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).RegisterCharacterCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Cadastrar personagem">
                    <TextBlock Text="Cadastrar personagem" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes.accent="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).OpenIsPrimary}"
                            Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).OpenLineCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Abrir a linha no Editor">
                      <TextBlock Text="Abrir no editor"/>
                    </Button>
                    <Button Classes="subtle" IsVisible="{Binding CanMarkOk}"
                            Command="{Binding $parent[UserControl].((vm:ConferenceViewModel)DataContext).MarkOkCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Está certo assim: deixar de avisar desta linha">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
                        <TextBlock Text="Está certo assim"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Panel>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
