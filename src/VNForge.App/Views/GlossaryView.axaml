<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:g="using:VNForge.Core.Glossary"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.GlossaryView"
             x:DataType="vm:GlossaryViewModel">

  <UserControl.Styles>
    <!-- Célula editável do artboard do Glossário: o texto fica no lugar do texto do quadro (as células sobem 8 px para a esquerda), sem borda até o ponteiro passar; em foco, borda accent sobre bg-inset. -->
    <Style Selector="TextBox.cell">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="PlaceholderForeground" Value="{DynamicResource Vnf.TextTertiary}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
    </Style>
    <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    </Style>
    <!-- Cartão do quadro (x-card): raio 16 sobre o painel comum. -->
    <Style Selector="Border.panel.card">
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    </Style>
    <!-- Abas do Glossário (v3-tabs do quadro): 15/700 na fonte de título, 43 de altura, 32 entre elas e o sublinhado accent de 3 px na largura do texto. -->
    <Style Selector="TabControl.gtabs > TabItem">
      <Setter Property="Height" Value="43"/>
      <Setter Property="Padding" Value="0,8,0,11"/>
      <Setter Property="Margin" Value="0,0,32,0"/>
      <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TabControl.tabs.gtabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TabControl.tabs.gtabs > TabItem /template/ Border#PART_Underline">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- A contagem tem a fonte, o corpo e o peso do rótulo da aba (15/700, a altura de linha da própria fonte): no mesmo corpo as duas linhas de base coincidem; a 11 px ela ficava pequena e elevada. -->
    <Style Selector="TextBlock.count">
      <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontDisplay}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LineHeight" Value="NaN"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Cabeçalho de coluna do quadro (x-gh): 12/600 em text-secondary, sem caixa alta. -->
    <Style Selector="TextBlock.column-head">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.ColumnHeader}"/>
      <Setter Property="LineHeight" Value="{DynamicResource Vnf.LineHeight.ColumnHeader}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Linha das tabelas (x-gr, x-tr): filete em cima, 20 de respiro dos lados e a altura que o quadro dá (47 de personagem, 48 de termo). -->
    <Style Selector="Border.grow">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="20,9"/>
    </Style>
    <Style Selector="Border.grow.term">
      <Setter Property="Padding" Value="20,10,20,9"/>
    </Style>
    <!-- Retrato da linha: o botão que abre a ficha, redondo e do tamanho do retrato. -->
    <Style Selector="Button.dot">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="-4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.portrait">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Seletor pequeno do quadro (x-sel.sm): 28 de altura, fundo bg-inset, contorno de controle, 13 px; sem valor, o texto vai em text-tertiary. -->
    <Style Selector="ComboBox.sel">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="12,0,0,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    </Style>
    <Style Selector="ComboBox.sel.unset">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextTertiary}"/>
    </Style>
    <!-- Busca do quadro (v3-input): bg-inset, contorno de controle, raio 8, texto de 14. -->
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="PlaceholderForeground" Value="{DynamicResource Vnf.TextTertiary}"/>
    </Style>
    <!-- Linha que ficou de fora do arquivo (nome vazio ou repetido): a borda vermelha marca onde corrigir. -->
    <Style Selector="TextBox.cell.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.SignalErrorFg}"/>
    </Style>
    <Style Selector="TextBox.jp">
      <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    </Style>
    <Style Selector="TextBlock.jp">
      <Setter Property="FontFamily" Value="{DynamicResource Vnf.FontJp}"/>
    </Style>
    <!-- Sugestão da IA esperando o visto: o valor fica esmaecido e em itálico até a pessoa aceitar. -->
    <Style Selector="Border.suggested TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="TextBlock.uses">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.uses.unused">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    </Style>
  <!-- Meu glossário (#537): "No projeto" e "Difere do projeto". -->
  <Style Selector="Border.personal-chip">
    <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Background" Value="{DynamicResource Vnf.StatusApprovedBg}"/>
  </Style>
  <Style Selector="Border.personal-chip.warn">
    <Setter Property="Background" Value="{DynamicResource Vnf.SignalWarningBg}"/>
  </Style>
  <Style Selector="Border.personal-chip PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.personal-chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.StatusApprovedFg}"/>
    <Setter Property="FontSize" Value="{DynamicResource Vnf.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.personal-chip.warn PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
  <Style Selector="Border.personal-chip.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
  </Style>
    <Style Selector="StackPanel.alerts > :is(Control)">
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- Linha da tabela do Meu glossário: 10 px acima e abaixo e um filete embaixo, menos na última (quadro do #537). -->
    <Style Selector="Border.prow">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
    <Style Selector="ContentPresenter:nth-last-child(1) > Border.prow">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>

  <!-- O quadro do #547 abre o Glossário com a frase de apresentação, a linha das abas (busca e ação à direita) e o cartão da aba. A página tem a altura da área visível
       (MinHeight pela rolagem) para o cartão da aba Meu glossário ir até o pé. -->
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <Border Padding="32,20,32,14" MinHeight="{Binding #PageScroll.Viewport.Height}">
    <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Classes="alerts">

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SaveFailed}">
        <Button Classes="sm" Command="{Binding RetrySaveCommand}" Content="Tentar salvar de novo"/>
        <Button Classes="sm" Command="{Binding DiscardChangesCommand}" Content="{Binding DiscardLabel}"/>
      </StackPanel>
      <Border Classes="infobar warning" IsVisible="{Binding HasProblems}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ProblemsText}"/>
        </Grid>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding SuggestionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionError}"/>
        </Grid>
      </Border>
      <Border Classes="infobar success" IsVisible="{Binding SuggestionNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Checkmark}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding SuggestionNotice}"/>
        </Grid>
      </Border>

    </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,14" IsVisible="{Binding !IsPersonalTab}">
        <TextBlock Classes="body-sm secondary" LineHeight="20" MaxWidth="630" HorizontalAlignment="Left" TextWrapping="Wrap"
                   Text="Nomes e termos fixos do projeto. A IA os usa em toda tradução, Conferir a tradução os confere e o editor avisa quando um aparece na linha. Tudo é salvo sozinho."/>
        <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Top" Text="{Binding SaveStatus}" AutomationProperties.Name="Estado do salvamento"/>
      </Grid>

      <Grid Grid.Row="2">
        <TabControl Classes="tabs gtabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" AutomationProperties.Name="Glossário">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Personagens"/>
                <TextBlock Classes="count" Text="{Binding CharacterCount}"/>
              </StackPanel>
            </TabItem.Header>

            <Border Classes="panel card" ClipToBounds="True" Margin="0,12,0,0" VerticalAlignment="Top">
              <StackPanel>
                <Border Padding="20,12,20,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <TextBlock Classes="title-sm" LineHeight="20" Text="Personagens" VerticalAlignment="Center"/>
                      <TextBlock Classes="body-sm secondary" Text="{Binding CharactersSummary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding SuggestingText}"
                               IsVisible="{Binding IsSuggesting}"/>
                  </Grid>
                </Border>
                <v:CharacterSheetView DataContext="{Binding Sheet}" IsVisible="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).HasSheet}"/>
                <Border Classes="infobar banner" Classes.warning="{Binding HasMissingGender}" Margin="20,0,20,12" Padding="14,10" BorderThickness="1" BorderBrush="Transparent" IsVisible="{Binding HasVoiceStrip}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <PathIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Icon.Warning}" IsVisible="{Binding HasMissingGender}"/>
                    <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding VoiceStripText}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="sm" Classes.accent="{Binding !HasPendingSuggestions}" Command="{Binding SuggestVoicesCommand}"
                              IsVisible="{Binding HasVoiceRequests}" ToolTip.Tip="{Binding VoiceHint}" AutomationProperties.Name="Pedir à IA o gênero">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                          <TextBlock Text="{Binding VoiceButtonText}"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="sm accent" Command="{Binding AcceptAllSuggestionsCommand}" IsVisible="{Binding HasPendingSuggestions}"
                              ToolTip.Tip="Passa as sugestões da IA para o gênero e o jeito de falar das linhas" AutomationProperties.Name="Aceitar todas as sugestões">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
                          <TextBlock Text="{Binding AcceptAllText}"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid ColumnSpacing="12" Margin="20,0" Height="31">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="112"/><ColumnDefinition Width="*" MinWidth="112"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="1.36*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                  <TextBlock Classes="column-head" Text="Nome no jogo"/>
                  <TextBlock Grid.Column="1" Classes="column-head" Text="Nome na tradução"/>
                  <TextBlock Grid.Column="2" Classes="column-head" Text="Gênero"/>
                  <TextBlock Grid.Column="3" Classes="column-head" Text="Cor"/>
                  <TextBlock Grid.Column="4" Classes="column-head" Text="Como fala"/>
                  <TextBlock Grid.Column="5" Classes="column-head" Text="Falas" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding VisibleCharacters}" AutomationProperties.Name="Personagens">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterRow">
                      <Border Classes="grow" Background="Transparent">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="112"/><ColumnDefinition Width="*" MinWidth="112"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="1.36*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                          <Button Classes="portrait" IsEnabled="{Binding !IsBlank}"
                                  Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).OpenSheetCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Abrir a ficha do personagem" AutomationProperties.Name="{Binding OpenSheetLabel}">
                            <c:Portrait Size="Sm" Seed="{Binding Target}" Tint="{Binding Color}"/>
                          </Button>
                          <TextBox Grid.Column="1" Classes="cell jp" Classes.invalid="{Binding HasProblem}" FontSize="14" FontWeight="Medium" ToolTip.Tip="{Binding Problem}"
                                   Text="{Binding Source}" AutomationProperties.Name="Nome no jogo"/>
                        </Grid>
                        <TextBox Grid.Column="1" Classes="cell" Margin="-8,0" FontSize="14" FontWeight="SemiBold" c:SpeakerColorTint.Color="{Binding Color}"
                                 Text="{Binding Target}" AutomationProperties.Name="Nome na tradução"/>
                        <ComboBox Grid.Column="2" Classes="sel" Classes.unset="{Binding NeedsGender}" HorizontalAlignment="Stretch" IsVisible="{Binding !HasSuggestion}"
                                  ItemsSource="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).Genders}"
                                  SelectedItem="{Binding Gender}" AutomationProperties.Name="Gênero">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="g:CharacterGender">
                              <TextBlock Text="{Binding, Converter={x:Static c:GenderLabelConverter.Instance}}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Grid.Column="2" Classes="suggested" IsVisible="{Binding HasSuggestion}" MinHeight="28" Height="28"
                                Background="{DynamicResource Vnf.BgInset}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="1"
                                CornerRadius="{DynamicResource Vnf.RadiusSm}" Padding="12,0,2,0">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" ToolTip.Tip="Sugestão da IA, ainda não aceita">
                            <TextBlock Classes="value" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SuggestedGenderLabel}"/>
                            <Button Grid.Column="1" Classes="icon subtle sm" VerticalAlignment="Center"
                                    Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).AcceptSuggestionCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Aceitar a sugestão" AutomationProperties.Name="Aceitar a sugestão">
                              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Checkmark}"/>
                            </Button>
                            <Button Grid.Column="2" Classes="icon subtle sm" VerticalAlignment="Center"
                                    Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).DismissSuggestionCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Descartar a sugestão" AutomationProperties.Name="Descartar a sugestão">
                              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Dismiss}"/>
                            </Button>
                          </Grid>
                        </Border>
                        <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" c:SpeakerColorTint.Color="{Binding Color}" IsVisible="{Binding !HasCustomColor}"/>
                          <!-- Com cor escolhida, o ponto é o botão de voltar à cor automática: o quadro não tem lugar para outro botão na coluna. -->
                          <Button Classes="dot" IsVisible="{Binding HasCustomColor}" Command="{Binding UseAutomaticColorCommand}"
                                  ToolTip.Tip="Voltar à cor automática" AutomationProperties.Name="Voltar à cor automática">
                            <Border Width="10" Height="10" CornerRadius="5" c:SpeakerColorTint.Color="{Binding Color}"/>
                          </Button>
                          <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Static c:CharacterPalette.All}"
                                    SelectedItem="{Binding Color}" AutomationProperties.Name="Cor do personagem">
                            <ComboBox.SelectionBoxItemTemplate>
                              <DataTemplate x:DataType="c:CharacterColor">
                                <TextBlock Text="{Binding Label}"/>
                              </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="c:CharacterColor">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" c:SpeakerColorTint.Color="{Binding}"/>
                                  <TextBlock Text="{Binding Label}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                        <TextBox Grid.Column="4" Classes="cell" Margin="-8,0" Text="{Binding Tone}" PlaceholderText="{Binding TonePlaceholder}" AutomationProperties.Name="Como fala"/>
                        <TextBlock Grid.Column="5" Classes="mono uses" Classes.unused="{Binding IsUnused}" Text="{Binding UsesLabel}"
                                   ToolTip.Tip="Linhas faladas pelo personagem"/>
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Revisar falas deste personagem"
                                      Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).ReviewCharacterCommand}" CommandParameter="{Binding}"/>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Button Grid.Column="6" Classes="icon subtle sm" Foreground="{DynamicResource Vnf.TextSecondary}" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).RemoveCharacterCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Remover personagem" AutomationProperties.Name="Remover personagem">
                          <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Dismiss}"/>
                        </Button>
                      </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="body-sm secondary" Margin="20,8,20,16" Text="{Binding CharactersEmptyText}" IsVisible="{Binding NoVisibleCharacters}"/>
                <Border Classes="divider-top" Padding="20,13">
                  <TextBlock Classes="body-sm secondary" VerticalAlignment="Center"
                             Text="Falas = quantas falas do jogo são do personagem. O nome no jogo é o que aparece na caixa de nome do texto original."/>
                </Border>
              </StackPanel>
            </Border>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Termos"/>
                <TextBlock Classes="count" Text="{Binding TermCount}"/>
              </StackPanel>
            </TabItem.Header>

            <Grid ColumnDefinitions="*,360" ColumnSpacing="20" Margin="0,12,0,0">
              <Border Classes="panel card" ClipToBounds="True" VerticalAlignment="Top">
                <StackPanel>
                  <Border Padding="20,12,20,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="title-sm" LineHeight="20" Text="Termos" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Classes="body-sm secondary" Text="{Binding TermsSummary}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Grid ColumnDefinitions="*,*,1.3*,90,28" ColumnSpacing="12" Margin="20,0" Height="32">
                    <TextBlock Classes="column-head" Text="Em japonês"/>
                    <TextBlock Grid.Column="1" Classes="column-head" Text="Em português"/>
                    <TextBlock Grid.Column="2" Classes="column-head" Text="Observação para a IA"/>
                    <TextBlock Grid.Column="3" Classes="column-head" Text="Linhas" HorizontalAlignment="Right"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding VisibleTerms}" AutomationProperties.Name="Termos do glossário">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GlossaryTermRow">
                        <Border Classes="grow term">
                        <Grid ColumnDefinitions="*,*,1.3*,90,28" ColumnSpacing="12">
                          <TextBox Classes="cell jp" Margin="-8,0" Classes.invalid="{Binding HasProblem}" FontSize="15" FontWeight="Bold" ToolTip.Tip="{Binding Problem}"
                                   Text="{Binding Source}" AutomationProperties.Name="Termo em japonês"/>
                          <TextBox Grid.Column="1" Classes="cell" Margin="-8,0" FontSize="14" FontWeight="SemiBold" Text="{Binding Target}" AutomationProperties.Name="Termo em português"/>
                          <TextBox Grid.Column="2" Classes="cell" Margin="-8,0" FontSize="14" Text="{Binding Notes}" PlaceholderText="Observação para a IA" AutomationProperties.Name="Observação para a IA"/>
                          <TextBlock Grid.Column="3" Classes="mono uses" FontWeight="Normal" Classes.unused="{Binding IsUnused}" Text="{Binding UsesLabel}"
                                     ToolTip.Tip="Linhas do original que contêm o termo"/>
                          <Button Grid.Column="4" Classes="icon subtle sm" Foreground="{DynamicResource Vnf.TextSecondary}" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).RemoveTermCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Remover termo" AutomationProperties.Name="Remover termo">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Dismiss}"/>
                          </Button>
                        </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="body-sm secondary" Margin="20,8,20,16" Text="{Binding TermsEmptyText}" IsVisible="{Binding NoVisibleTerms}"/>
                  <Border Classes="divider-top" Padding="20,13">
                    <TextBlock Classes="body-sm secondary" VerticalAlignment="Center"
                               Text="Linhas = quantas linhas do original contêm o termo, em todos os capítulos."/>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="panel card" ClipToBounds="True" VerticalAlignment="Top" AutomationProperties.Name="Sugestões para o glossário">
                <StackPanel>
                  <Border Padding="20,12">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="title-sm" LineHeight="20" Text="Termos que se repetem"/>
                      <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding RepeatedSummary}"/>
                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" IsVisible="{Binding HasRepeatedTerms}">
                        <Button Classes="sm accent" Command="{Binding SuggestTermsCommand}" ToolTip.Tip="{Binding TermsHint}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                            <TextBlock Text="{Binding TermsButtonText}"/>
                          </StackPanel>
                        </Button>
                        <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding SuggestingText}" IsVisible="{Binding IsSuggesting}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RepeatedTermRows}" AutomationProperties.Name="Termos que se repetem">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepeatedTermRow">
                          <Border Classes="divider-top" Padding="16,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="jp" FontSize="15" FontWeight="Bold" Text="{Binding Source}"/>
                                  <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding LinesLabel}"/>
                                </StackPanel>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Target}" IsVisible="{Binding HasSuggestion}"/>
                                <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Reason}" IsVisible="{Binding HasSuggestion}"/>
                              </StackPanel>
                              <Button Grid.Column="1" Classes="sm" VerticalAlignment="Top" Content="Adicionar"
                                      Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).AddRepeatedTermCommand}"
                                      CommandParameter="{Binding}" AutomationProperties.Name="Adicionar ao glossário"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <StackPanel IsVisible="{Binding HasCorrectedTerms}">
                    <Border Classes="divider-bottom" Padding="16,12">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="title-md" Text="Termos que você corrigiu"/>
                        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding CorrectedSummary}"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding CorrectedTermRows}" AutomationProperties.Name="Termos que você corrigiu">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CorrectedTermRow">
                          <Border Classes="divider-bottom" Padding="16,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="jp" FontSize="15" FontWeight="SemiBold" Text="{Binding Source}"/>
                                  <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding LinesLabel}"/>
                                </StackPanel>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Target}"/>
                                <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding ChangeLabel}"/>
                              </StackPanel>
                              <Button Grid.Column="1" Classes="sm" VerticalAlignment="Top" Content="Adicionar"
                                      Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).AddCorrectedTermCommand}"
                                      CommandParameter="{Binding}" AutomationProperties.Name="Adicionar ao glossário"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Tratamentos"/>
                <TextBlock Classes="count" Text="{Binding AddressTerms.PairCount}"/>
              </StackPanel>
            </TabItem.Header>
            <v:AddressTermsView DataContext="{Binding AddressTerms}" VerticalAlignment="Top"/>
          </TabItem>

          <!-- Meu glossário (#537): termos que valem em toda VN, guardados fora dos projetos, e o que cada um é neste projeto. -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Meu glossário"/>
                <TextBlock Classes="count" Text="{Binding Personal.Count}"/>
              </StackPanel>
            </TabItem.Header>
            <Grid ColumnDefinitions="*,384" ColumnSpacing="16" Margin="0,12,0,0" DataContext="{Binding Personal}" x:DataType="vm:PersonalGlossaryViewModel">
              <!-- Os dois cartões vão até o pé da página, como no quadro: a tabela sobe e a nota do rodapé desce. -->
              <Border Classes="panel" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="16,14,16,8">
                    <TextBlock Classes="title-sm" Text="Termos que valem em toda VN" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding Summary}" VerticalAlignment="Center"/>
                  </Grid>
                  <Border Grid.Row="1" Classes="infobar error" Margin="16,4,16,8" IsVisible="{Binding HasError}">
                    <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Error}"/>
                  </Border>
                  <Border Grid.Row="2" Classes="divider-bottom" Padding="0,10">
                    <Grid ColumnDefinitions="127,147,*,120,222">
                      <TextBlock Classes="caption secondary" Margin="12,0" Text="Em japonês"/>
                      <TextBlock Grid.Column="1" Classes="caption secondary" Margin="12,0" Text="Em português"/>
                      <TextBlock Grid.Column="2" Classes="caption secondary" Margin="12,0" Text="Observação para a IA"/>
                      <TextBlock Grid.Column="3" Classes="caption secondary" Margin="12,0" Text="Vem de" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="3" Classes="body-sm secondary" Margin="16,12" TextWrapping="Wrap" Text="{x:Static vm:PersonalGlossaryViewModel.EmptyText}" IsVisible="{Binding IsEmpty}"/>
                  <ItemsControl Grid.Row="4" ItemsSource="{Binding Rows}" VerticalAlignment="Top" AutomationProperties.Name="Termos do glossário pessoal">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PersonalTermRow">
                        <!-- Editar e tirar o termo ficam no menu da linha (botão direito, tecla Menu, Enter ou duplo clique para editar): o quadro não desenha botões de ícone nas linhas. -->
                        <Border Classes="prow" Background="Transparent" Focusable="True" DoubleTapped="OnPersonalRowDoubleTapped" KeyDown="OnPersonalRowKeyDown">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Editar o termo" Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).Personal.EditCommand}" CommandParameter="{Binding}"/>
                              <MenuItem Header="Tirar do glossário pessoal" ToolTip.Tip="O glossário dos projetos não muda."
                                        Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).Personal.RemoveCommand}" CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Grid ColumnDefinitions="127,147,*,120,222">
                            <TextBlock Classes="jp-body" FontSize="14" LineHeight="18" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Source}"/>
                            <TextBlock Grid.Column="1" Classes="body-sm" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Target}"/>
                            <TextBlock Grid.Column="2" Classes="caption secondary" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Notes}" ToolTip.Tip="{Binding Notes}"/>
                            <TextBlock Grid.Column="3" Classes="body-sm" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProjectsText}"/>
                            <Panel Grid.Column="4" Margin="12,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Border Classes="personal-chip" IsVisible="{Binding IsInProject}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Check}"/>
                                  <TextBlock Text="No projeto"/>
                                </StackPanel>
                              </Border>
                              <Border Classes="personal-chip warn" IsVisible="{Binding Differs}" ToolTip.Tip="O projeto traduz este termo de outro jeito. A escolha do projeto fica como está.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Warning}"/>
                                  <TextBlock Text="Difere do projeto"/>
                                </StackPanel>
                              </Border>
                              <Button Classes="sm" Content="Usar no projeto" IsVisible="{Binding CanUse}" AutomationProperties.Name="{Binding Source, StringFormat='Usar {0} no projeto'}"
                                      Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).Personal.UseCommand}" CommandParameter="{Binding}"/>
                            </Panel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Grid.Row="5" Classes="divider-top" Padding="16,12,16,14">
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding FooterText}"/>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Column="1" Classes="panel" ClipToBounds="True">
                <StackPanel Margin="16" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title-sm" Text="Neste projeto"/>
                    <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding ProjectTermsText}"/>
                  </Grid>
                  <Border Classes="infobar" IsVisible="{Binding HasBanner}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Info}"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="body-sm" LineHeight="18" TextWrapping="Wrap" Text="{Binding BannerTitle}"/>
                        <TextBlock Classes="body-sm secondary" LineHeight="18" TextWrapping="Wrap" Text="{x:Static vm:PersonalGlossaryViewModel.BannerText}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Spacing="12" IsVisible="{Binding HasCandidates}">
                    <c:OverlineText Classes="overline" Text="Guardar no glossário pessoal"/>
                    <ItemsControl ItemsSource="{Binding Candidates}" AutomationProperties.Name="Termos do projeto para guardar">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeepCandidateRow">
                          <Border Classes="divider-top" Padding="0,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Classes="jp-body" FontSize="14" LineHeight="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Label}" ToolTip.Tip="{Binding Label}"/>
                              <Button Grid.Column="1" Classes="sm" Content="Guardar" AutomationProperties.Name="{Binding Label, StringFormat='Guardar {0} no glossário pessoal'}"
                                      Command="{Binding $parent[UserControl].((vm:GlossaryViewModel)DataContext).Personal.KeepCommand}" CommandParameter="{Binding}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
              <c:ScreenDialog Title="{Binding EditorTitle}" IsOpen="{Binding IsEditorOpen, Mode=TwoWay}">
                <StackPanel Spacing="12" MinWidth="420">
                  <StackPanel Spacing="4">
                    <c:OverlineText Classes="overline" Text="Em japonês"/>
                    <TextBox Classes="jp" Text="{Binding EditSource}" IsEnabled="{Binding CanEditSource}" AutomationProperties.Name="Termo em japonês"/>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <c:OverlineText Classes="overline" Text="Em português"/>
                    <TextBox Text="{Binding EditTarget}" AutomationProperties.Name="Tradução do termo"/>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <c:OverlineText Classes="overline" Text="Observação para a IA"/>
                    <TextBox Text="{Binding EditNotes}" AcceptsReturn="False" AutomationProperties.Name="Observação do termo"/>
                  </StackPanel>
                  <Border Classes="infobar error" IsVisible="{Binding HasEditError}">
                    <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding EditError}"/>
                  </Border>
                </StackPanel>
                <c:ScreenDialog.Footer>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Command="{Binding CancelEditCommand}"/>
                    <Button Classes="accent" Content="Salvar" Command="{Binding SaveEditCommand}"/>
                  </StackPanel>
                </c:ScreenDialog.Footer>
              </c:ScreenDialog>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- A busca e a ação da aba ficam na linha das abas, à direita, como no quadro. A busca vale para a tabela da aba aberta. -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
          <TextBox Classes="search" VerticalAlignment="Center" Width="300" Height="32" MinHeight="32"
                   IsVisible="{Binding ShowSearch}" Text="{Binding Search}" PlaceholderText="{Binding SearchHint}" AutomationProperties.Name="Buscar no glossário">
            <TextBox.InnerLeftContent>
              <PathIcon Width="15" Height="15" Margin="12,0,0,0" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Search}"/>
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button Command="{Binding AddCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Add}"/>
              <TextBlock Text="{Binding AddLabel}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
    </Border>
  </ScrollViewer>
</UserControl>
