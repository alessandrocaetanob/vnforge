<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Alt+Down" Command="{Binding SelectNextCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding SelectPreviousCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}"/>
  </UserControl.KeyBindings>

  <UserControl.Resources>
    <!-- Três linhas de texto, a última mais curta: a densidade Roteiro da grade (#460). Mesma grade de 20 px dos ícones do app. -->
    <StreamGeometry x:Key="Icon.Script">M3 4.5H17V6H3V4.5ZM3 9.25H17V10.75H3V9.25ZM3 14H12V15.5H3V14Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Janela abaixo de 1400 px (EditorBreakpoints): o botão das cenas aparece e os botões secundários largam o texto. -->
    <Style Selector="Button.scenes-trigger">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl).scenes-flyout Button.scenes-trigger">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=":is(UserControl).scenes-flyout TextBlock.btn-label">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Botão da barra (#394): 28 px como os chips de filtro, contorno discreto e fundo transparente; só Traduzir com IA é cheio. -->
    <Style Selector="Button.tool">
      <Setter Property="MinHeight" Value="{DynamicResource Vnf.ControlSm}"/>
      <Setter Property="Height" Value="{DynamicResource Vnf.ControlSm}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    </Style>

    <!-- A densidade da grade é um botão de dois estados com o mesmo tamanho e contorno dos outros; marcado, ganha o accent-soft dos filtros. -->
    <Style Selector="ToggleButton.density">
      <Setter Property="MinHeight" Value="{DynamicResource Vnf.ControlSm}"/>
      <Setter Property="Height" Value="{DynamicResource Vnf.ControlSm}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    </Style>
    <Style Selector="ToggleButton.density:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.density:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton.density:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.density:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,16,24,16" RowSpacing="12">

    <!-- Cabeçalho: "Capítulo 1 · cena 13 de 45" e o nome da cena. As ações moram na barra logo abaixo (#394). -->
    <c:PageHeader Breadcrumb="{Binding Breadcrumb}" Title="{Binding ScriptTitle}" IsVisible="{Binding !IsReviewing}"/>

    <!-- Barra do Editor, numa linha só: os filtros à esquerda e as ações à direita, com Traduzir com IA como a principal.
         Buscar, Conferir arquivo e Modo revisão têm o mesmo estilo e tamanho; abaixo de 1400 px largam o texto e ficam como ícones com dica. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding !IsReviewing}">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <!-- Janela pequena: a lista de cenas sai da grade e abre aqui. -->
          <Button x:Name="ScenesTrigger" Classes="scenes-trigger tool" AutomationProperties.Name="Cenas" ToolTip.Tip="Abre a lista de cenas (Ctrl+B)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
              <TextBlock Text="Cenas" TextWrapping="NoWrap"/>
              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}"/>
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <v:ScenesPanel Width="300" Height="440"/>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ItemsControl ItemsSource="{Binding Filters}" AutomationProperties.Name="Filtro de linhas" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChipViewModel">
                <c:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsChecked="{Binding IsSelected}"
                              Command="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).SelectFilterCommand}"
                              CommandParameter="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
        <!-- Densidade da grade (#460): marcado, cada linha vira roteiro (nome, original e tradução empilhados); a escolha fica em editor-layout.json. -->
        <ToggleButton x:Name="DensityToggle" Classes="density" VerticalContentAlignment="Center" IsChecked="{Binding IsScriptDensity}" ToolTip.Tip="{Binding DensityTip}" AutomationProperties.Name="Linhas como roteiro">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Script}"/>
            <TextBlock Classes="btn-label" Text="Roteiro" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <Button Classes="tool" Command="{Binding ToggleSearchCommand}" AutomationProperties.Name="Buscar e substituir"
                ToolTip.Tip="Buscar e substituir no projeto (Ctrl+F, Ctrl+H)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Search}"/>
            <TextBlock Classes="btn-label" Text="Buscar" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding CheckFileCommand}" AutomationProperties.Name="Conferir arquivo" ToolTip.Tip="Conferir arquivo: abre Conferir a tradução">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Shield}"/>
            <TextBlock Classes="btn-label" Text="Conferir arquivo" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding StartReviewCommand}" AutomationProperties.Name="Modo revisão"
                ToolTip.Tip="Modo revisão: passa pelas linhas traduzidas pela IA, uma a uma, com a caixa do jogo ao lado">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
            <TextBlock Classes="btn-label" Text="Modo revisão" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="accent sm" Margin="6,0,0,0" Command="{Binding TranslatePendingCommand}" AutomationProperties.Name="Traduzir com IA"
                ToolTip.Tip="Escolha o que traduzir, com que qualidade e por quanto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Traduzir com IA" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
        <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
      </Grid>
    </Border>

    <!-- Busca e substituição no projeto: abre aqui, sobre a grade, para quem traduz procurar a partir da linha em que está. -->
    <Border Grid.Row="3" Classes="panel" ClipToBounds="True" IsVisible="{Binding IsSearchOpen}" AutomationProperties.Name="Busca e substituição">
      <v:SearchReplaceView x:Name="SearchPanel" DataContext="{Binding Search}" CloseCommand="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).CloseSearchCommand}"/>
    </Border>

    <!-- Scripts 1* (180 a 190), linhas 2,53*, inspetor 1,9* (320 a 600): a 1440 px de janela dá 190 · 632 · 474 (v4: a lista de cenas cede 58 px à grade); o inspetor cresce para a caixa do jogo mostrar as 73 colunas (#392).
         Abaixo de 1400 px a coluna das cenas some (o flyout do cabeçalho a substitui) e o inspetor fica com 360 px; o EditorView troca as medidas. -->
    <Grid Grid.Row="4" x:Name="Columns" ColumnSpacing="12" IsVisible="{Binding !IsReviewing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="190"/>
        <ColumnDefinition Width="2.53*" MinWidth="240"/>
        <ColumnDefinition Width="1.9*" MinWidth="320" MaxWidth="600"/>
      </Grid.ColumnDefinitions>

      <!-- Cenas -->
      <Border x:Name="ScenesBorder" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Cenas">
        <v:ScenesPanel CanCollapse="True"/>
      </Border>

      <!-- Cenas recolhidas (#393): uma faixa que abre a lista ao clicar, com o nome da cena aberta de pé. -->
      <Border x:Name="ScenesStrip" Classes="panel" ClipToBounds="True" IsVisible="False" AutomationProperties.Name="Cenas recolhidas">
        <Button Classes="subtle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                Padding="0,14,0,12" CornerRadius="0" Command="{Binding ToggleScenesCommand}" ToolTip.Tip="{Binding ScenesToggleTip}"
                AutomationProperties.Name="Abrir a lista de cenas">
          <DockPanel LastChildFill="True">
            <PathIcon DockPanel.Dock="Top" Width="14" Height="14" Margin="0,0,0,14" HorizontalAlignment="Center" Data="{StaticResource Icon.ChevronRight}"/>
            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top">
              <LayoutTransformControl.LayoutTransform>
                <RotateTransform Angle="90"/>
              </LayoutTransformControl.LayoutTransform>
              <TextBlock Classes="body-sm" Text="{Binding ScriptTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="360"/>
            </LayoutTransformControl>
          </DockPanel>
        </Button>
      </Border>

      <!-- Grade de linhas: somente leitura; a edição acontece no inspetor. -->
      <Border Grid.Column="1" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Linhas">
        <Grid RowDefinitions="32,*,Auto">
          <!-- Dois cabeçalhos, um por densidade (#460): as colunas de sempre e o do Roteiro, onde quem fala, o original e a tradução dividem uma coluna só. -->
          <Border x:Name="ColumnsHeader" Classes="divider-bottom" Padding="12,0" Background="{DynamicResource Vnf.BgCard}" IsVisible="{Binding !IsScriptDensity}">
            <Grid ColumnDefinitions="56,92,132,*,1.2*,32" ColumnSpacing="8">
              <TextBlock Classes="overline" Text="Linha" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="overline" Text="Situação" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="overline" Text="Quem fala" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Classes="overline" Text="Original" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Classes="overline" Text="Tradução" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border x:Name="ScriptHeader" Classes="divider-bottom" Padding="12,0" Background="{DynamicResource Vnf.BgCard}" IsVisible="{Binding IsScriptDensity}">
            <Grid ColumnDefinitions="56,92,*" ColumnSpacing="8">
              <TextBlock Classes="overline" Text="Linha" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="overline" Text="Situação" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="overline" Text="Quem fala · original · tradução" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ListBox Grid.Row="1" x:Name="LinesList" Classes="projects lines" Classes.script="{Binding IsScriptDensity}" ItemsSource="{Binding Lines}"
                   SelectedItem="{Binding SelectedLine}" SelectionMode="Single" AutomationProperties.Name="Linhas do script">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Não traduzir" Command="{Binding Detail.KeepCommand}"
                          IsVisible="{Binding !Detail.IsKeep, FallbackValue=True}"/>
                <MenuItem Header="Traduzir" Command="{Binding Detail.TranslateCommand}"
                          IsVisible="{Binding Detail.IsKeep, FallbackValue=False}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LineViewModel">
                <c:LineRow IsScript="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).IsScriptDensity}" Number="{Binding Number}" Status="{Binding Status}" Speaker="{Binding SpeakerName}" SpeakerOriginal="{Binding SpeakerOriginal}" Original="{Binding SourcePlain}"
                           Translation="{Binding TranslationPlain}" Issue="{Binding Issue}" IssueLabel="{Binding IssueLabel}" IssueTip="{Binding IssueTip}"
                           SpeakerChanged="{Binding IsSpeakerChanged}" SpeakerTip="{Binding SpeakerChangedTip}"
                           ToolTip.Tip="{Binding Id}" c:Motion.PulseOnApproval="{Binding Status}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Lendo as linhas: esqueleto; vazio de verdade: o selo 訳 com uma frase (e "Ver todas" quando o filtro esvaziou a grade). -->
          <c:Skeleton Grid.Row="1" Rows="9" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Carregando as linhas"/>
          <c:EmptyState Grid.Row="1" IsVisible="{Binding ShowEmptyState}" Message="{Binding EmptyMessage}"
                        ActionText="{Binding EmptyActionText}" ActionCommand="{Binding ShowAllCommand}"/>

          <!-- Pé da grade: a barra de distribuição do script e a legenda com as porcentagens. -->
          <Border Grid.Row="2" Classes="divider-top" Padding="12">
            <StackPanel Spacing="8">
              <c:DistributionBar Height="8" Value="{Binding Distribution}" AutomationProperties.Name="{Binding DistributionDescription}"/>
              <WrapPanel ItemSpacing="16" LineSpacing="4">
                <TextBlock FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding LinesSummary}"/>
                <c:Legend Value="{Binding Distribution}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Inspetor: o ViewModel do detalhe fica em EditorViewModel.Detail e um DataTemplate do aplicativo desenha o painel. -->
      <Border Grid.Column="2" Classes="panel" Padding="16" AutomationProperties.Name="Linha selecionada">
        <Panel>
          <ContentControl Content="{Binding Detail}"/>
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="Selecione uma linha para ver o detalhe."
                     IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"/>
        </Panel>
      </Border>
    </Grid>

    <!-- Modo revisão: ocupa o lugar do cabeçalho e da grade enquanto houver uma revisão aberta. -->
    <v:ReviewModeView Grid.RowSpan="5" DataContext="{Binding Review}" IsVisible="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).IsReviewing}"
                      Background="{DynamicResource Vnf.BgLayer}"/>
  </Grid>
</UserControl>
