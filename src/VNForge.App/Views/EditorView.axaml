<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Alt+Down" Command="{Binding SelectNextCommand}"/>
    <KeyBinding Gesture="Alt+Up" Command="{Binding SelectPreviousCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}"/>
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Janela abaixo de 1400 px (EditorBreakpoints): o botão das cenas aparece e os botões secundários largam o texto. -->
    <Style Selector="Button.scenes-trigger">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl).scenes-flyout Button.scenes-trigger">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=":is(UserControl).scenes-flyout TextBlock.btn-label">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,16,24,16" RowSpacing="12">

    <!-- Cabeçalho: chave em mono, nome do capítulo, filtros com contagem e as duas ações do arquivo. -->
    <c:PageHeader Breadcrumb="{Binding Breadcrumb}" Title="{Binding ScriptTitle}" IsVisible="{Binding !IsReviewing}">
      <WrapPanel ItemSpacing="6" LineSpacing="8" MaxWidth="960" VerticalAlignment="Bottom" HorizontalAlignment="Right">
        <!-- Janela pequena: a lista de cenas sai da grade e abre aqui. -->
        <Button x:Name="ScenesTrigger" Classes="scenes-trigger sm" AutomationProperties.Name="Cenas" ToolTip.Tip="Abre a lista de cenas">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
            <TextBlock Text="Cenas" TextWrapping="NoWrap"/>
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}"/>
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <v:ScenesPanel Width="300" Height="440"/>
            </Flyout>
          </Button.Flyout>
        </Button>
        <ItemsControl ItemsSource="{Binding Filters}" AutomationProperties.Name="Filtro de linhas" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChipViewModel">
              <c:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsChecked="{Binding IsSelected}"
                            Command="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).SelectFilterCommand}"
                            CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="sm" Command="{Binding ToggleSearchCommand}" AutomationProperties.Name="Buscar e substituir"
                ToolTip.Tip="Buscar e substituir no projeto (Ctrl+F, Ctrl+H)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Search}"/>
            <TextBlock Classes="btn-label" Text="Buscar" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="sm" Command="{Binding CheckFileCommand}" AutomationProperties.Name="Conferir arquivo" ToolTip.Tip="Conferir arquivo: abre Conferir a tradução">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Shield}"/>
            <TextBlock Classes="btn-label" Text="Conferir arquivo" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="sm" Command="{Binding StartReviewCommand}" AutomationProperties.Name="Modo revisão"
                ToolTip.Tip="Modo revisão: passa pelas linhas traduzidas pela IA, uma a uma, com a caixa do jogo ao lado">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
            <TextBlock Classes="btn-label" Text="Modo revisão" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button Classes="accent sm" Command="{Binding TranslatePendingCommand}" ToolTip.Tip="Escolha o que traduzir, com que qualidade e por quanto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
            <TextBlock Text="Traduzir com IA" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </c:PageHeader>

    <Border Grid.Row="1" Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
        <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
      </Grid>
    </Border>

    <!-- Busca e substituição no projeto: abre aqui, sobre a grade, para quem traduz procurar a partir da linha em que está. -->
    <Border Grid.Row="2" Classes="panel" ClipToBounds="True" IsVisible="{Binding IsSearchOpen}" AutomationProperties.Name="Busca e substituição">
      <v:SearchReplaceView x:Name="SearchPanel" DataContext="{Binding Search}" CloseCommand="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).CloseSearchCommand}"/>
    </Border>

    <!-- Scripts 1* (180 a 248), linhas 2,53*, inspetor 1,9* (320 a 600): a 1440 px de janela dá 248 · 598 · 450; o inspetor cresce para a caixa do jogo mostrar as 73 colunas (#392).
         Abaixo de 1400 px a coluna das cenas some (o flyout do cabeçalho a substitui) e o inspetor fica com 360 px; o EditorView troca as medidas. -->
    <Grid Grid.Row="3" x:Name="Columns" ColumnSpacing="12" IsVisible="{Binding !IsReviewing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="248"/>
        <ColumnDefinition Width="2.53*" MinWidth="240"/>
        <ColumnDefinition Width="1.9*" MinWidth="320" MaxWidth="600"/>
      </Grid.ColumnDefinitions>

      <!-- Cenas -->
      <Border x:Name="ScenesBorder" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Cenas">
        <v:ScenesPanel/>
      </Border>

      <!-- Grade de linhas: somente leitura; a edição acontece no inspetor. -->
      <Border Grid.Column="1" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Linhas">
        <Grid RowDefinitions="32,*,Auto">
          <Border Classes="divider-bottom" Padding="16,0" Background="{DynamicResource Vnf.BgCard}">
            <Grid ColumnDefinitions="52,96,96,*,*,24" ColumnSpacing="12">
              <TextBlock Classes="overline" Text="Linha" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="overline" Text="Situação" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="overline" Text="Personagem" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Classes="overline" Text="Original" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Classes="overline" Text="Tradução" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ListBox Grid.Row="1" x:Name="LinesList" Classes="projects lines" ItemsSource="{Binding Lines}"
                   SelectedItem="{Binding SelectedLine}" SelectionMode="Single" AutomationProperties.Name="Linhas do script">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Não traduzir" Command="{Binding Detail.KeepCommand}"
                          IsVisible="{Binding !Detail.IsKeep, FallbackValue=True}"/>
                <MenuItem Header="Traduzir" Command="{Binding Detail.TranslateCommand}"
                          IsVisible="{Binding Detail.IsKeep, FallbackValue=False}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LineViewModel">
                <c:LineRow Number="{Binding Number}" Status="{Binding Status}" Speaker="{Binding SpeakerName}" Original="{Binding SourcePlain}"
                           Translation="{Binding TranslationPlain}" Issue="{Binding Issue}" IssueLabel="{Binding IssueLabel}" IssueTip="{Binding IssueTip}"
                           ToolTip.Tip="{Binding Id}" c:Motion.PulseOnApproval="{Binding Status}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Lendo as linhas: esqueleto; vazio de verdade: o selo 訳 com uma frase (e "Ver todas" quando o filtro esvaziou a grade). -->
          <c:Skeleton Grid.Row="1" Rows="9" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Carregando as linhas"/>
          <c:EmptyState Grid.Row="1" IsVisible="{Binding ShowEmptyState}" Message="{Binding EmptyMessage}"
                        ActionText="{Binding EmptyActionText}" ActionCommand="{Binding ShowAllCommand}"/>

          <!-- Pé da grade: a barra de distribuição do script e a legenda com as porcentagens. -->
          <Border Grid.Row="2" Classes="divider-top" Padding="12">
            <StackPanel Spacing="8">
              <c:DistributionBar Height="8" Value="{Binding Distribution}" AutomationProperties.Name="{Binding DistributionDescription}"/>
              <WrapPanel ItemSpacing="16" LineSpacing="4">
                <TextBlock FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding LinesSummary}"/>
                <c:Legend Value="{Binding Distribution}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Inspetor: o ViewModel do detalhe fica em EditorViewModel.Detail e um DataTemplate do aplicativo desenha o painel. -->
      <Border Grid.Column="2" Classes="panel" Padding="16" AutomationProperties.Name="Linha selecionada">
        <Panel>
          <ContentControl Content="{Binding Detail}"/>
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="Selecione uma linha para ver o detalhe."
                     IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"/>
        </Panel>
      </Border>
    </Grid>

    <!-- Modo revisão: ocupa o lugar do cabeçalho e da grade enquanto houver uma revisão aberta. -->
    <v:ReviewModeView Grid.RowSpan="4" DataContext="{Binding Review}" IsVisible="{Binding $parent[v:EditorView].((vm:EditorViewModel)DataContext).IsReviewing}"
                      Background="{DynamicResource Vnf.BgLayer}"/>
  </Grid>
</UserControl>
