<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.GameCapturesView"
             x:DataType="vm:GameCapturesViewModel">

  <UserControl.Styles>
    <!-- ".card.pad6" do quadro: bg-card, borda stroke-subtle, raio lg e 24 de respiro. -->
    <Style Selector="Border.shots-card">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style Selector="Border.shots-card.small">
      <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- ".shot": 16 por 10, raio md, borda stroke-subtle, bg-inset; a data é uma pílula escura no canto de baixo. -->
    <Style Selector="Border.shot">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.shot-date">
      <Setter Property="Background" Value="#8C000000"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="Margin" Value="8,0,0,6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Border.shot-date > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LineHeight" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- ".v3-field": o campo das notas, com o contorno accent de 1,5 enquanto tem o foco. O TextBox de dentro não tem moldura. -->
    <Style Selector="Border.notes-field">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusMd}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="MinHeight" Value="260"/>
    </Style>
    <Style Selector="Border.notes-field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="11.5,9.5"/>
    </Style>
    <!-- ".v3-banner": a faixa de aviso com o ponto de estado. -->
    <Style Selector="Border.shots-banner">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <c:EmptyState Name="NoGame" IsVisible="{Binding HasNoGame}" Message="Este projeto não está na Biblioteca. Adicione a pasta do jogo à Biblioteca para guardar capturas e notas por aqui."/>

    <ScrollViewer IsVisible="{Binding HasGame}" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="32,20,32,24" ColumnDefinitions="*,420" ColumnSpacing="24">
        <StackPanel VerticalAlignment="Top" Spacing="16">
          <v:GamePlayView DataContext="{Binding Session}"/>
          <Border Classes="shots-card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Classes="lib-h2" Text="Capturas"/>
                  <WrapPanel>
                    <TextBlock Classes="lib-dim" FontSize="13" LineHeight="20" VerticalAlignment="Center" Text="Tecle "/>
                    <Border Classes="kbd" Margin="0,0,4,0" VerticalAlignment="Center"><TextBlock Text="F9"/></Border>
                    <TextBlock Classes="lib-dim" FontSize="13" LineHeight="20" VerticalAlignment="Center" Text="com o jogo aberto. A imagem vai para a pasta Capturas do jogo, com a data."/>
                  </WrapPanel>
                </StackPanel>
                <Button Grid.Column="1" Name="OpenFolderButton" VerticalAlignment="Top" Command="{Binding OpenCapturesFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                    <TextBlock Text="Abrir a pasta"/>
                  </StackPanel>
                </Button>
              </Grid>

              <TextBlock Name="NoCaptures" Classes="lib-dim" IsVisible="{Binding HasNoCaptures}" Text="Nenhuma captura ainda."/>
              <ItemsControl Name="Shots" Margin="0,0,-12,-12" ItemsSource="{Binding Captures}" IsVisible="{Binding HasCaptures}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameCaptureItem">
                    <Border Classes="shot" Margin="0,0,12,12">
                      <Panel>
                        <Viewbox Stretch="Uniform"><Border Width="160" Height="100"/></Viewbox>
                        <Image Stretch="UniformToFill" Source="{Binding Path, Converter={x:Static c:FilePathBitmapConverter.Instance}}" AutomationProperties.AccessibilityView="Raw"/>
                        <Border Classes="shot-date"><TextBlock Text="{Binding Label}"/></Border>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Name="BlackBanner" Classes="shots-banner" IsVisible="{Binding BlackWarning}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Vnf.SignalWarningFg}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Uma captura saiu preta"/>
                    <TextBlock Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="Jogos em tela cheia exclusiva nem sempre deixam o app ler a imagem. Abra o jogo em janela."/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Name="HotkeyBanner" Classes="shots-banner" IsVisible="{Binding HotkeyTaken}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Vnf.SignalWarningFg}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="A tecla F9 está em uso"/>
                    <TextBlock Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="Outro programa já usa a F9, então o atalho não captura o jogo. Feche esse programa e abra esta aba de novo."/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Name="ErrorBanner" Classes="shots-banner" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Vnf.SignalErrorFg}"/>
                  <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
          <v:GamePlayStatsView DataContext="{Binding Session}"/>
          <Border Classes="shots-card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="lib-h2" Text="Notas do jogo"/>
                <TextBlock Name="SavedText" Grid.Column="1" Classes="lib-dim" FontSize="12" VerticalAlignment="Center" Text="{Binding SavedText}"/>
              </Grid>
              <Border Classes="notes-field">
                <TextBox Name="NoteBox" Classes="bare" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         LineHeight="24" Text="{Binding NoteText}" AutomationProperties.Name="Notas do jogo"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="shots-card small">
            <StackPanel Spacing="12">
              <TextBlock Classes="lib-h3" Text="Na tradução"/>
              <TextBlock Classes="lib-dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                         Text="As capturas aparecem como referência no Editor. Para as imagens com texto, a captura vira a base da tradução da imagem."/>
              <Button Name="ShowInEditorButton" Classes="sm" HorizontalAlignment="Left" Command="{Binding ShowInEditorCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Edit}"/>
                  <TextBlock Text="Ver no Editor"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Panel>
</UserControl>
