<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:v="using:VNForge.App.Views"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.LibraryQueueTable"
             x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <!-- ".tbl.on" do quadro da #551: a linha do jogo aberto na gaveta vai de accent-soft. -->
    <Style Selector="Border.qrow.sel">
      <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
    </Style>
  </UserControl.Styles>

  <!-- A lista (d5, #551): uma tabela dentro de um cartão sem folga, uma linha por jogo, e o aviso de que "Traduzir este jogo" já cria o projeto preenchido. -->
  <!-- O cartão fica no alto e a lista rola dentro dele, com as linhas virtualizadas: com centenas de jogos só as que aparecem têm capa. O aviso vem logo abaixo do cartão; a altura da lista é limitada no código (LibraryQueueTable.axaml.cs). -->
  <Border Padding="8,8,8,24" IsVisible="{Binding !HasNoResults}">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
      <Border Classes="lib-card" Padding="0" ClipToBounds="True" VerticalAlignment="Top">
        <Grid RowDefinitions="Auto,Auto">
          <StackPanel>
            <Grid Name="QueueHeader" Height="38" Margin="16,0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="2.2*" MinWidth="120"/>
                <ColumnDefinition Width="1.7*" MinWidth="120"/>
                <ColumnDefinition Width="1.4*" MinWidth="140"/>
                <ColumnDefinition Width="1.1*" MinWidth="108"/>
                <ColumnDefinition Width="*" MinWidth="96"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Classes="lib-dim" FontSize="12" LineHeight="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Jogo"/>
              <TextBlock Grid.Column="2" Classes="lib-dim" FontSize="12" LineHeight="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Português no VNDB"/>
              <TextBlock Grid.Column="3" Classes="lib-dim" FontSize="12" LineHeight="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Engine"/>
              <TextBlock Grid.Column="4" Classes="lib-dim" FontSize="12" LineHeight="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Texto"/>
              <TextBlock Grid.Column="5" Classes="lib-dim" FontSize="12" LineHeight="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Duração"/>
            </Grid>
          </StackPanel>
          <ScrollViewer Grid.Row="1" Name="QueueScroll" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="QueueRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryQueueRowViewModel">
                  <Border Classes="qrow" Classes.sel="{Binding Card.IsSelected}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,1,0,0">
                    <Button Classes="libcard" Command="{Binding $parent[v:LibraryQueueTable].((vm:LibraryViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding Card}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <Grid Margin="16,8" MinHeight="{DynamicResource Vnf.RowHeight}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="2.2*" MinWidth="120"/>
                          <ColumnDefinition Width="1.7*" MinWidth="120"/>
                          <ColumnDefinition Width="1.4*" MinWidth="140"/>
                          <ColumnDefinition Width="1.1*" MinWidth="108"/>
                          <ColumnDefinition Width="*" MinWidth="96"/>
                          <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="lib-dim" FontWeight="Normal" VerticalAlignment="Center" Text="{Binding PositionText}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                          <Border CornerRadius="{DynamicResource Vnf.RadiusSm}" ClipToBounds="True" Width="{DynamicResource Vnf.CoverThumbWidth}" Height="59" Background="{DynamicResource Vnf.BgInset}">
                            <c:Cover Width="{DynamicResource Vnf.CoverThumbWidth}" Image="{Binding Card.Image}" Revealed="{Binding Card.Revealed}" Seed="{Binding Card.Title}" IsVisible="{Binding Card.HasImage}"/>
                          </Border>
                          <TextBlock Grid.Column="1" Classes="lib-ct" VerticalAlignment="Center" Text="{Binding Card.Title}" ToolTip.Tip="{Binding Card.Title}"/>
                        </Grid>
                        <Border Grid.Column="2" Classes="lib-pill" Tag="{Binding PortugueseTone}"><TextBlock TextTrimming="CharacterEllipsis" Text="{Binding PortugueseText}"/></Border>
                        <Border Grid.Column="3" Classes="lib-pill" Tag="{Binding EngineTone}"><TextBlock TextTrimming="CharacterEllipsis" Text="{Binding EngineText}"/></Border>
                        <TextBlock Grid.Column="4" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding TextEstimate}"/>
                        <TextBlock Grid.Column="5" Classes="lib-dim" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Duration}"/>
                        <Button Grid.Column="6" Classes="sm" Classes.accent="{Binding IsTranslate}" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding CanAct}"
                                Command="{Binding $parent[v:LibraryQueueTable].((vm:LibraryViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding Card}" Content="{Binding ActionText}"/>
                      </Grid>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- O aviso do quadro tem 760 de largura (a coluna encolhe com a gaveta) e vem logo abaixo do cartão. -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1000*" MaxWidth="760"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Name="QueueNote" Classes="lib-card" Padding="16,12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Vnf.Accent}"/>
            <StackPanel Grid.Column="1">
              <TextBlock FontSize="14" LineHeight="20" FontWeight="SemiBold" Text="Traduzir este jogo cria o projeto já preenchido"/>
              <TextBlock Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="Personagens, gêneros e sinopse vêm do VNDB. Você só confirma o jogo e escolhe os idiomas."/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
