<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.GameHeaderView"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.sections > ListBoxItem" x:DataType="vm:NavItemViewModel">
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
      <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <!-- O cabeçalho do jogo: a volta para a Biblioteca, a capa (ainda um selo sobre o andamento), o nome, a engine, o andamento e o próximo passo; abaixo, as abas. -->
    <Border Background="{DynamicResource Vnf.BgBase}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
      <StackPanel Margin="32,12,32,0" Spacing="12">

        <!-- Janela baixa: a volta vira um botão de seta e a capa some, para a página ficar com a altura. -->
        <Grid Name="Regular" RowDefinitions="Auto,Auto" RowSpacing="12" IsVisible="{Binding !IsCompact, RelativeSource={RelativeSource AncestorType=v:GameHeaderView}}">
          <Button Classes="subtle sm" HorizontalAlignment="Left" Command="{Binding OpenLibraryCommand}"
                  AutomationProperties.Name="Voltar para a Biblioteca">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.ArrowLeft}"/>
              <TextBlock Text="Biblioteca"/>
            </StackPanel>
          </Button>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Border Width="56" Height="75" ClipToBounds="True" CornerRadius="{DynamicResource Vnf.RadiusSm}" Background="{DynamicResource Vnf.BgInset}"
                    AutomationProperties.AccessibilityView="Raw">
              <Panel>
                <Viewbox Width="30" Height="30" Margin="0,0,0,6" Opacity="0.35">
                  <Path Data="{StaticResource Brand.Seal}" Fill="{DynamicResource Vnf.TextPrimary}"/>
                </Viewbox>
                <Border VerticalAlignment="Bottom" Height="5" Background="{DynamicResource Vnf.CoverChipBg}">
                  <Border HorizontalAlignment="Left" Background="{DynamicResource Vnf.Accent}"
                          Width="{Binding GameProgressPercent, Converter={x:Static v:GameHeaderView.CoverBarWidth}}"/>
                </Border>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="title-lg" Text="{Binding ProjectTitle}" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="game-tag">
                  <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding GameEngineLabel}"/>
                </Border>
                <Border Classes="game-pill">
                  <TextBlock Name="Progress" Text="{Binding GameProgressLabel}"/>
                </Border>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center" Command="{Binding Dashboard.OpenNextStepCommand}"
                    IsVisible="{Binding Dashboard.HasNextStep}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Edit}"/>
                <TextBlock Text="{Binding Dashboard.NextStepLabel}"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>

        <Grid Name="Compact" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=v:GameHeaderView}}">
          <Button Classes="subtle sm icon" Command="{Binding OpenLibraryCommand}" VerticalAlignment="Center"
                  AutomationProperties.Name="Voltar para a Biblioteca" ToolTip.Tip="Voltar para a Biblioteca">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.ArrowLeft}"/>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Classes="title-md" Text="{Binding ProjectTitle}" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Border Classes="game-tag">
              <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding GameEngineLabel}"/>
            </Border>
            <Border Classes="game-pill">
              <TextBlock Text="{Binding GameProgressLabel}"/>
            </Border>
          </StackPanel>
          <Button Grid.Column="2" Classes="accent sm" VerticalAlignment="Center" Command="{Binding Dashboard.OpenNextStepCommand}"
                  IsVisible="{Binding Dashboard.HasNextStep}">
            <TextBlock Text="{Binding Dashboard.NextStepLabel}"/>
          </Button>
        </Grid>

        <ListBox Classes="gametabs" ItemsSource="{Binding GameTabs}" SelectedItem="{Binding SelectedGameTab}" AutomationProperties.Name="Abas do jogo">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTabItem">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- A segunda linha da Tradução. O Editor e a Revisão são a mesma página; Conferir leva o contador de erros. -->
    <ListBox Classes="sections" Margin="32,16,32,0" IsVisible="{Binding ShowSections}" ItemsSource="{Binding Sections}"
             SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Seções da tradução">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NavItemViewModel">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            <Border IsVisible="{Binding HasBadge}" MinWidth="16" Height="16" Padding="4,0" CornerRadius="8" VerticalAlignment="Center"
                    Background="{DynamicResource Vnf.SignalErrorBg}">
              <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Vnf.SignalErrorFg}"/>
            </Border>
            <Ellipse Name="NoticeDot" IsVisible="{Binding ShowNotice}" Width="8" Height="8" Fill="{DynamicResource Vnf.TextSecondary}" VerticalAlignment="Center"
                     ToolTip.Tip="Há avisos abertos; nenhum é erro."/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>
