<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.EvalView"
             x:DataType="vm:EvalViewModel">

  <UserControl.Styles>
    <!-- Os "chips" da faixa de cima: conjunto ouro, amostra e número de configurações (pílula de 32 px sobre bg-card, como no quadro). -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="Border.chip > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- A "tag": pílula de 24 px sobre bg-inset, para as notas do rodapé e a "configuração escondida". -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusPill}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="Border.tag > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- O selo "Escolhida para o M4". -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <!-- Linha da tabela: o botão só desenha o fundo e o divisor de baixo (a última não tem); a escolhida para o M4 ganha accent-soft e um fio de 2 px em accent. -->
    <Style Selector="Button.evalrow">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.evalrow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
    </Style>
    <Style Selector="Button.evalrow.last /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.evalrow.chosen /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vnf.AccentSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    </Style>
    <Style Selector="Button.evalrow.picked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
    </Style>
    <!-- A letra da configuração: só a letra, em cinza; a escolhida para o M4 em accent-text. -->
    <Style Selector="TextBlock.rowletter">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.rowletter.chosen">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.AccentText}"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <StackPanel Spacing="16">

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <Border Classes="infobar" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Check}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding Message}"/>
        </Grid>
      </Border>

      <c:Skeleton Rows="4" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Carregando as provas"/>

      <c:EmptyState IsVisible="{Binding ShowNoGold}" Message="{Binding NoGoldText}"/>

      <!-- A faixa de cima: o conjunto ouro, a amostra, as configurações e as duas formas de rodar. -->
      <Grid x:Name="Strip" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowStrip}"
            AutomationProperties.Name="Banco de provas">
        <Border Classes="chip">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="body-sm secondary" Text="Conjunto ouro"/>
            <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding GoldText}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="chip">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="body-sm secondary" Text="Amostra"/>
            <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding SampleText}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="chip">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="body-sm secondary" Text="Configurações"/>
            <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding ConfigCount}"/>
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="3" Classes="body-sm secondary" VerticalAlignment="Center" Text="{Binding RunStatus}" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding IsRunning}"/>
        <Button Grid.Column="4" Content="Cancelar a rodada" Command="{Binding CancelRunCommand}" IsVisible="{Binding IsRunning}"/>
        <Button Grid.Column="4" Command="{Binding RunOpenCommand}" IsVisible="{Binding !IsRunning}" AutomationProperties.Name="Rodar provas">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
            <TextBlock Text="Rodar provas"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Classes="subtle" Foreground="{DynamicResource Vnf.TextSecondary}" Command="{Binding CopyTerminalCommandCommand}" ToolTip.Tip="Copia o comando para o terminal"
                AutomationProperties.Name="Rodar no terminal">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Rodar no terminal"/>
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Classes="mono-xs" Text="{Binding TerminalCommand}"/></Border>
          </StackPanel>
        </Button>
      </Grid>

      <Border Classes="panel" Padding="24" IsVisible="{Binding ShowNoRound}">
        <StackPanel Spacing="12" HorizontalAlignment="Left">
          <TextBlock Classes="title-md" Text="Nenhuma rodada ainda"/>
          <TextBlock Classes="body" TextWrapping="Wrap" MaxWidth="560" Text="{Binding NoRoundText}"/>
        </StackPanel>
      </Border>

      <!-- O relatório da rodada: a tabela à esquerda e, à direita, um cartão só com o gráfico, a leitura e a rodada às cegas. Os dois cartões vão até o pé da janela (EvalView.axaml.cs). -->
      <Grid x:Name="Body" ColumnDefinitions="*,380" RowDefinitions="*" ColumnSpacing="20" RowSpacing="16" IsVisible="{Binding ShowReport}">
        <Border Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="16,12,16,0">
              <TextBlock Classes="title-sm" VerticalAlignment="Center" Text="{Binding RoundTitle}"/>
              <TextBlock Grid.Column="1" Classes="caption secondary" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding RoundSubtitle}"/>
            </Grid>

            <Border Grid.Row="1" Classes="divider-bottom" Padding="16,17,16,11">
              <Grid ColumnDefinitions="24,*,120,64,144,56,108" ColumnSpacing="8">
                <TextBlock Grid.ColumnSpan="2" Classes="column-header secondary" Text="Configuração"/>
                <TextBlock Grid.Column="2" Classes="column-header secondary" HorizontalAlignment="Right" Text="Jogo todo, estimado" TextWrapping="Wrap" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Classes="column-header secondary" Margin="12,0,0,0" Text="Tempo"/>
                <TextBlock Grid.Column="4" Classes="column-header secondary" Text="chrF contra a aprovada"/>
                <TextBlock Grid.Column="5" Classes="column-header secondary" HorizontalAlignment="Right" Text="Juiz de IA" TextWrapping="Wrap" TextAlignment="Right"/>
                <TextBlock Grid.Column="6" Classes="column-header secondary" HorizontalAlignment="Right" Text="Sua escolha às cegas" TextWrapping="Wrap" TextAlignment="Right"/>
              </Grid>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" VerticalAlignment="Top" AutomationProperties.Name="Configurações da rodada">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EvalRowViewModel">
                  <Button Classes="subtle evalrow" Classes.chosen="{Binding IsChosen}" Classes.picked="{Binding IsSelected}" Classes.last="{Binding IsLast}"
                          Command="{Binding $parent[UserControl].((vm:EvalViewModel)DataContext).SelectRowCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Letter, StringFormat='Configuração {0}'}">
                    <Grid ColumnDefinitions="24,*,120,64,144,56,108" ColumnSpacing="8" Margin="16,10">
                      <TextBlock Classes="body rowletter" Classes.chosen="{Binding IsChosen}" VerticalAlignment="Top" Text="{Binding Letter}"/>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding ModelName}"/>
                          <Border Classes="badge" VerticalAlignment="Center" IsVisible="{Binding IsChosen}">
                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="Escolhida para o M4"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Detail}"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Note}" IsVisible="{Binding HasNote}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Classes="body" HorizontalAlignment="Right" Text="{Binding CostText}"/>
                        <TextBlock Classes="caption secondary" HorizontalAlignment="Right" Text="{Binding BatchText}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="3" Classes="body" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding TimeText}"/>
                      <Grid Grid.Column="4" ColumnDefinitions="36,70" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="body" FontWeight="SemiBold" HorizontalAlignment="Right" Text="{Binding ChrfText}"/>
                        <c:ShareBar Grid.Column="1" Value="{Binding ChrfShare}" Fill="{DynamicResource Vnf.SegTranslated}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding ChrfText, StringFormat='chrF {0}'}"/>
                      </Grid>
                      <TextBlock Grid.Column="5" Classes="body" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding JudgeText}"/>
                      <TextBlock Grid.Column="6" Classes="body" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Text="{Binding BlindText}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="3" Classes="divider-top" Padding="16,12,16,14">
              <StackPanel Spacing="4">
                <WrapPanel>
                  <Border Classes="tag" Margin="0,0,8,6"><TextBlock Classes="caption secondary" Text="chrF: quanto a tradução se parece com a aprovada, de 0 a 100"/></Border>
                  <Border Classes="tag" Margin="0,0,8,6"><TextBlock Classes="caption secondary" Text="Juiz de IA: nota de 0 a 10, sem saber qual configuração gerou o texto"/></Border>
                </WrapPanel>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap">
                  <Run Text="A similaridade sozinha engana: por isso a rodada às cegas existe. "/><Run Text="{Binding Footnote}"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="Side" Grid.Column="1" Classes="panel" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock Classes="overline" Text="Custo e qualidade"/>
            <c:EvalChart Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Points}" Height="208"
                         AutomationProperties.Name="Gráfico de custo do jogo todo contra chrF, um ponto por configuração"/>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,12" Background="{DynamicResource Vnf.BgInset}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="1"
                    CornerRadius="{DynamicResource Vnf.RadiusMd}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Lightbulb}"/>
                  <TextBlock Classes="overline" VerticalAlignment="Center" Text="Leitura da rodada"/>
                </StackPanel>
                <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Reading}"/>
              </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="body-sm secondary" Text="Rodada às cegas" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="body-sm secondary" Text="{Binding BlindSummary}" VerticalAlignment="Center"/>
              </Grid>
              <c:ShareBar Value="{Binding BlindFraction}" AutomationProperties.Name="{Binding BlindSummary}"/>
            </StackPanel>

            <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding UseCommand}" AutomationProperties.Name="{Binding UseLabel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Check}"/>
                  <TextBlock Text="{Binding UseLabel}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding BlindStartCommand}" AutomationProperties.Name="{Binding BlindActionText}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Eye}"/>
                  <TextBlock Text="{Binding BlindActionText}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- A rodada às cegas: o original e dois textos de configurações escondidas. A resposta só aparece no relatório. Esc volta ao relatório. -->
      <Grid IsVisible="{Binding IsBlind}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1176"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="16" AutomationProperties.Name="Rodada às cegas">
        <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Rodada às cegas"/>
            <TextBlock Classes="caption secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding PairHeadline}"/>
          </StackPanel>
          <c:ShareBar Grid.Column="1" Value="{Binding PairFraction}" VerticalAlignment="Center" AutomationProperties.Name="{Binding PairTitle}"/>
        </Grid>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="overline" Text="{Binding OriginalMeta}"/>
              <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding OriginalSpeaker}"/>
            </Grid>
            <TextBlock Classes="jp-body" FontSize="22" LineHeight="35" TextWrapping="Wrap" Text="{Binding OriginalText}"/>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding OriginalContext}"
                       IsVisible="{Binding OriginalContext, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Classes="panel" Padding="20">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-sm" VerticalAlignment="Center" Text="Texto A"/>
                <Border Grid.Column="1" Classes="tag"><TextBlock Classes="caption secondary" Text="configuração escondida"/></Border>
              </Grid>
              <TextBlock Grid.Row="1" Margin="0,12,0,0" Classes="body" FontSize="19" LineHeight="30" TextWrapping="Wrap" Text="{Binding TextA}"/>
              <TextBlock Grid.Row="2" Margin="0,12,0,0" Classes="caption secondary" Text="{Binding FitA}" IsVisible="{Binding FitA, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button Grid.Row="4" Margin="0,14,0,0" Classes="lg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="A é melhor" Command="{Binding ChooseFirstCommand}"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="panel" Padding="20">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-sm" VerticalAlignment="Center" Text="Texto B"/>
                <Border Grid.Column="1" Classes="tag"><TextBlock Classes="caption secondary" Text="configuração escondida"/></Border>
              </Grid>
              <TextBlock Grid.Row="1" Margin="0,12,0,0" Classes="body" FontSize="19" LineHeight="30" TextWrapping="Wrap" Text="{Binding TextB}"/>
              <TextBlock Grid.Row="2" Margin="0,12,0,0" Classes="caption secondary" Text="{Binding FitB}" IsVisible="{Binding FitB, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Button Grid.Row="4" Margin="0,14,0,0" Classes="lg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="B é melhor" Command="{Binding ChooseSecondCommand}"/>
            </Grid>
          </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="lg" Content="Empate" Command="{Binding ChooseTieCommand}"/>
          <Button Classes="lg subtle" Foreground="{DynamicResource Vnf.TextSecondary}" Content="Nenhum dos dois" Command="{Binding ChooseNeitherCommand}"/>
          <Button Classes="lg subtle" Foreground="{DynamicResource Vnf.TextSecondary}" Command="{Binding SkipPairCommand}" AutomationProperties.Name="Pular par">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}"/>
              <TextBlock Text="Pular par"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      </Grid>
    </StackPanel>

    <!-- Rodar o banco de provas: o custo aparece antes de rodar, com o que já foi gasto no projeto, como na janela Traduzir com IA. -->
    <c:ScreenDialog Title="Rodar o banco de provas" IsOpen="{Binding IsRunOpen, Mode=TwoWay}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ScrollViewer.Styles>
      <!-- Caixa de seleção quadrada (18 px, canto de 5 px) das configurações a rodar e do juiz: contorno em stroke-control, cheia de accent quando marcada.
           O cartão do diálogo vive na OverlayLayer, fora da árvore da página: o estilo precisa estar dentro dele. -->
      <Style Selector="CheckBox.square">
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Vnf.StrokeControl}" VerticalAlignment="Center">
                  <PathIcon Name="Tick" Width="12" Height="12" Data="{StaticResource Icon.Checkmark}" Foreground="{DynamicResource Vnf.OnAccent}" IsVisible="False"/>
                </Border>
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="CheckBox.square:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource Vnf.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Vnf.Accent}"/>
      </Style>
      <Style Selector="CheckBox.square:checked /template/ PathIcon#Tick">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="CheckBox.square:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource Vnf.TextSecondary}"/>
      </Style>
      <Style Selector="CheckBox.square:checked:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource Vnf.AccentHover}"/>
        <Setter Property="Background" Value="{DynamicResource Vnf.AccentHover}"/>
      </Style>
      <Style Selector="CheckBox.square:focus-visible /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource Vnf.FocusRing}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Style>
      <Style Selector="CheckBox.square:disabled /template/ Border#Box">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
      </ScrollViewer.Styles>
        <StackPanel Spacing="16" AutomationProperties.Name="Rodar o banco de provas">
          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding RunIntro}"/>

          <c:Skeleton Rows="5" IsVisible="{Binding IsEstimating}" AutomationProperties.Name="Estimando o custo"/>

          <Border Classes="divider-top">
            <ItemsControl ItemsSource="{Binding RunItems}" AutomationProperties.Name="Configurações a rodar">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EvalRunItemViewModel">
                  <Border Classes="divider-bottom" Padding="0,10">
                    <Grid ColumnDefinitions="Auto,28,*,Auto" ColumnSpacing="8">
                      <CheckBox Classes="square" Padding="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Letter, StringFormat='Rodar a configuração {0}'}"/>
                      <TextBlock Grid.Column="1" Classes="body" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Letter}"/>
                      <StackPanel Grid.Column="2" Spacing="0">
                        <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Classes="caption secondary" Text="{Binding Detail}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="3" Classes="body-sm secondary" VerticalAlignment="Center" Text="{Binding CostText}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Border Padding="16,14" Background="{DynamicResource Vnf.BgInset}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="1"
                  CornerRadius="{DynamicResource Vnf.RadiusMd}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="{Binding RunCostText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding RunSpentText}" VerticalAlignment="Center"/>
              </Grid>
              <c:BudgetBar Spent="{Binding SpentBrl}" Ask="{Binding AskBrl}" Limit="{Binding LimitBrl}" ShowLimit="False"
                           TrackBrush="{DynamicResource Vnf.BgInset}" AskBrush="{DynamicResource Vnf.SegTranslated}"
                           AutomationProperties.Name="Gasto do projeto, este pedido e o limite"/>
              <CheckBox Classes="square" Margin="0,9,0,0" IsChecked="{Binding UseJudge, Mode=TwoWay}" Content="Juiz de IA cego, uma nota por texto"
                        AutomationProperties.Name="Juiz de IA cego, uma nota por texto"/>
            </StackPanel>
          </Border>

          <Border Classes="infobar error" IsVisible="{Binding RunError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
              <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding RunError}"/>
            </Grid>
          </Border>
          <Border Classes="infobar warning" IsVisible="{Binding IsOverLimit}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
              <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding OverLimitText}"/>
            </Grid>
          </Border>
          <Border Classes="infobar warning" IsVisible="{Binding AboveWarning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
              <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap"
                         Text="Este pedido custa mais que o valor de aviso que você definiu em Ajustes. Confira o valor antes de seguir."/>
            </Grid>
          </Border>
          <Border Classes="infobar error" IsVisible="{Binding KeyMissing}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
              <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding KeyMissingText}"/>
              <Button Grid.Column="2" Classes="sm" Command="{Binding OpenSettingsCommand}" Content="Abrir Ajustes" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <c:ScreenDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CloseRunDialogCommand}"/>
          <Button Classes="accent" Command="{Binding StartRunCommand}" AutomationProperties.Name="{Binding RunLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
              <TextBlock Text="{Binding RunLabel}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </c:ScreenDialog.Footer>
    </c:ScreenDialog>
  </Panel>
</UserControl>
