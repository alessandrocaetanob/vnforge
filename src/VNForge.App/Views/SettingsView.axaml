<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Resources>
    <StreamGeometry x:Key="Icon.Key">M15 6C15 6.55228 14.5523 7 14 7C13.4477 7 13 6.55228 13 6C13 5.44772 13.4477 5 14 5C14.5523 5 15 5.44772 15 6ZM12.5 2C9.42386 2 7 4.42386 7 7.5C7 7.89668 7.04001 8.29598 7.12154 8.67456C7.17968 8.94454 7.11378 9.17912 6.98018 9.31271L2.43934 13.8536C2.15804 14.1349 2 14.5164 2 14.9142V16.5C2 17.3284 2.67157 18 3.5 18H5.5C6.32843 18 7 17.3284 7 16.5V16H8C8.55228 16 9 15.5523 9 15V14H10C10.5523 14 11 13.5523 11 13V12.8199C11.4935 12.9536 12.0069 13 12.5 13C15.5761 13 18 10.5761 18 7.5C18 4.42386 15.5761 2 12.5 2ZM8 7.5C8 4.97614 9.97614 3 12.5 3C15.0239 3 17 4.97614 17 7.5C17 10.0239 15.0239 12 12.5 12C11.8408 12 11.2274 11.9047 10.7236 11.6528C10.5686 11.5753 10.3845 11.5836 10.2371 11.6747C10.0897 11.7658 10 11.9267 10 12.1V13H9C8.44772 13 8 13.4477 8 14V15H7C6.44772 15 6 15.4477 6 16V16.5C6 16.7761 5.77614 17 5.5 17H3.5C3.22386 17 3 16.7761 3 16.5V14.9142C3 14.7816 3.05268 14.6544 3.14645 14.5607L7.68729 10.0198C8.11942 9.58768 8.20942 8.97619 8.09913 8.46404C8.03354 8.15949 8 7.83105 8 7.5Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- A faixa das abas ganha a linha de baixo em toda a largura (artboard de Ajustes); o resto do estilo vem de Themes/Controls/Segmented.axaml. -->
    <Style Selector="TabControl.tabs">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
              <ItemsPresenter Name="PART_ItemsPresenter">
                <ItemsPresenter.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsPresenter.ItemsPanel>
              </ItemsPresenter>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="960" Margin="24,16,24,32" Spacing="16">

      <StackPanel Spacing="2">
        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                   Text="Valem para este projeto e ficam em vnforge.json; a chave da API fica no seu perfil do Windows."/>
        <TextBlock Classes="title-lg" Text="Ajustes"/>
      </StackPanel>

      <Border Classes="infobar" IsVisible="{Binding !HasProject}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Info}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap"
                     Text="Abra um projeto no Início para editar o modelo, o esforço, o guia de estilo, a formatação e a acentuação. A chave e as chamadas em paralelo valem para o seu usuário."/>
        </Grid>
      </Border>
      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <TabControl Classes="tabs" SelectedIndex="{Binding SelectedTab}" AutomationProperties.Name="Seções de ajustes">

        <!-- IA e gasto -->
        <TabItem Header="IA e gasto">
          <StackPanel Margin="0,16,0,0" Spacing="20">

            <!-- Cartão da chave: estado, Trocar chave e Testar conexão. A chave nunca aparece depois de guardada. -->
            <Border Classes="panel" Padding="16,14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                  <PathIcon Width="20" Height="20" Data="{StaticResource Icon.Key}" Foreground="{DynamicResource Vnf.TextSecondary}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="body" Text="Chave do Claude"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding KeyDetail}"
                               Foreground="{DynamicResource Vnf.SignalWarningFg}" IsVisible="{Binding !KeyConfigured}"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding KeyDetail}"
                               Foreground="{DynamicResource Vnf.StatusApprovedFg}" IsVisible="{Binding KeyConfigured}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="sm" Content="{Binding ChangeKeyLabel}" Command="{Binding ChangeKeyCommand}"/>
                  <Button Grid.Column="3" Classes="subtle sm" Content="{Binding TestConnectionLabel}" Command="{Binding TestConnectionCommand}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsChangingKey}">
                  <TextBox PasswordChar="●" Text="{Binding NewApiKey}" PlaceholderText="Cole a chave nova aqui"
                           AutomationProperties.Name="Chave da API nova"/>
                  <Button Grid.Column="1" Classes="accent" Content="Guardar chave" Command="{Binding SaveKeyCommand}"/>
                  <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelChangeKeyCommand}"/>
                  <Button Grid.Column="3" Classes="danger" Content="Apagar chave" Command="{Binding ClearKeyCommand}" IsVisible="{Binding KeyConfigured}"/>
                </Grid>

                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding KeyMessage}"
                           IsVisible="{Binding KeyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding ConnectionMessage}"
                           Foreground="{DynamicResource Vnf.StatusApprovedFg}" IsVisible="{Binding ConnectionOk}"/>
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding ConnectionMessage}"
                           Foreground="{DynamicResource Vnf.SignalErrorFg}" IsVisible="{Binding ConnectionFailed}"/>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap" IsVisible="{Binding IsChangingKey}"
                           Text="A chave fica guardada no cofre do Windows, só no seu usuário. Uma variável de ambiente, se existir, tem prioridade."/>
              </StackPanel>
            </Border>

            <!-- Orçamento: a cotação é informada pela pessoa (o app não consulta a internet); o limite para a IA e o app pergunta acima do aviso. -->
            <StackPanel Spacing="8">
              <TextBlock Classes="overline" Text="Orçamento"/>
              <Border Classes="panel" Padding="16,14">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="body-sm" Text="Cotação do dólar"/>
                      <TextBox Text="{Binding ExchangeRateText, UpdateSourceTrigger=LostFocus}" PlaceholderText="5,40" AutomationProperties.Name="Cotação do dólar em reais">
                        <TextBox.InnerLeftContent>
                          <TextBlock Classes="secondary" Text="R$" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </TextBox.InnerLeftContent>
                      </TextBox>
                      <StackPanel Spacing="2" IsVisible="{Binding RateError, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding RateNote}"/>
                        <Button Classes="subtle sm" HorizontalAlignment="Left" Content="Confirmar hoje" Command="{Binding ConfirmRateTodayCommand}"
                                IsVisible="{Binding HasInformedRate}" AutomationProperties.Name="Confirmar a cotação de hoje"/>
                      </StackPanel>
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RateError}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                                 IsVisible="{Binding RateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="body-sm" Text="Limite de gasto"/>
                      <TextBox Text="{Binding SpendLimitText, UpdateSourceTrigger=LostFocus}" PlaceholderText="Sem limite" AutomationProperties.Name="Limite de gasto em reais">
                        <TextBox.InnerLeftContent>
                          <TextBlock Classes="secondary" Text="R$" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </TextBox.InnerLeftContent>
                      </TextBox>
                      <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="A IA para quando o gasto do projeto chega aqui."
                                 IsVisible="{Binding LimitError, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LimitError}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                                 IsVisible="{Binding LimitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="body-sm" Text="Avisar acima de"/>
                      <TextBox Text="{Binding WarnAboveText, UpdateSourceTrigger=LostFocus}" PlaceholderText="Nunca" AutomationProperties.Name="Avisar acima de, em reais">
                        <TextBox.InnerLeftContent>
                          <TextBlock Classes="secondary" Text="R$" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </TextBox.InnerLeftContent>
                      </TextBox>
                      <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="O app pergunta antes de um pedido que custa mais que isto."
                                 IsVisible="{Binding WarnError, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding WarnError}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                                 IsVisible="{Binding WarnError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding HasProject}">
                    <c:BudgetBar Spent="{Binding SpentBrl}" Limit="{Binding LimitBrl}" AutomationProperties.Name="Gasto do projeto contra o limite"/>
                    <TextBlock Classes="caption secondary" Text="{Binding SpentSummary}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Qualidade padrão: o preço e o tempo valem para as linhas que faltam no projeto aberto; o modelo exato fica em "Detalhes técnicos". -->
            <StackPanel Spacing="8">
              <TextBlock Classes="overline" Text="Qualidade padrão"/>
              <ItemsControl ItemsSource="{Binding Qualities}" Margin="0,0,-8,0" AutomationProperties.Name="Qualidade padrão">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityOption">
                    <c:QualityCard GroupName="DefaultQuality" Margin="0,0,8,0" Title="{Binding Title}" Description="{Binding Description}"
                                   Price="{Binding Price}" Duration="{Binding Duration}" ShowPrice="{Binding HasEstimate}" ExampleRate="{Binding ExampleRate}"
                                   IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <c:TechnicalDetails>
              <StackPanel Spacing="20" Margin="0,8,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="overline" Text="Chave"/>
                  <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding KeyTechnicalNote}"/>
                  <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding ConnectionDetail}"
                             IsVisible="{Binding ConnectionDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Classes="overline" Text="Provedor"/>
                <ItemsControl ItemsSource="{Binding Providers}" AutomationProperties.Name="Provedores de IA">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderOption">
                      <Panel>
                        <!-- Provedor disponível: pílula verde como o selo "Aprovada". -->
                        <Border Height="20" Padding="8,0" CornerRadius="{DynamicResource Vnf.RadiusPill}" IsVisible="{Binding IsAvailable}"
                                Background="{DynamicResource Vnf.StatusApprovedBg}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Vnf.StatusApprovedFg}"/>
                        </Border>
                        <!-- Provedor que ainda não existe: contorno tracejado. -->
                        <Panel Height="28" IsVisible="{Binding !IsAvailable}">
                          <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="3,3"
                                     Stroke="{DynamicResource Vnf.StrokeControl}"/>
                          <TextBlock Text="{Binding Label}" Margin="10,0" FontSize="13" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Vnf.TextSecondary}"/>
                        </Panel>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8" IsEnabled="{Binding HasProject}">
                <TextBlock Classes="overline" Text="Modelo"/>
                <ItemsControl ItemsSource="{Binding Models}" AutomationProperties.Name="Modelo">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelOption">
                      <RadioButton Classes="option" Margin="0,0,0,8" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Name}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                          <TextBlock Classes="body-strong" Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Classes="mono secondary" Text="{Binding Price}"/>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Detail}"/>
                        </Grid>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <WrapPanel ItemSpacing="24" LineSpacing="16">
                <StackPanel Spacing="8" IsEnabled="{Binding HasProject}">
                  <TextBlock Classes="overline" Text="Esforço"/>
                  <ListBox Classes="seg" ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort}"
                           AutomationProperties.Name="Esforço" DisplayMemberBinding="{Binding Label}"/>
                </StackPanel>
                <StackPanel Spacing="8" IsEnabled="{Binding HasProject}">
                  <TextBlock Classes="overline" Text="Linhas por lote"/>
                  <NumericUpDown Width="112" Value="{Binding BatchSize}" Minimum="{Binding MinBatchSize}" Maximum="{Binding MaxBatchSize}"
                                 FormatString="0" AutomationProperties.Name="Linhas por lote"/>
                </StackPanel>
                <StackPanel Spacing="8">
                  <TextBlock Classes="overline" Text="Chamadas em paralelo"/>
                  <NumericUpDown Width="112" Value="{Binding Concurrency}" Minimum="{Binding MinConcurrency}" Maximum="{Binding MaxConcurrency}"
                                 FormatString="0" AutomationProperties.Name="Chamadas em paralelo"/>
                </StackPanel>
              </WrapPanel>

              <Border Classes="infobar">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Info}"/>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="body-strong" TextWrapping="Wrap" Text="Prompt de sistema e glossário vão em cache."/>
                    <TextBlock Classes="body-sm" TextWrapping="Wrap"
                               Text="Eles se repetem em todo lote; linhas já traduzidas não são enviadas de novo (cache por hash)."/>
                  </StackPanel>
                </Grid>
              </Border>

              </StackPanel>
            </c:TechnicalDetails>
          </StackPanel>
        </TabItem>

        <!-- Estilo: como a tradução deve soar; vai em todo pedido à IA e a Conferência confere. -->
        <TabItem Header="Estilo">
          <StackPanel Margin="0,16,0,0" Spacing="20" IsEnabled="{Binding HasProject}">
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Como a tradução deve soar. A IA recebe estas regras em todo pedido e a Conferência avisa quando uma linha foge delas."/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="overline" Text="Honoríficos (-san, -kun, -chan, senpai)"/>
                <ItemsControl ItemsSource="{Binding Style.Honorifics}" AutomationProperties.Name="Honoríficos">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StyleOption">
                      <RadioButton Classes="option" Margin="0,0,0,8" GroupName="Honorificos" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Name}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                          <TextBlock Classes="body-strong" Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding Sample}"/>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                        </Grid>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="overline" Text="Como os personagens se tratam"/>
                <ItemsControl ItemsSource="{Binding Style.Addresses}" AutomationProperties.Name="Tratamento">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StyleOption">
                      <RadioButton Classes="option" Margin="0,0,0,8" GroupName="Tratamento" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Name}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                          <TextBlock Classes="body-strong" Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding Sample}"/>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                        </Grid>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="panel">
                  <StackPanel>
                    <c:ToggleRule Title="Traduzir onomatopeias" Description="ドキドキ vira “tum-tum”; desligado, fica como soa em japonês (doki doki)"
                                  IsChecked="{Binding Style.TranslateOnomatopoeia}"/>
                    <c:ToggleRule Title="Nomes na ordem ocidental" Description="Misaki Sakura em vez de Sakura Misaki"
                                  IsChecked="{Binding Style.WesternNameOrder}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="overline" Text="Narrador"/>
                <Border Classes="panel" Padding="16,12">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                    <TextBlock Classes="body-sm secondary" VerticalAlignment="Center" Text="Quem narra"/>
                    <TextBox Grid.Column="1" Text="{Binding Style.NarratorWho}" PlaceholderText="Kenta (protagonista)" AutomationProperties.Name="Quem narra"/>
                    <TextBlock Grid.Row="1" Classes="body-sm secondary" VerticalAlignment="Center" Text="Pessoa"/>
                    <ListBox Grid.Row="1" Grid.Column="1" Classes="seg" HorizontalAlignment="Left" ItemsSource="{Binding Style.NarratorPersons}"
                             SelectedItem="{Binding Style.SelectedNarratorPerson}" DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Pessoa do narrador"/>
                    <TextBlock Grid.Row="2" Classes="body-sm secondary" VerticalAlignment="Center" Text="Gênero"/>
                    <ListBox Grid.Row="2" Grid.Column="1" Classes="seg" HorizontalAlignment="Left" ItemsSource="{Binding Style.NarratorGenders}"
                             SelectedItem="{Binding Style.SelectedNarratorGender}" DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Gênero do narrador"/>
                  </Grid>
                </Border>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                           Text="Em japonês o narrador raramente marca gênero; em português, “cansado” e “cansada” marcam. Esta escolha evita a maior parte dos erros de concordância."/>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="overline" Text="Guia de estilo"/>
                <TextBox Text="{Binding StyleGuide}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="132" MaxHeight="280"
                         PlaceholderText="Tom, gírias, piadas, pratos e lugares que ficam em japonês…" AutomationProperties.Name="Guia de estilo"/>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                           Text="Texto livre; a IA recebe como está. Fica no arquivo style.md da pasta do projeto."/>
              </StackPanel>
            </Grid>

            <Border Classes="panel" ClipToBounds="True">
              <StackPanel>
                <Grid Height="48" ColumnDefinitions="*,Auto" Margin="16,0">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Exemplo com estas regras"/>
                  <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{x:Static vm:StyleSettingsViewModel.ExampleWhere}"/>
                </Grid>
                <Border Classes="divider-top" Padding="16">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="overline" Text="Original"/>
                      <Border Name="StyleExampleSource" Padding="12,10" CornerRadius="4" Background="{DynamicResource Vnf.BgInset}">
                        <TextBlock TextWrapping="Wrap" Text="{x:Static vm:StyleSettingsViewModel.ExampleSource}" AutomationProperties.Name="Fala do exemplo, no original"/>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBlock Classes="overline" Text="Como a IA vai traduzir"/>
                      <Border Name="StyleExampleTarget" Padding="12,10" CornerRadius="4" Background="{DynamicResource Vnf.BgInset}"
                              BorderBrush="{DynamicResource Vnf.Accent}" BorderThickness="1">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Style.ExampleTranslation}" AutomationProperties.Name="Fala do exemplo, traduzida com as escolhas"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <!-- Formatação -->
        <TabItem Header="Formatação">
          <Grid Margin="0,16,0,0" ColumnDefinitions="*,320" ColumnSpacing="12" IsEnabled="{Binding HasProject}">
            <Border Classes="panel" ClipToBounds="True" VerticalAlignment="Top">
              <StackPanel>
                <Grid Height="48" ColumnDefinitions="*,Auto" Margin="16,0">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Regras"/>
                  <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="formatting.json"/>
                </Grid>
                <Border Classes="divider-top">
                  <StackPanel>
                    <c:ToggleRule Title="Compor letra e acento (NFC)" Description="“a” e “´” soltos viram “á”, um só caractere" IsChecked="{Binding Nfc}"/>
                    <c:ToggleRule Title="Remover espaços invisíveis" Description="Tira espaço de largura zero e marcas ocultas coladas no texto" IsChecked="{Binding InvisibleSpaces}"/>
                    <c:ToggleRule Title="Trocar espaço sem quebra por espaço comum" Description="U+00A0 vira um espaço normal" IsChecked="{Binding Nbsp}"/>
                    <c:ToggleRule Title="Juntar espaços duplos" Description="Dois ou mais espaços viram um" IsChecked="{Binding CollapseSpaces}"/>
                    <c:ToggleRule Title="Remover espaço antes de pontuação" Description="“anda !” vira “anda!” em ? ! : ;" IsChecked="{Binding SpaceBeforePunctuation}"/>
                    <c:ToggleRule Title="Inserir espaço depois da pontuação" Description="“Oi,tudo” vira “Oi, tudo”" IsChecked="{Binding SpaceAfterPunctuation}"/>

                    <Border BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="16,12" MinHeight="64">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Classes="body" Text="Aspas curvas"/>
                          <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="Mantém, troca por aspas retas (CP1252 não tem « ») ou por 「 」"/>
                        </StackPanel>
                        <ListBox Grid.Column="1" Classes="seg" ItemsSource="{Binding QuoteStyles}" SelectedItem="{Binding SelectedQuotes}"
                                 VerticalAlignment="Center" AutomationProperties.Name="Aspas curvas" DisplayMemberBinding="{Binding Label}"/>
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1" Padding="16,12" MinHeight="64">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Classes="body" Text="Reticências"/>
                          <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="“…” ocupa 1 coluna; “...” ocupa 3"/>
                        </StackPanel>
                        <ListBox Grid.Column="1" Classes="seg" ItemsSource="{Binding EllipsisStyles}" SelectedItem="{Binding SelectedEllipsis}"
                                 VerticalAlignment="Center" AutomationProperties.Name="Reticências" DisplayMemberBinding="{Binding Label}"/>
                      </Grid>
                    </Border>
                    <c:ToggleRule Title="Quebrar linha por palavra" Description="Respeita as colunas e as linhas por caixa ao lado" IsChecked="{Binding WrapEnabled}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="panel" ClipToBounds="True">
              <StackPanel>
                <Grid Height="48" Margin="16,0">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Caixa e prévia"/>
                </Grid>
                <Border Classes="divider-top" Padding="16">
                  <StackPanel Spacing="12">
                    <WrapPanel ItemSpacing="16" IsEnabled="{Binding WrapEnabled}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="overline" Text="Colunas"/>
                        <NumericUpDown Width="112" Value="{Binding WrapMaxWidth}" Minimum="1" Maximum="200" FormatString="0" AutomationProperties.Name="Colunas"/>
                      </StackPanel>
                      <StackPanel Spacing="8">
                        <TextBlock Classes="overline" Text="Linhas por caixa"/>
                        <NumericUpDown Width="112" Value="{Binding WrapMaxLines}" Minimum="1" Maximum="20" FormatString="0" AutomationProperties.Name="Linhas por caixa"/>
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Classes="overline" Text="Antes"/>
                    <TextBox Classes="mono" Text="{Binding PreviewBefore}" AcceptsReturn="False" TextWrapping="Wrap"
                             Background="{DynamicResource Vnf.BgInset}" BorderThickness="0" Padding="12,10" AutomationProperties.Name="Texto de exemplo"/>
                    <TextBlock Classes="overline" Text="Depois, no build"/>
                    <Border Padding="12,10" CornerRadius="4" Background="{DynamicResource Vnf.BgInset}"
                            BorderBrush="{DynamicResource Vnf.Accent}" BorderThickness="1">
                      <TextBlock Classes="mono" Text="{Binding PreviewAfter}" TextWrapping="Wrap" AutomationProperties.Name="Texto depois das regras"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding PreviewWarnings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="body-sm" Foreground="{DynamicResource Vnf.SignalWarningFg}" TextWrapping="Wrap" Text="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="As regras rodam no build; o texto salvo no projeto não muda."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- Acentuação -->
        <TabItem Header="Acentuação">
          <StackPanel Margin="0,16,0,0" Spacing="8" IsEnabled="{Binding HasProject}">
            <TextBlock Classes="overline" Text="Estratégia de acentuação"/>
            <ItemsControl ItemsSource="{Binding Encodings}" AutomationProperties.Name="Estratégia de acentuação">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EncodingOption">
                  <RadioButton Classes="option" Margin="0,0,0,8" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                      <TextBlock Classes="body-strong" Text="{Binding Name}"/>
                      <TextBlock Grid.Column="1" Classes="mono secondary" Text="{Binding Sample}"/>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="infobar warning" IsVisible="{Binding ShowCp1252Warning}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="body-strong" TextWrapping="Wrap" Text="Com CP1252, o caractere ï fica proibido."/>
                  <TextBlock Classes="body-sm" TextWrapping="Wrap"
                             Text="O byte 0xEF é o prefixo dos códigos de controle do YU-RIS; o QA acusa qualquer ï na tradução."/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </TabItem>

        <!-- Aparência: vale para o app todo e fica nas preferências do usuário, não no projeto. -->
        <TabItem Header="Aparência">
          <StackPanel Margin="0,16,0,0" Spacing="8">
            <TextBlock Classes="overline" Text="Tema"/>
            <ListBox Classes="seg" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                     DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Tema"/>
            <TextBlock Classes="caption secondary" Text="Sistema segue o tema do Windows."/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
