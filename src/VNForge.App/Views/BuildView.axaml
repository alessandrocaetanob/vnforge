<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:vm="using:VNForge.App.ViewModels"
             x:Class="VNForge.App.Views.BuildView"
             x:DataType="vm:BuildViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+B" Command="{Binding TestCommand}"/>
  </UserControl.KeyBindings>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" Margin="24,16,24,24" Spacing="16">

      <c:PageHeader Breadcrumb="{Binding Project.Name}" Title="Testar no jogo"/>

      <!-- O cartão principal: o estado do jogo, o botão que faz o teste inteiro e os cinco passos com o tempo de cada um.
           "Voltar ao jogo original" fica sempre à vista e neutro: não apaga a tradução, que continua no projeto. Uma tela, um botão de destaque. -->
      <c:GameStateBanner State="{Binding GameBannerState}" Title="{Binding GameBannerTitle}" Message="{Binding GameBannerMessage}"
                         AutomationProperties.Name="Estado do jogo">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding ShowErrorsCommand}" Content="Ver os erros" IsVisible="{Binding HasQaErrors}"
                  AutomationProperties.Name="Ver os erros"/>
          <Button Command="{Binding ReturnToOriginalCommand}" AutomationProperties.Name="Voltar ao jogo original"
                  ToolTip.Tip="{Binding ReturnToOriginalHint}" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Undo}"/>
              <TextBlock Text="Voltar ao jogo original"/>
            </StackPanel>
          </Button>
          <Button Classes="accent lg" Command="{Binding TestCommand}" AutomationProperties.Name="Testar no jogo">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
              <TextBlock Text="Testar no jogo" VerticalAlignment="Center"/>
              <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Text="Ctrl+B"/></Border>
            </StackPanel>
          </Button>
        </StackPanel>
        <c:GameStateBanner.Footer>
          <StackPanel Spacing="12">
            <TextBlock Classes="caption secondary" Text="{Binding TestStepsCaption}" AutomationProperties.Name="Resumo dos passos"/>
            <ItemsControl ItemsSource="{Binding LastTestSteps}" AutomationProperties.Name="Passos do último teste">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TestStepRow">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" Margin="0,0,0,2" VerticalAlignment="Top">
                    <Panel Width="20" Height="20">
                      <PathIcon Width="18" Height="18" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsDone}"/>
                      <PathIcon Width="18" Height="18" Foreground="{DynamicResource Vnf.Accent}" Data="{StaticResource Icon.ArrowSync}" IsVisible="{Binding IsRunning}"/>
                      <PathIcon Width="18" Height="18" Foreground="{DynamicResource Vnf.SignalErrorFg}" Data="{StaticResource Icon.Error}" IsVisible="{Binding IsProblem}"/>
                      <Ellipse Width="16" Height="16" StrokeThickness="1.5" Stroke="{DynamicResource Vnf.TextTertiary}" IsVisible="{Binding IsPending}"/>
                    </Panel>
                    <Border Grid.Column="1" Height="1" Margin="8,0,8,0" VerticalAlignment="Center" Background="{DynamicResource Vnf.StrokeControl}"
                            IsVisible="{Binding !IsLast}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="body-sm" TextWrapping="Wrap" Margin="0,4,8,0" Text="{Binding Label}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding TimeText}"
                               IsVisible="{Binding !IsProblem}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption" TextWrapping="Wrap" Text="{Binding TimeText}"
                               Foreground="{DynamicResource Vnf.SignalErrorFg}" IsVisible="{Binding IsProblem}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GameStateBanner.Footer>
      </c:GameStateBanner>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <SelectableTextBlock Grid.Column="1" Classes="body-sm" Loaded="Selectable_Loaded" TextWrapping="Wrap" AutomationProperties.Name="Mensagem de erro"
                               c:LineLinks.Source="{Binding ErrorMessage}" c:LineLinks.Command="{Binding OpenLineCommand}"/>
        </Grid>
      </Border>

      <Grid>
        <!-- Opções, em linguagem comum. Os acentos vêm de Ajustes. -->
        <Border Classes="panel" ClipToBounds="True" AutomationProperties.Name="Opções do teste">
          <StackPanel>
            <Border Classes="divider-bottom" Height="48" Padding="16,0">
              <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Opções"/>
            </Border>
            <c:ToggleRule Title="Só a cena aberta no editor"
                          Description="{Binding OpenSceneDescription}"
                          IsEnabled="{Binding HasOpenScene}"
                          IsChecked="{Binding OnlyOpenScene}"/>
            <c:ToggleRule Title="Testar mesmo com avisos"
                          Description="{Binding AllowWarningsDescription}"
                          IsChecked="{Binding AllowWarnings}"/>
            <Border Classes="divider-top" Padding="16,12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="body-strong" Text="Testar só os acentos"/>
                  <TextBlock Classes="body-sm secondary" TextWrapping="Wrap"
                             Text="Copia uma frase com ç, ã, é e ô para a primeira fala do jogo. Serve para conferir os acentos antes de traduzir."/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding TestAccentsCommand}" Content="Testar só os acentos"
                        VerticalAlignment="Center" AutomationProperties.Name="Testar só os acentos"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Injetar, aplicar o patch e restaurar escrevem no jogo: esperam um segundo clique, com a lista do que vai ser gravado à vista. -->
      <Border Classes="infobar warning" IsVisible="{Binding IsConfirming}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ConfirmationText}"/>
            <Button Grid.Column="2" Classes="accent" Command="{Binding ConfirmCommand}" Content="Confirmar"
                    AutomationProperties.Name="Confirmar"/>
            <Button Grid.Column="3" Command="{Binding CancelConfirmationCommand}" Content="Cancelar"
                    AutomationProperties.Name="Cancelar"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding ConfirmationFiles}" Margin="26,0,0,0" AutomationProperties.Name="Arquivos que serão alterados no jogo">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlannedChange">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,1">
                  <TextBlock Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding Kind}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Build, injeção, patch do executável, registro e cópias de segurança: o que a pessoa que só quer testar não precisa ver. -->
      <c:TechnicalDetails x:Name="Technical" Key="build" AutomationProperties.Name="Detalhes técnicos">
        <StackPanel Spacing="16" Margin="0,8,0,0">
          <!-- Erros novos de QA: o build recusaria, então "Novo build" fica travado; o build que já existe segue válido para injetar. -->
          <Border Classes="infobar warning" IsVisible="{Binding HasQaErrors}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
              <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center">
                <Run FontWeight="SemiBold" Text="{Binding QaBannerTitle, Mode=OneWay}"/>
                <Run Text="{Binding QaBannerDetail, Mode=OneWay}"/>
              </TextBlock>
              <Button Grid.Column="2" Classes="sm accent" Command="{Binding ShowErrorsCommand}" Content="Ver erros"
                      VerticalAlignment="Center" AutomationProperties.Name="Ver erros"/>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,400" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

            <StackPanel Spacing="12">
              <!-- Opções -->
              <Border Classes="panel" ClipToBounds="True" AutomationProperties.Name="Opções do build">
                <StackPanel>
                  <Border Classes="divider-bottom" Height="48" Padding="16,0">
                    <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Opções"/>
                  </Border>
                  <c:ToggleRule Title="Reconstruir só scripts alterados"
                                Description="Os demais arquivos do pacote são copiados byte a byte do original."
                                IsChecked="{Binding OnlyChanged}"/>
                  <Border Classes="divider-top" Padding="16,12">
                    <Button Command="{Binding BuildCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Novo build">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Novo build" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Patch do executável (cp1252): troca o nome da fonte das falas. Mesmo fluxo da injeção: confirmação, backup e hash conferido. -->
              <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding HasPatch}" AutomationProperties.Name="Patch do executável">
                <StackPanel>
                  <Border Classes="divider-bottom" Height="48" Padding="16,0">
                    <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Patch da fonte no executável"/>
                  </Border>
                  <StackPanel Margin="16" Spacing="12">
                    <Border Classes="infobar" Classes.success="{Binding IsPatchApplied}" Classes.warning="{Binding IsPatchRefused}"
                            AutomationProperties.Name="Estado do patch">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Data="{Binding PatchIconKey, Converter={x:Static c:IconKeyConverter.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                          <Run FontWeight="SemiBold" Text="{Binding PatchTitle, Mode=OneWay}"/>
                          <Run Text="{Binding PatchText, Mode=OneWay}"/>
                        </TextBlock>
                      </Grid>
                    </Border>
                    <Button Classes="accent" HorizontalAlignment="Left" Command="{Binding PatchCommand}"
                            Content="Aplicar patch da fonte" AutomationProperties.Name="Aplicar patch da fonte"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Resultado e ações -->
            <Border Grid.Column="1" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Resultado">
              <Grid RowDefinitions="Auto,*">
                <Border Classes="divider-bottom" Height="48" Padding="16,0">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Resultado"/>
                </Border>
                <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
                  <Border Classes="infobar" Classes.success="{Binding IsResultSuccess}" Classes.warning="{Binding IsResultWarning}"
                          AutomationProperties.Name="Estado do build">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                Data="{Binding ResultIconKey, Converter={x:Static c:IconKeyConverter.Instance}}"/>
                      <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding ResultTitle, Mode=OneWay}"/>
                        <Run Text="{Binding ResultText, Mode=OneWay}"/>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <ItemsControl Grid.Row="1" ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}" Grid.IsSharedSizeScope="True"
                                AutomationProperties.Name="Números do último build">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResultFact">
                        <Grid ColumnSpacing="16" Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Classes="body-sm secondary" Text="{Binding Label}"/>
                          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding Value}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding InjectCommand}" Content="Injetar no jogo" AutomationProperties.Name="Injetar no jogo"/>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding LaunchCommand}" AutomationProperties.Name="Abrir jogo">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
                        <TextBlock Text="Abrir jogo"/>
                      </StackPanel>
                    </Button>
                  </Grid>

                  <Button Grid.Row="3" Classes="danger" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding RestoreCommand}" AutomationProperties.Name="Restaurar originais">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Undo}"/>
                      <TextBlock Text="Restaurar originais"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Row="1" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Log do build">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" Height="48" Margin="16,0" ColumnSpacing="12">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Log"/>
                  <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="{Binding LogSummary}"/>
                  <Button Grid.Column="2" Classes="subtle sm" VerticalAlignment="Center" Click="CopyLog_Click" IsEnabled="{Binding HasLog}"
                          AutomationProperties.Name="Copiar log" ToolTip.Tip="Copia o log inteiro, com data e hora">
                    <TextBlock Text="Copiar log"/>
                  </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Vnf.BgInset}">
                  <Panel>
                    <TextBlock Classes="body-sm secondary" Margin="16,12" Text="Nada executado ainda neste projeto."
                               IsVisible="{Binding !HasLog}"/>
                    <ScrollViewer x:Name="LogScroll" MaxHeight="280" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasLog}">
                      <ItemsControl ItemsSource="{Binding Log}" Margin="16,12" AutomationProperties.Name="Linhas do log">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BuildLogLine">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <SelectableTextBlock Classes="mono secondary" LineHeight="20" FontWeight="Medium" Foreground="{DynamicResource Vnf.TextPrimary}"
                                                   Loaded="Selectable_Loaded" Text="{Binding Time}"/>
                              <SelectableTextBlock Grid.Column="1" Classes="mono secondary" LineHeight="20" Loaded="Selectable_Loaded" TextWrapping="Wrap"
                                                   c:LineLinks.Source="{Binding Message}"
                                                   c:LineLinks.Command="{Binding $parent[ItemsControl].((vm:BuildViewModel)DataContext).OpenLineCommand}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Panel>
                </Border>
              </Grid>
            </Border>

            <!-- Backups -->
            <Border Grid.Row="1" Grid.Column="1" Classes="panel" ClipToBounds="True" AutomationProperties.Name="Backups">
              <DockPanel>
                <Border DockPanel.Dock="Top" Height="48" Padding="16,0">
                  <TextBlock Classes="title-md" VerticalAlignment="Center" Text="Backups"/>
                </Border>
                <Border DockPanel.Dock="Bottom" Classes="divider-top" Height="40" Padding="16,0">
                  <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding BackupFooter}"
                             ToolTip.Tip="{Binding BackupLocation}" AutomationProperties.Name="Pasta do backup"/>
                </Border>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Margin="16,0,16,12" Text="{Binding BackupMessage}"
                           IsVisible="{Binding !HasBackups}"/>
                <TextBlock DockPanel.Dock="Bottom" Classes="caption secondary" TextWrapping="Wrap" Margin="16,8,16,12" Text="{Binding BackupMessage}"
                           IsVisible="{Binding HasRestoreProblem}" AutomationProperties.Name="Por que não dá para restaurar"/>
                <ItemsControl ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}" AutomationProperties.Name="Lista de backups">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupRow">
                      <Border Classes="divider-top" Padding="16,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                          <TextBlock Classes="mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Classes="caption secondary" Text="{Binding SizeText}"/>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Note}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </Grid>
        </StackPanel>
      </c:TechnicalDetails>
    </StackPanel>
  </ScrollViewer>
</UserControl>
