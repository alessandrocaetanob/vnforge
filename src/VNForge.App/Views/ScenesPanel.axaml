<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.ScenesPanel"
             x:DataType="vm:EditorViewModel">

  <UserControl.Styles>
    <!-- Os scripts que o filtro da lista não aceita (ou que um capítulo fechado esconde) ficam escondidos, mas continuam na lista: o script aberto não perde a seleção. -->
    <Style Selector="ListBox.scripts > ListBoxItem" x:DataType="vm:ScriptItemViewModel">
      <Setter Property="IsVisible" Value="{Binding IsListed}"/>
    </Style>
  </UserControl.Styles>

  <!-- A lista de cenas do Editor: na coluna da esquerda a partir de 1400 px, e dentro do flyout do cabeçalho abaixo disso. -->
  <Grid RowDefinitions="48,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0,8,0">
      <TextBlock Classes="title-md" Text="Cenas" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" FontSize="12" LineHeight="16" Classes="secondary" Text="{Binding ScriptsCount}" VerticalAlignment="Center"/>
      <!-- Só na coluna da grade (CanCollapse); no flyout a lista fecha sozinha ao escolher a cena. -->
      <Button x:Name="CollapseButton" Grid.Column="2" Classes="subtle sm" IsVisible="False" Margin="6,0,0,0" Width="28" Padding="0"
              Command="{Binding ToggleScenesCommand}" ToolTip.Tip="{Binding ScenesToggleTip}" AutomationProperties.Name="Recolher a lista de cenas">
        <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ChevronRight}" RenderTransform="rotate(180deg)"/>
      </Button>
    </Grid>
    <TextBox Grid.Row="1" Margin="12,0,12,8" MinHeight="28" Height="28" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
             PlaceholderText="Filtrar cenas" Text="{Binding ScriptFilter}" AutomationProperties.Name="Filtrar cenas">
      <TextBox.InnerLeftContent>
        <PathIcon Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Search}"/>
      </TextBox.InnerLeftContent>
    </TextBox>

    <!-- "Novo capítulo...": o nome do capítulo que recebe as cenas marcadas (ou a aberta). Enter cria, Esc cancela. -->
    <StackPanel Grid.Row="2">
      <StackPanel Margin="12,0,12,8" Spacing="6" IsVisible="{Binding IsNamingChapter}">
        <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding NewChapterHint}"/>
        <TextBox x:Name="ChapterNameBox" Text="{Binding NewChapterName}" PlaceholderText="Nome do capítulo" MaxLength="80" AutomationProperties.Name="Nome do capítulo novo">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CommitNewChapterCommand}"/>
            <KeyBinding Gesture="Escape" Command="{Binding CancelNewChapterCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="sm" Content="Cancelar" Command="{Binding CancelNewChapterCommand}"/>
          <Button Classes="accent sm" Content="Criar" Command="{Binding CommitNewChapterCommand}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Margin="12,0,12,8" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ChapterMessage}"
                 IsVisible="{Binding ChapterMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Cada capítulo abre com o cabeçalho (ScriptGroup) na primeira cena dele; o menu da cena move as marcadas entre capítulos (montado em ScenesPanel.axaml.cs). -->
    <ListBox Grid.Row="3" Classes="scripts" ItemsSource="{Binding SceneList}" SelectedItem="{Binding SelectedScript}"
             SelectionMode="Multiple" SelectedItems="{Binding ChosenScripts}"
             AutomationProperties.Name="Lista de cenas">
      <ListBox.ContextMenu>
        <ContextMenu Opening="OnSceneMenuOpening"/>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ScriptItemViewModel">
          <StackPanel>
            <c:ScriptGroup Margin="6,0" IsVisible="{Binding IsGroupStart}" Title="{Binding Chapter.Name}" CountText="{Binding Chapter.CountText}"
                           IsExpanded="{Binding Chapter.IsExpanded, Mode=TwoWay}"/>
            <Border Classes="scene" IsVisible="{Binding Chapter.IsExpanded}">
              <c:ScriptItem Key="{Binding Key}" Label="{Binding Name}" Percent="{Binding CompletedPercent}" IsRunning="{Binding IsRunning}"
                            ToolTip.Tip="{Binding Tooltip}"/>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Cenas sem linhas contam como prontas e ficam fora da lista; o contador diz quantas e o botão as mostra ou esconde. -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,6" IsVisible="{Binding HasEmptyScenes}">
      <TextBlock Classes="caption secondary" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding HiddenEmptyScenesText}"/>
      <Button Grid.Column="1" Classes="subtle sm" Content="{Binding ShowEmptyScenesText}" Command="{Binding ToggleEmptyScenesCommand}"/>
    </Grid>
  </Grid>
</UserControl>
