<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:core="using:VNForge.Core.Library"
             x:Class="VNForge.App.Views.GamePlayView"
             x:DataType="vm:GamePlayViewModel"
            >

  <StackPanel Spacing="16">

    <!-- Projeto sem jogo na Biblioteca: não há o que jogar nem contar. -->
    <TextBlock Name="NoPlayGame" Classes="lib-dim" TextWrapping="Wrap" IsVisible="{Binding !HasGame}" Text="{Binding NoGameMessage}"/>

    <Border Classes="sheet-card pad6" IsVisible="{Binding HasGame}">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <Border Classes="lib-icobox" Background="{DynamicResource Vnf.StatusApprovedBg}" VerticalAlignment="Center">
            <PathIcon Foreground="{DynamicResource Vnf.StatusApprovedFg}" Data="{StaticResource Icon.Play}"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Name="CardTitle" Classes="sheet-h3" FontSize="18" LineHeight="24" Text="{Binding CardTitle}"/>
            <TextBlock Name="CardDetail" Classes="lib-dim" FontSize="14" LineHeight="20" TextWrapping="Wrap" Text="{Binding CardDetail}"/>
          </StackPanel>
          <TextBlock Name="Elapsed" Grid.Column="2" Classes="mono" FontSize="30" LineHeight="36" FontWeight="Bold" VerticalAlignment="Center"
                     IsVisible="{Binding IsPlaying}" Text="{Binding ElapsedText}"/>
          <Button Name="PlayButton" Grid.Column="2" Classes="accent" VerticalAlignment="Center" IsVisible="{Binding !IsPlaying}" Command="{Binding PlayCommand}" AutomationProperties.Name="Jogar">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
              <TextBlock Text="Jogar"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="lib-hr"/>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <ToggleSwitch Name="LocaleEmulatorSwitch" Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" VerticalAlignment="Center"
                        IsChecked="{Binding LocaleEmulatorOn}" AutomationProperties.Name="Abrir pelo Locale Emulator"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="Abrir pelo Locale Emulator"/>
            <TextBlock Name="LocaleEmulatorNote" Classes="lib-dim" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="{Binding LocaleEmulatorNote}"/>
          </StackPanel>
          <Button Grid.Column="2" Classes="subtle sm" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Settings}"/>
              <TextBlock Text="Caminho nos Ajustes"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <ToggleSwitch Name="OpensLauncherSwitch" Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" VerticalAlignment="Center"
                        IsChecked="{Binding OpensLauncherOn}" AutomationProperties.Name="Abre um lançador antes do jogo"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="Abre um lançador antes do jogo"/>
            <TextBlock Classes="lib-dim" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="Ligue se o exe principal abre outra janela. O app passa a contar pelo processo do jogo."/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="sheet-card" Padding="0" IsVisible="{Binding HasGame}">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="16,17">
          <TextBlock Classes="sheet-h3" Text="Sessões" VerticalAlignment="Center"/>
          <ListBox Name="SessionsView" Grid.Column="1" Classes="seg" ItemsSource="{Binding ViewOptions}" SelectedIndex="{Binding ViewIndex}" AutomationProperties.Name="Ver as sessões por"/>
        </Grid>
        <TextBlock Name="EmptyRows" Classes="lib-dim" Margin="16,0,16,16" TextWrapping="Wrap" IsVisible="{Binding ShowsEmptyRows}" Text="{Binding EmptyRowsText}"/>
        <ItemsControl Name="Rows" ItemsSource="{Binding Rows}" AutomationProperties.Name="Sessões de jogo">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:PlaySessionRow">
              <Border BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,1,0,0" Padding="16,12,16,15">
                <Grid ColumnDefinitions="*,140,160" ColumnSpacing="12">
                  <TextBlock VerticalAlignment="Center" Text="{Binding When}"/>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Duration}"/>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="lib-dim" Text="{Binding Via}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
