<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>
    <!-- Linha das tabelas (artboard Painel, ".tr"): 36px, divisor de stroke-subtle e fundo de hover. -->
    <Style Selector="Border.tr">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.tr:pointerover">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgCardHover}"/>
    </Style>
    <Style Selector="Border.tr.h">
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="Border.tr.h:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.num.strong">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextPrimary}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" Margin="24" Spacing="20" HorizontalAlignment="Stretch">

      <c:PageHeader Breadcrumb="{Binding Breadcrumb}" Title="{Binding Title}" IsVisible="{Binding HasProject}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding OpenFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
              <TextBlock Text="Abrir pasta"/>
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding ContinueCommand}" IsVisible="{Binding CanContinue}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Edit}"/>
              <TextBlock Text="{Binding ContinueLabel}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </c:PageHeader>

      <!-- Sem projeto (ou projeto sem texto): o selo 訳, uma frase e a ação. -->
      <c:EmptyState IsVisible="{Binding ShowEmptyState}" Message="{Binding EmptyMessage}"
                    ActionText="{Binding EmptyActionText}" ActionCommand="{Binding OpenStartCommand}"/>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <c:PipelineStepper ItemsSource="{Binding Steps}" AutomationProperties.Name="Etapas do pipeline"/>

      <!-- Três cartões de número -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <c:StatCard Title="Linhas" Value="{Binding LinesLabel}" Description="{Binding LinesDescription}" AutomationProperties.Name="Linhas">
          <c:StatCard.Footer>
            <Button Classes="link" Command="{Binding OpenEditorCommand}" Content="Continuar no editor"/>
          </c:StatCard.Footer>
          <StackPanel Spacing="8">
            <c:DistributionBar Height="8" Value="{Binding Distribution}" AutomationProperties.Name="{Binding DistributionDescription}"/>
            <c:Legend Value="{Binding Distribution}"/>
          </StackPanel>
        </c:StatCard>

        <c:StatCard Grid.Column="1" Title="Uso da IA" Value="{Binding AiValue}" Description="{Binding AiDescription}" AutomationProperties.Name="Uso da IA">
          <c:StatCard.Footer>
            <Button Classes="link" Command="{Binding OpenSettingsCommand}" Content="Ajustes de IA"/>
          </c:StatCard.Footer>
          <StackPanel Spacing="8">
            <c:DistributionBar Height="8" Value="{Binding AiDistribution}" AutomationProperties.Name="{Binding AiBarDescription}"/>
            <c:Legend ItemsSource="{Binding AiLegend}"/>
          </StackPanel>
        </c:StatCard>

        <c:StatCard Grid.Column="2" Title="Conferência" Value="{Binding ConferenceValue}" Description="{Binding ConferenceDescription}" AutomationProperties.Name="Conferência">
          <c:StatCard.Footer>
            <Button Classes="link" Command="{Binding OpenConferenceCommand}" Content="Abrir a conferência"/>
          </c:StatCard.Footer>
          <StackPanel Spacing="8">
            <c:SignalBar Height="8" Errors="{Binding ConferenceErrors}" Warnings="{Binding ConferenceWarnings}" AutomationProperties.Name="{Binding ConferenceBarDescription}"/>
            <c:Legend ItemsSource="{Binding ConferenceLegend}"/>
          </StackPanel>
        </c:StatCard>
      </Grid>

      <!-- Duas tabelas -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Classes="divider-bottom" Height="48" Padding="16,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="Por script" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="caption secondary" Text="ordem do jogo" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="tr h" AutomationProperties.Name="Colunas da tabela">
              <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*" MinWidth="120" MaxWidth="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Classes="overline" Text="SCRIPT"/>
                <TextBlock Grid.Column="1" Classes="overline" Text="NOME"/>
                <TextBlock Grid.Column="2" Classes="overline" TextAlignment="Right" Text="LINHAS"/>
                <TextBlock Grid.Column="3" Classes="overline" Text="PROGRESSO"/>
                <TextBlock Grid.Column="4" Classes="overline" TextAlignment="Right" Text="%"/>
              </Grid>
            </Border>
            <c:Skeleton Grid.Row="2" Margin="16,12" Rows="6" IsVisible="{Binding ShowFilesSkeleton}" AutomationProperties.Name="Carregando o progresso por script"/>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Scripts}" AutomationProperties.Name="Progresso por script" VerticalAlignment="Top">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScriptRowViewModel">
                  <Border Classes="tr">
                    <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*" MinWidth="120" MaxWidth="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <TextBlock Classes="mono" Text="{Binding Key}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Classes="num" Text="{Binding LinesLabel}" VerticalAlignment="Center"/>
                      <c:DistributionBar Grid.Column="3" Height="6" Value="{Binding Distribution}" VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding DistributionDescription}"/>
                      <TextBlock Grid.Column="4" Classes="num strong" Text="{Binding PercentLabel}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Height="40" Margin="16,0" VerticalAlignment="Bottom">
              <TextBlock Classes="caption secondary" Text="{Binding ScriptsFooter}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="link" Command="{Binding OpenEditorCommand}" Content="Ver todos no editor" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Classes="divider-bottom" Height="48" Padding="16,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="Por personagem" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="caption secondary" Text="por número de linhas" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="tr h" AutomationProperties.Name="Colunas da tabela">
              <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*" MinWidth="120" MaxWidth="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Classes="overline" Text="PERSONAGEM"/>
                <TextBlock Grid.Column="1" Classes="overline" TextAlignment="Right" Text="LINHAS"/>
                <TextBlock Grid.Column="2" Classes="overline" Text="PROGRESSO"/>
                <TextBlock Grid.Column="3" Classes="overline" TextAlignment="Right" Text="%"/>
              </Grid>
            </Border>
            <c:Skeleton Grid.Row="2" Margin="16,12" Rows="6" IsVisible="{Binding ShowCharactersSkeleton}" AutomationProperties.Name="Carregando o progresso por personagem"/>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Characters}" AutomationProperties.Name="Progresso por personagem" VerticalAlignment="Top">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterRowViewModel">
                  <Border Classes="tr">
                    <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*" MinWidth="120" MaxWidth="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Classes="jp-body" FontSize="13" Text="{Binding Source}" IsVisible="{Binding HasSource}" VerticalAlignment="Center"/>
                        <TextBlock Classes="body-sm secondary" Text="→" IsVisible="{Binding HasSource}" VerticalAlignment="Center"/>
                        <TextBlock Classes="body-sm" Classes.secondary="{Binding IsNarration}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="num" Text="{Binding LinesLabel}" VerticalAlignment="Center"/>
                      <c:DistributionBar Grid.Column="2" Height="6" Value="{Binding Distribution}" VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding DistributionDescription}"/>
                      <TextBlock Grid.Column="3" Classes="num strong" Text="{Binding PercentLabel}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Height="40" Margin="16,0" VerticalAlignment="Bottom">
              <TextBlock Classes="caption secondary" Text="{Binding CharactersFooter}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="link" Command="{Binding OpenGlossaryCommand}" Content="Editar nomes" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Legenda de progresso -->
      <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
        <TextBlock Classes="caption secondary" Text="Progresso:" VerticalAlignment="Center"/>
        <c:Legend>
          <c:LegendItem Tone="Approved" Content="Aprovadas"/>
          <c:LegendItem Tone="Reviewed" Content="Revisadas"/>
          <c:LegendItem Tone="Machine" Content="IA"/>
          <c:LegendItem Tone="Pending" Content="Pendentes"/>
        </c:Legend>
        <TextBlock Classes="caption secondary" Text="· % = aprovadas + revisadas" VerticalAlignment="Center"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
