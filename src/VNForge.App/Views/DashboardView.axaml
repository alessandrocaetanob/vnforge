<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             xmlns:v="using:VNForge.App.Views"
             x:Class="VNForge.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>
    <!-- A faixa das abas (Visão geral, Provas): a linha de baixo em toda a largura, como nos Ajustes, e 32 px de altura para o Painel continuar cabendo em 1440×900. -->
    <Style Selector="TabControl.tabs">
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.tabs > TabItem">
      <Setter Property="Height" Value="32"/>
    </Style>
    <!-- Linha de capítulo: o botão não desenha nada além do fundo de hover; quem desenha é a ChapterRow. -->
    <Style Selector="Button.chapter">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" Margin="32,10,32,4" Spacing="12" HorizontalAlignment="Stretch">

      <StackPanel IsVisible="{Binding HasProject}">

      <!-- As abas do Painel: o mapa do jogo e o banco de provas (#529). O Painel é a primeira seção da aba Tradução do jogo (#544). -->
      <TabControl Classes="tabs" Margin="0,0,0,-6" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" IsVisible="{Binding !ShowEmptyState}" AutomationProperties.Name="Seções do Painel">
        <TabItem Header="Visão geral"/>
        <TabItem Header="Provas"/>
      </TabControl>
      </StackPanel>

      <!-- Sem projeto (ou projeto sem texto): o selo 訳, uma frase e a ação. -->
      <c:EmptyState IsVisible="{Binding ShowEmptyState}" Message="{Binding EmptyMessage}"
                    ActionText="{Binding EmptyActionText}" ActionCommand="{Binding OpenStartCommand}"/>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <StackPanel Spacing="16" IsVisible="{Binding ShowOverview}">
      <c:PipelineStepper ItemsSource="{Binding Steps}" IsVisible="{Binding !ShowEmptyState}" AutomationProperties.Name="Etapas da tradução"/>

      <Grid x:Name="Body" ColumnDefinitions="*,440" RowDefinitions="Auto" ColumnSpacing="20" RowSpacing="16" IsVisible="{Binding !ShowEmptyState}">

        <!-- O mapa do jogo: o anel do jogo inteiro e uma linha por capítulo. -->
        <Border Classes="panel" Padding="20" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
              <c:ProgressRing Done="{Binding ReadyLines}" Review="{Binding ReviewLines}" Total="{Binding TotalLines}"
                              AutomationProperties.Name="{Binding MapSummary}"/>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="title-md" Text="O jogo inteiro"/>
                <TextBlock Classes="body" Text="{Binding MapSummary}"/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding PaceText}"/>
                <c:Legend ItemsSource="{Binding MapLegend}"/>
              </StackPanel>
            </Grid>

            <Border Classes="divider-bottom"/>

            <TextBlock Classes="title-md" Text="Capítulos"/>
            <c:Skeleton Rows="6" IsVisible="{Binding ShowChaptersSkeleton}" AutomationProperties.Name="Carregando os capítulos"/>
            <ItemsControl ItemsSource="{Binding Chapters}" AutomationProperties.Name="Capítulos do jogo">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChapterRowViewModel">
                  <Grid>
                    <Button Classes="subtle chapter" IsVisible="{Binding !IsEditing}"
                            Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenChapterCommand}" CommandParameter="{Binding}">
                      <Button.KeyBindings>
                        <KeyBinding Gesture="F2" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).BeginRenameChapterCommand}"
                                    CommandParameter="{Binding}"/>
                      </Button.KeyBindings>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Renomear capítulo" InputGesture="F2" IsEnabled="{Binding CanRename}"
                                    Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).BeginRenameChapterCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Novo capítulo..."
                                    Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).NewChapterCommand}"
                                    CommandParameter="{Binding}"/>
                        </ContextMenu>
                      </Button.ContextMenu>
                      <c:ChapterRow Number="{Binding Number}" Title="{Binding Name}" Done="{Binding Ready}" Review="{Binding ToReview}" Total="{Binding Total}"
                                    Note="{Binding Note}" IsHere="{Binding IsHere}" IsExtra="{Binding IsExtra}"/>
                    </Button>
                    <!-- Renomear: o nome do capítulo vira o grupo dos scripts dele; Enter confirma, Esc cancela. -->
                    <StackPanel Spacing="4" Margin="0,4" IsVisible="{Binding IsEditing}">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding EditText}" PlaceholderText="Nome do capítulo" MaxLength="80" AutomationProperties.Name="Novo nome do capítulo">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).CommitRenameChapterCommand}"
                                        CommandParameter="{Binding}"/>
                            <KeyBinding Gesture="Escape" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).CancelRenameChapterCommand}"
                                        CommandParameter="{Binding}"/>
                          </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="accent" Content="Salvar"
                                Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).CommitRenameChapterCommand}" CommandParameter="{Binding}"/>
                        <Button Grid.Column="2" Content="Cancelar"
                                Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).CancelRenameChapterCommand}" CommandParameter="{Binding}"/>
                      </Grid>
                      <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding EditError}"
                                 IsVisible="{Binding EditError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Capítulos sem linhas contam como prontos e ficam escondidos; o contador diz quantas cenas, e o botão os mostra ou esconde. -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEmptyScenes}">
              <TextBlock Classes="body-sm secondary" VerticalAlignment="Center" Text="{Binding HiddenEmptyScenesText}"/>
              <Button Grid.Column="1" Classes="subtle sm" Content="{Binding ShowEmptyScenesText}" Command="{Binding ToggleEmptyScenesCommand}"/>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel x:Name="Side" Grid.Column="1" Spacing="12" VerticalAlignment="Top">

          <Border Classes="panel" ClipToBounds="True">
            <StackPanel>
              <Border Classes="divider-bottom" Height="48" Padding="16,0">
                <TextBlock Classes="title-md" Text="Precisa de você" VerticalAlignment="Center"/>
              </Border>
              <ItemsControl ItemsSource="{Binding Todos}" AutomationProperties.Name="O que precisa de você">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TodoRowViewModel">
                    <c:TodoItem Severity="{Binding Severity}" Title="{Binding Title}" Message="{Binding Message}"
                                ActionText="{Binding ActionText}" Command="{Binding Command}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption secondary" Margin="16,8" Text="{Binding MoreTodosText}" IsVisible="{Binding HasMoreTodos}"/>
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="Gasto com a IA" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="link" Command="{Binding OpenSettingsCommand}" Content="Ajustes" FontSize="12"/>
              </Grid>
              <TextBlock Classes="body" Text="{Binding SpentText}"/>
              <c:BudgetBar Spent="{Binding SpentBrl}" Limit="{Binding LimitBrl}" AutomationProperties.Name="{Binding SpentText}"/>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding SpendHint}"/>
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="8">
              <c:GameStateBanner State="{Binding GameState}" Title="{Binding GameTitle}" Message="{Binding GameMessage}">
                <Button Classes="sm" Command="{Binding OpenTestCommand}" Content="{Binding GameActionText}"/>
              </c:GameStateBanner>
              <v:ChangedScenesPanel DataContext="{Binding SinceTest}" IsVisible="{Binding IsInformative}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      </StackPanel>

      <StackPanel IsVisible="{Binding ShowEvalTab}">
        <v:EvalView DataContext="{Binding Eval}"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
