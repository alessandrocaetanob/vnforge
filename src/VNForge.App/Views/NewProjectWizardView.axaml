<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.NewProjectWizardView"
             x:DataType="vm:NewProjectWizardViewModel">

  <UserControl.Resources>
    <!-- Cartão de escolha única (OptionCard): nome, valor à direita e uma linha de descrição. -->
    <DataTemplate x:Key="ChoiceCard" x:DataType="vm:ChoiceOption">
      <RadioButton Classes="option" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
          <TextBlock Classes="body-strong" Foreground="{DynamicResource Vnf.TextPrimary}" Text="{Binding Title}"/>
          <TextBlock Grid.Column="1" Classes="mono-xs secondary" Text="{Binding Value}" VerticalAlignment="Center"
                     IsVisible="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Description}"
                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
      </RadioButton>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Campo do orçamento (v3-input do quadro): 32 de altura, fundo inset, contorno de controle e raio 8; o R$ fica 12 px da borda e 8 px do valor. -->
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0,0,12,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusSm}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.field /template/ Border#PART_BorderElement, TextBox.field:pointerover /template/ Border#PART_BorderElement, TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Vnf.BgInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Vnf.StrokeControl}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.panel.card">
      <Setter Property="CornerRadius" Value="{DynamicResource Vnf.RadiusLg}"/>
    </Style>
    <Style Selector="TextBlock.pill">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="StackPanel.vndb-exits Button.subtle">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.TextSecondary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="960" Margin="24,20,24,32" Spacing="16">

      <!-- Quadro da #547: a migalha e o título de 34/40 (o title-xl tem 50 de entrelinha por causa do Zen Kaku, daí a margem negativa) e o Cancelar à direita, centrado nos dois. -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel>
          <TextBlock Classes="caption secondary" Text="{Binding Breadcrumb}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Breadcrumb, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Classes="title-xl" Margin="0,-5" Text="Novo projeto" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="subtle" VerticalAlignment="Center" Command="{Binding CancelCommand}" Content="Cancelar" IsVisible="{Binding IsWizardStep}"/>
      </Grid>

      <c:PipelineStepper Classes="wizard" ItemsSource="{Binding Steps}" IsVisible="{Binding IsWizardStep}" AutomationProperties.Name="Passos do assistente"/>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <!-- 1. Jogo: a pasta e, abaixo, o que a detecção achou -->
      <StackPanel Spacing="16" IsVisible="{Binding IsGameStep}">
        <Border Classes="panel card" Padding="20,14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Width="22" Height="22" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Folder}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
              <TextBlock Classes="body-strong" Text="Pasta do jogo"/>
              <TextBlock Classes="mono secondary" TextTrimming="CharacterEllipsis" Text="{Binding GameFolderLabel}"/>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding BrowseGameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                <TextBlock Text="{Binding BrowseGameLabel}"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Border Classes="panel card" ClipToBounds="True" IsVisible="{Binding HasDetection}" AutomationProperties.Name="Motor do jogo">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="20,16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="caption secondary" FontWeight="SemiBold" Text="Jogo reconhecido"/>
                <TextBlock Classes="title-md" LineHeight="24" Text="{Binding EngineHeadline}"/>
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Top" Margin="0,18,0,0" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                      Background="{DynamicResource Vnf.StatusApprovedBg}">
                <TextBlock Classes="pill" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="Suportado"/>
              </Border>
            </Grid>
            <Border Classes="divider-top" Padding="20,12">
              <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding FoundFacts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetectionFact">
                      <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                        <TextBlock Classes="body-sm secondary" LineHeight="20" Text="{Binding Label}"/>
                        <TextBlock Grid.Column="1" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" Text="{Binding Value}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                  <TextBlock Classes="body-sm secondary" LineHeight="20" Text="Arquivo que abre o jogo" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExe}" MinWidth="280"
                            IsVisible="{Binding HasExecutables}" AutomationProperties.Name="Arquivo que abre o jogo"/>
                  <TextBlock Grid.Column="1" FontWeight="Medium" LineHeight="20" Text="{Binding SelectedExe}" VerticalAlignment="Center" IsVisible="{Binding !HasExecutables}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Padding="20,0,20,16">
              <c:TechnicalDetails>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                    <TextBlock Classes="body-sm secondary" LineHeight="20" Text="Motor e formato"/>
                    <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding EngineTitle}"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding DetectionFacts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetectionFact">
                        <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                          <TextBlock Classes="body-sm secondary" LineHeight="20" Text="{Binding Label}"/>
                          <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Value}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </c:TechnicalDetails>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding DetectionWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding DetectionWarning}"/>
          </Grid>
        </Border>

        <TextBlock Classes="secondary" FontSize="13" LineHeight="16" TextWrapping="Wrap"
                   Text="O VNForge só lê esta pasta. Antes de mexer no jogo, ele sempre faz uma cópia de segurança."/>
      </StackPanel>

      <!-- 2. Ficha do VNDB: confirma o jogo e mostra o que chega ao projeto -->
      <StackPanel Spacing="16" IsVisible="{Binding IsVndbStep}">
        <Border Classes="panel card" Padding="16" IsVisible="{Binding !IsVndbPreview}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Width="40" Height="40" CornerRadius="{DynamicResource Vnf.RadiusMd}" Background="{DynamicResource Vnf.AccentSoft}" VerticalAlignment="Top">
                <PathIcon Width="20" Height="20" Foreground="{DynamicResource Vnf.AccentText}" Data="{StaticResource Icon.Search}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="body-strong" TextWrapping="Wrap" Text="{Binding VndbHeadline}"/>
                <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding VndbDetail}"/>
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Candidates}" IsVisible="{Binding IsVndbChoosing}" AutomationProperties.Name="Jogos achados no VNDB">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VndbCandidateItem">
                  <RadioButton Classes="option candidate" GroupName="VndbCandidates" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="18,72,*,Auto" ColumnSpacing="12">
                      <Panel Width="18" Height="18" VerticalAlignment="Top" Margin="0,4,0,0" IsHitTestVisible="False">
                        <Ellipse Classes="ring" Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1.5"/>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Vnf.Accent}" IsVisible="{Binding IsSelected}"/>
                      </Panel>
                      <Border Grid.Column="1" Width="72" Height="96" VerticalAlignment="Top" CornerRadius="12" ClipToBounds="True" BoxShadow="{DynamicResource Vnf.ShadowCover}">
                        <c:Cover Width="72" Image="{Binding Cover}" Seed="{Binding Title}"/>
                      </Border>
                      <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top" MinWidth="0">
                        <TextBlock Classes="title-md" TextWrapping="Wrap" Text="{Binding Title}"/>
                        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding OriginalTitle}" IsVisible="{Binding HasOriginalTitle}"/>
                        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Details}"/>
                      </StackPanel>
                      <Border Grid.Column="3" VerticalAlignment="Top" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                              Background="{DynamicResource Vnf.StatusApprovedBg}" IsVisible="{Binding MatchesFolder}">
                        <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding EvidenceLabel}"/>
                      </Border>
                      <Border Grid.Column="3" VerticalAlignment="Top" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                              Background="{DynamicResource Vnf.StatusPendingBg}" IsVisible="{Binding !MatchesFolder}">
                        <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.StatusPendingFg}" Text="{Binding EvidenceLabel}"/>
                      </Border>
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Classes="vndb-exits" Orientation="Horizontal" Spacing="17" Margin="4,0,0,0" IsVisible="{Binding CanSkipVndb}">
              <Button Classes="subtle" Command="{Binding SkipVndbCommand}" Content="Nenhum deles, seguir sem VNDB"/>
              <Button Classes="subtle" Command="{Binding ToggleTitleSearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Search}"/>
                  <TextBlock Text="Buscar por outro título"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowTitleSearch}">
              <TextBox Text="{Binding SearchTitle}" AutomationProperties.Name="Título para buscar no VNDB"/>
              <Button Grid.Column="1" Classes="accent" Command="{Binding SearchVndbCommand}" Content="Buscar"/>
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding IsVndbPreview}">
          <Border Classes="panel card" ClipToBounds="True" AutomationProperties.Name="Personagens que chegam">
            <StackPanel>
              <Border Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Classes="title-md" FontSize="16" LineHeight="22" Text="Personagens que chegam"/>
                    <TextBlock Classes="body-sm secondary" LineHeight="20" TextWrapping="Wrap" Text="{Binding Preview.CountText}"/>
                  </StackPanel>
                  <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}" Background="{DynamicResource Vnf.StatusApprovedBg}">
                    <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding Preview.Label}"/>
                  </Border>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="44,1.4*,1.2*,1.2*,100,1.1*" ColumnSpacing="12" Margin="16,0" Height="38">
                <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" Text="Nome original"/>
                <TextBlock Grid.Column="2" Classes="caption secondary" VerticalAlignment="Center" Text="Romaji"/>
                <TextBlock Grid.Column="3" Classes="caption secondary" VerticalAlignment="Center" Text="Apelidos"/>
                <TextBlock Grid.Column="4" Classes="caption secondary" VerticalAlignment="Center" Text="Gênero"/>
                <TextBlock Grid.Column="5" Classes="caption secondary" VerticalAlignment="Center" Text="No jogo"/>
              </Grid>
              <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Preview.Characters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VndbCharacterRow">
                      <Border Classes="divider-top" Padding="16,6" MinHeight="50">
                        <Grid VerticalAlignment="Center" ColumnDefinitions="44,1.4*,1.2*,1.2*,100,1.1*" ColumnSpacing="12">
                          <c:Portrait Size="Sm" Image="{Binding Image}" Seed="{Binding Seed}" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Classes="body-strong" TextWrapping="Wrap" Text="{Binding Display}"/>
                            <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Original}" IsVisible="{Binding HasOriginal}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Romaji}"/>
                          <TextBlock Grid.Column="3" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Aliases}"/>
                          <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                                  Background="{DynamicResource Vnf.StatusApprovedBg}" IsVisible="{Binding HasGender}">
                            <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="{Binding Gender}"/>
                          </Border>
                          <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}"
                                  Background="{DynamicResource Vnf.SignalWarningBg}" IsVisible="{Binding !HasGender}">
                            <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.SignalWarningFg}" Text="{Binding Gender}"/>
                          </Border>
                          <TextBlock Grid.Column="5" Classes="mono-xs" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding InGame}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="16">
            <Border Classes="panel card" Padding="16" AutomationProperties.Name="Sinopse para a bíblia">
              <StackPanel Spacing="8">
                <TextBlock Classes="title-md" FontSize="16" LineHeight="22" Text="Sinopse para a bíblia"/>
                <TextBlock Margin="0,4,0,0" FontSize="14.4" LineHeight="20" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Text="{Binding Preview.Synopsis}"/>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Preview.SynopsisNote}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="Preview.HasSynopsis"/>
                      <Binding Path="!Preview.IsSynopsisTranslated"/>
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <Border Margin="0,5,0,0" HorizontalAlignment="Left" Padding="8,1" CornerRadius="{DynamicResource Vnf.RadiusPill}" Background="{DynamicResource Vnf.StatusAiBg}"
                        IsVisible="{Binding Preview.IsSynopsisTranslated}">
                  <TextBlock Classes="caption" FontSize="11" LineHeight="18" Foreground="{DynamicResource Vnf.StatusAiFg}"
                             Text="Traduzida pela IA, você revisa depois"/>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="panel card" Padding="16" AutomationProperties.Name="Aviso que some">
              <StackPanel Spacing="8">
                <TextBlock Classes="title-md" FontSize="16" LineHeight="22" Text="Aviso que some"/>
                <TextBlock Margin="0,4,0,0" Classes="body-sm secondary" FontSize="12" LineHeight="20" TextWrapping="Wrap" Text="{Binding Preview.GenderNote}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- 3. Idiomas e nome -->
      <StackPanel Spacing="20" IsVisible="{Binding IsNamesStep}">
        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Nome do projeto"/>
          <TextBox Text="{Binding ProjectName}" AutomationProperties.Name="Nome do projeto"/>
        </StackPanel>
        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Pasta do projeto"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="mono secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ProjectDirectoryLabel}"/>
            <Button Grid.Column="1" Command="{Binding BrowseProjectCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                <TextBlock Text="Escolher pasta"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Classes="caption secondary" Text="Fora da pasta do jogo. Texto, cache e backups ficam aqui."/>
        </StackPanel>
        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Idioma do jogo"/>
          <ItemsControl ItemsSource="{Binding SourceLanguages.Options}" ItemTemplate="{StaticResource ChoiceCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="200"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="8">
          <c:OverlineText Classes="overline" Text="Idioma da tradução"/>
          <ItemsControl ItemsSource="{Binding TargetLanguages.Options}" ItemTemplate="{StaticResource ChoiceCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="240"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- 3. Acentuação -->
      <StackPanel Spacing="16" IsVisible="{Binding IsAccentsStep}">
        <TextBlock Classes="secondary" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="630" HorizontalAlignment="Left"
                   Text="O jogo foi feito para o japonês e não desenha as letras acentuadas do português por conta própria. Cada cartão mostra a frase de teste na caixa de texto do jogo do jeito que vai sair. Dá para trocar depois nos Ajustes."/>
        <c:OverlineText Classes="overline" Text="Como ficam os acentos"/>
        <c:AccentCards Options="{Binding EncodingStrategies.Options}" GroupName="WizardAccents" AutomationProperties.Name="Como ficam os acentos"/>
      </StackPanel>

      <!-- 4. IA -->
      <StackPanel Spacing="16" IsVisible="{Binding IsAiStep}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="8">
            <c:OverlineText Classes="overline" Text="Qualidade da tradução"/>
            <TextBlock Classes="secondary" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="630" HorizontalAlignment="Left" Text="{Binding EstimateNote}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Qualities}" Margin="0,0,-12,0" AutomationProperties.Name="Qualidade da tradução">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QualityOption">
                <c:QualityCard GroupName="WizardQuality" Margin="0,0,12,0" Title="{Binding Title}" Description="{Binding Description}"
                               Price="{Binding Price}" Duration="{Binding Duration}" ShowPrice="{Binding HasEstimate}" ExampleRate="{Binding ExampleRate}"
                               IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Orçamento: a cotação é informada pela pessoa (o app não consulta a internet) e o limite para a IA de gastar. -->
        <StackPanel Spacing="16">
          <c:OverlineText Classes="overline" Text="Orçamento"/>
          <Border Classes="panel card" Padding="20,16">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
              <StackPanel Spacing="4">
                <TextBlock Classes="body-strong" Text="Cotação do dólar"/>
                <TextBox Classes="field" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="5,40" AutomationProperties.Name="Cotação do dólar em reais">
                  <TextBox.InnerLeftContent>
                    <TextBlock Classes="secondary" Text="R$" Margin="12,0,8,0" VerticalAlignment="Center"/>
                  </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding RateNote}"
                           IsVisible="{Binding RateError, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RateError}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                           IsVisible="{Binding RateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="body-strong" Text="Limite de gasto"/>
                <TextBox Classes="field" Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Sem limite" AutomationProperties.Name="Limite de gasto em reais">
                  <TextBox.InnerLeftContent>
                    <TextBlock Classes="secondary" Text="R$" Margin="12,0,8,0" VerticalAlignment="Center"/>
                  </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="A IA para quando o gasto do projeto chega aqui. Vale para todos os seus projetos."
                           IsVisible="{Binding LimitError, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LimitError}" Foreground="{DynamicResource Vnf.SignalErrorFg}"
                           IsVisible="{Binding LimitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <Border Classes="infobar banner" BorderThickness="1" BorderBrush="Transparent">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Top" Margin="0,8,0,0" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Info}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="body-strong" Text="Onde fica a chave"/>
              <TextBlock FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="{x:Static vm:NewProjectWizardViewModel.KeyNote}"/>
            </StackPanel>
          </Grid>
        </Border>

        <c:TechnicalDetails>
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <c:OverlineText Classes="overline" Text="Modelo exato"/>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                       Text="Cada qualidade usa um modelo do Claude. Aqui dá para escolher o modelo à mão; os preços são por milhão de tokens, em dólar (entrada / saída)."/>
            <ItemsControl ItemsSource="{Binding Models.Options}" ItemTemplate="{StaticResource ChoiceCard}"/>
          </StackPanel>
        </c:TechnicalDetails>
      </StackPanel>

      <!-- Fim: projeto criado, oferece extrair -->
      <StackPanel Spacing="16" IsVisible="{Binding IsDoneStep}">
        <Border Classes="infobar success">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Check}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="body-strong" Text="Projeto criado."/>
              <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding CreatedSummary}"/>
              <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding PersonalNotice}" IsVisible="{Binding HasPersonalNotice}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="panel card" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="title-md" Text="Extrair o texto do jogo agora?"/>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap"
                       Text="A extração lê os scripts do jogo e grava as linhas no projeto. Ela pode levar alguns minutos e roda na barra de tarefas."/>
            <TextBlock Classes="body-sm" Text="{Binding ExtractionMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding ExtractionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="accent" Command="{Binding ExtractCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Extrair agora"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding FinishCommand}" Content="Abrir projeto"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsWizardStep}">
        <Button Command="{Binding BackCommand}" Content="Voltar"/>
        <Button Classes="accent" Command="{Binding NextCommand}" Content="{Binding NextLabel}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
