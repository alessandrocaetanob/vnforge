<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.NewProjectWizardView"
             x:DataType="vm:NewProjectWizardViewModel">

  <UserControl.Resources>
    <!-- Cartão de escolha única (OptionCard): nome, valor à direita e uma linha de descrição. -->
    <DataTemplate x:Key="ChoiceCard" x:DataType="vm:ChoiceOption">
      <RadioButton Classes="option" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
          <TextBlock Classes="body-strong" Text="{Binding Title}"/>
          <TextBlock Grid.Column="1" Classes="mono-xs secondary" Text="{Binding Value}" VerticalAlignment="Center"
                     IsVisible="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Description}"
                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
      </RadioButton>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="960" Margin="24,16,24,32" Spacing="16">

      <c:PageHeader Breadcrumb="{Binding Breadcrumb}" Title="Novo projeto">
        <Button Classes="subtle" Command="{Binding CancelCommand}" Content="Cancelar" IsVisible="{Binding IsWizardStep}"/>
      </c:PageHeader>

      <c:PipelineStepper ItemsSource="{Binding Steps}" IsVisible="{Binding IsWizardStep}" AutomationProperties.Name="Passos do assistente"/>

      <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Error}"/>
          <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        </Grid>
      </Border>

      <!-- 1. Pasta do jogo; a engine detectada aparece como resultado -->
      <StackPanel Spacing="16" IsVisible="{Binding IsGameStep}">
        <Border Classes="panel" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <PathIcon Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.TextSecondary}" Data="{StaticResource Icon.Folder}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
              <TextBlock Text="Pasta do jogo"/>
              <TextBlock Classes="mono secondary" TextTrimming="CharacterEllipsis" Text="{Binding GameFolderLabel}"/>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding BrowseGameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                <TextBlock Text="Escolher pasta"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding HasDetection}" AutomationProperties.Name="Engine detectada">
          <StackPanel>
            <Border Classes="divider-bottom" Padding="16,0" MinHeight="56">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <PathIcon Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Data="{StaticResource Icon.Check}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8">
                  <TextBlock Classes="overline" Text="Engine detectada"/>
                  <TextBlock Classes="title-md" Text="{Binding EngineTitle}"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,2" CornerRadius="{DynamicResource Vnf.RadiusSm}"
                        Background="{DynamicResource Vnf.StatusApprovedBg}">
                  <TextBlock Classes="caption" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="Suportada"/>
                </Border>
              </Grid>
            </Border>
            <StackPanel Margin="16" Spacing="8">
              <ItemsControl ItemsSource="{Binding DetectionFacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetectionFact">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="16" Margin="0,0,0,8">
                      <TextBlock Classes="body-sm secondary" Text="{Binding Label}"/>
                      <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Value}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="180,*" ColumnSpacing="16">
                <TextBlock Classes="body-sm secondary" Text="Executável do jogo" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExe}" MinWidth="280"
                          IsVisible="{Binding HasExecutables}" AutomationProperties.Name="Executável do jogo"/>
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SelectedExe}" VerticalAlignment="Center" IsVisible="{Binding !HasExecutables}"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding DetectionWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding DetectionWarning}"/>
          </Grid>
        </Border>

        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                   Text="O VNForge só lê esta pasta. Nada é gravado nela fora da injeção, com backup."/>
      </StackPanel>

      <!-- 2. Idiomas e nome -->
      <StackPanel Spacing="20" IsVisible="{Binding IsNamesStep}">
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Nome do projeto"/>
          <TextBox Text="{Binding ProjectName}" AutomationProperties.Name="Nome do projeto"/>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Pasta do projeto"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="mono secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ProjectDirectoryLabel}"/>
            <Button Grid.Column="1" Command="{Binding BrowseProjectCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
                <TextBlock Text="Escolher pasta"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Classes="caption secondary" Text="Fora da pasta do jogo. Texto, cache e backups ficam aqui."/>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Idioma do jogo"/>
          <ItemsControl ItemsSource="{Binding SourceLanguages.Options}" ItemTemplate="{StaticResource ChoiceCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="200"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Idioma da tradução"/>
          <ItemsControl ItemsSource="{Binding TargetLanguages.Options}" ItemTemplate="{StaticResource ChoiceCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="240"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- 3. Acentuação -->
      <StackPanel Spacing="8" IsVisible="{Binding IsAccentsStep}">
        <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                   Text="O jogo lê o texto em Shift-JIS, que não tem letras acentuadas. A estratégia decide o que acontece com elas no build. Dá para trocar depois nos Ajustes."/>
        <TextBlock Classes="overline" Margin="0,8,0,0" Text="Estratégia de acentuação"/>
        <ItemsControl ItemsSource="{Binding EncodingStrategies.Options}" ItemTemplate="{StaticResource ChoiceCard}"/>
      </StackPanel>

      <!-- 4. IA -->
      <StackPanel Spacing="16" IsVisible="{Binding IsAiStep}">
        <StackPanel Spacing="8">
          <TextBlock Classes="overline" Text="Provedor"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Padding="10,4" CornerRadius="{DynamicResource Vnf.RadiusSm}" Background="{DynamicResource Vnf.StatusApprovedBg}">
              <TextBlock Classes="body-sm" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Text="Claude (Anthropic)"/>
            </Border>
            <Border Padding="10,4" CornerRadius="{DynamicResource Vnf.RadiusSm}" BorderThickness="1" BorderBrush="{DynamicResource Vnf.StrokeControl}">
              <TextBlock Classes="body-sm secondary" Text="Outros provedores · em breve"/>
            </Border>
          </StackPanel>
        </StackPanel>
        <Border Classes="panel" ClipToBounds="True">
          <c:ToggleRule Title="Usar o modelo padrão" Description="Claude Opus 5.5. Dá para escolher outro depois, nos Ajustes."
                        IsChecked="{Binding SkipAi, Mode=TwoWay}"/>
        </Border>
        <StackPanel Spacing="8" IsEnabled="{Binding !SkipAi}">
          <TextBlock Classes="overline" Text="Modelo"/>
          <ItemsControl ItemsSource="{Binding Models.Options}" ItemTemplate="{StaticResource ChoiceCard}"/>
        </StackPanel>
        <Border Classes="infobar">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Info}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="body-strong" Text="A chave da API não entra no projeto."/>
              <TextBlock Classes="body-sm" TextWrapping="Wrap"
                         Text="Ela fica na variável de ambiente ANTHROPIC_API_KEY ou no cofre do Windows (DPAPI). Configure em Ajustes."/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Fim: projeto criado, oferece extrair -->
      <StackPanel Spacing="16" IsVisible="{Binding IsDoneStep}">
        <Border Classes="infobar success">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icon.Check}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="body-strong" Text="Projeto criado."/>
              <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding CreatedSummary}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="title-md" Text="Extrair o texto do jogo agora?"/>
            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap"
                       Text="A extração lê os scripts do jogo e grava as linhas no projeto. Ela pode levar alguns minutos e roda na barra de tarefas."/>
            <TextBlock Classes="body-sm" Text="{Binding ExtractionMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding ExtractionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="accent" Command="{Binding ExtractCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sparkle}"/>
                  <TextBlock Text="Extrair agora"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding FinishCommand}" Content="Abrir projeto"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" IsVisible="{Binding IsWizardStep}">
        <Button Command="{Binding BackCommand}" Content="Voltar"/>
        <Button Classes="accent" Command="{Binding NextCommand}" Content="{Binding NextLabel}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
