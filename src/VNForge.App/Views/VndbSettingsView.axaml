<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.VndbSettingsView"
             x:DataType="vm:VndbConnectionViewModel">

  <!-- A aba VNDB de Ajustes (quadro do #550): o token no cofre do Windows, o que ele permite e o Sincronizar agora. -->
  <StackPanel Margin="0,16,0,0" Spacing="20" MaxWidth="860" HorizontalAlignment="Left">
    <TextBlock Classes="lib-sub" Text="A sua lista no VNDB e a lista da Biblioteca andam juntas."/>

    <Border Name="TokenCard" Classes="lib-card" Padding="24">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="lib-icobox"><PathIcon Data="{StaticResource Icon.Key}"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="Token pessoal"/>
            <TextBlock Name="TokenMask" Classes="mono lib-dim" FontSize="13" Text="{Binding TokenMask}"/>
          </StackPanel>
          <Border Name="AccountPill" Grid.Column="2" Classes="lib-pill" Tag="ok" IsVisible="{Binding ConnectionOk}"><TextBlock Text="{Binding AccountText}"/></Border>
          <Border Name="AccountError" Grid.Column="2" Classes="lib-pill" Tag="err" IsVisible="{Binding HasAccountError}"><TextBlock Text="{Binding AccountText}"/></Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConnectionOk}">
          <Border Classes="lib-pill" Tag="ok" IsVisible="{Binding CanRead}"><TextBlock Text="Ler a lista"/></Border>
          <Border Classes="lib-pill" Tag="ok" IsVisible="{Binding CanWrite}"><TextBlock Text="Gravar na lista (listwrite)"/></Border>
          <Border Classes="lib-pill" Tag="warn" IsVisible="{Binding !CanWrite}"><TextBlock Text="Sem gravar na lista: o app só lê"/></Border>
        </StackPanel>

        <TextBlock Name="TokenSource" Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="{Binding TokenSourceText}"/>

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsChangingToken}">
          <TextBox Name="NewTokenBox" PasswordChar="●" Text="{Binding NewToken}" PlaceholderText="Cole o token aqui" AutomationProperties.Name="Token do VNDB"/>
          <Button Name="SaveTokenButton" Grid.Column="1" Classes="accent" Content="Guardar token" Command="{Binding SaveTokenCommand}"/>
          <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelChangeTokenCommand}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsChangingToken}">
          <Button Name="ChangeTokenButton" Content="{Binding ChangeTokenLabel}" Command="{Binding ChangeTokenCommand}"/>
          <Button Name="RemoveTokenButton" Classes="danger" Content="Remover do cofre" Command="{Binding RemoveTokenCommand}" IsVisible="{Binding CanRemoveToken}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="WhatSyncs" Classes="lib-card" Padding="24">
      <StackPanel Spacing="12">
        <TextBlock Classes="lib-h3" Text="O que sincroniza"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" IsChecked="{Binding SyncLabels}" AutomationProperties.Name="Rótulos"/><TextBlock VerticalAlignment="Center" Text="Rótulos (Jogando, Terminado, Abandonado)"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" IsChecked="{Binding SyncVote}" AutomationProperties.Name="Voto"/><TextBlock VerticalAlignment="Center" Text="Voto"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" IsChecked="{Binding SyncDates}" AutomationProperties.Name="Datas de início e fim"/><TextBlock VerticalAlignment="Center" Text="Datas de início e fim"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" IsChecked="{Binding SyncNotes}" AutomationProperties.Name="Notas"/><TextBlock VerticalAlignment="Center" Text="Notas"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch Classes="lib-switch" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" IsChecked="{Binding MarkFinishedOnVndb}" AutomationProperties.Name="Marcar como terminado no VNDB quando eu terminar aqui"/><TextBlock VerticalAlignment="Center" Text="Marcar como terminado no VNDB quando eu terminar aqui"/></StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Name="SyncNowButton" Classes="accent" Command="{Binding SyncNowCommand}" IsEnabled="{Binding HasToken}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.ArrowSync}"/>
            <TextBlock Text="Sincronizar agora"/>
          </StackPanel>
        </Button>
        <TextBlock Name="LastSync" Classes="lib-dim" VerticalAlignment="Center" Text="{Binding LastSyncText}"/>
      </StackPanel>
      <TextBlock Name="Message" Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="{Binding Message}"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- A lista mudou nos dois lados: cada campo com o valor daqui e o do VNDB; o que vale fica marcado. -->
    <c:ScreenDialog DialogWidth="760" IsOpen="{Binding IsConflictsOpen, Mode=TwoWay}">
      <StackPanel Spacing="16" Margin="0,-16,0,0" AutomationProperties.Name="A lista mudou nos dois lados">
        <StackPanel>
          <TextBlock Classes="lib-h2" Text="A lista mudou nos dois lados"/>
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vnf.TextSecondary}" Text="{Binding ConflictsIntro}"/>
        </StackPanel>
        <Border Classes="lib-card" Padding="0" ClipToBounds="True">
          <StackPanel>
            <Grid ColumnDefinitions="180,*,*" Height="40" Margin="16,0">
              <TextBlock Classes="column-header lib-dim" VerticalAlignment="Center" Text="Campo"/>
              <TextBlock Grid.Column="1" Classes="column-header lib-dim" VerticalAlignment="Center" Margin="13,0,0,0" Text="No VNForge"/>
              <TextBlock Grid.Column="2" Classes="column-header lib-dim" VerticalAlignment="Center" Margin="13,0,0,0" Text="No VNDB"/>
            </Grid>
            <Border Classes="lib-hr"/>
            <ItemsControl Name="ConflictRows" ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VndbConflictRow">
                  <Border Classes="lib-row" Padding="16,10">
                    <Grid ColumnDefinitions="180,*,*" ColumnSpacing="8">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Field}"/>
                        <TextBlock Classes="lib-dim" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding GameTitle}"/>
                      </StackPanel>
                      <RadioButton Grid.Column="1" Classes="option marked" IsChecked="{Binding UseLocal, Mode=TwoWay}" AutomationProperties.Name="Valer o que está no VNForge">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="radio-mark"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Local}"/></StackPanel>
                      </RadioButton>
                      <RadioButton Grid.Column="2" Classes="option marked" IsChecked="{Binding UseRemote, Mode=TwoWay}" AutomationProperties.Name="Valer o que está no VNDB">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="radio-mark"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Remote}"/></StackPanel>
                      </RadioButton>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Classes="lib-dim" FontSize="13" TextWrapping="Wrap" Text="Nada é gravado até você confirmar."/>
      </StackPanel>
      <c:ScreenDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="DecideLaterButton" Content="Decidir depois" Command="{Binding DecideLaterCommand}"/>
          <Button Name="ApplyConflictsButton" Classes="accent lg" Command="{Binding ApplyConflictsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Checkmark}"/>
              <TextBlock Text="Aplicar escolhas"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </c:ScreenDialog.Footer>
    </c:ScreenDialog>
  </StackPanel>
</UserControl>
