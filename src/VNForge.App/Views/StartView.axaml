<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.StartView"
             x:DataType="vm:StartViewModel">

  <UserControl.Styles>
    <!-- Linha da lista e detalhe em aviso (sem suporte ou indisponível): a cor de alerta do design. -->
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
    </Style>
  </UserControl.Styles>

  <!-- Artboard "Início" do canvas v2: o contêiner tem 1180 de largura contando o respiro (box-sizing: border-box). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Border MaxWidth="1180" Padding="24,32,24,40">
      <StackPanel Spacing="16">

        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Classes="title-lg" Text="Projetos" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
              <TextBlock Text="Abrir projeto"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="accent" Command="{Binding NewProjectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Add}"/>
              <TextBlock Text="Novo projeto" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
          </Grid>
        </Border>
        <Border Classes="infobar" IsVisible="{Binding NoticeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Info}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding NoticeMessage}"/>
          </Grid>
        </Border>
        <Border Classes="infobar warning" IsVisible="{Binding HasRecentsProblem}" AutomationProperties.Name="Lista de recentes ilegível">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="Não foi possível ler os projetos recentes. "/>
              <Run Text="{Binding RecentsProblem}"/>
            </TextBlock>
          </Grid>
        </Border>

        <!-- Painéis lado a lado: Grid com colunas, para os dois terem a mesma altura. A coluna do detalhe é a do artboard (360, no máximo 400). -->
        <Grid ColumnDefinitions="*,360" ColumnSpacing="12">

          <Border Classes="panel" ClipToBounds="True" MinHeight="261">
            <Grid RowDefinitions="32,*,40">
              <Border Classes="divider-bottom" Padding="16,0">
                <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16">
                  <TextBlock Classes="overline" Text="PROJETO" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Classes="overline" Text="TRADUZIDO" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Classes="overline" Text="ABERTO" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <ListBox Grid.Row="1" Classes="projects" ItemsSource="{Binding Recents}" SelectedItem="{Binding Selected}"
                       IsVisible="{Binding HasRecents}" AutomationProperties.Name="Projetos recentes">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentProjectItem">
                    <Grid ColumnDefinitions="*,180,96" ColumnSpacing="16" Margin="16,12">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Remover da lista"
                                    Command="{Binding $parent[ListBox].((vm:StartViewModel)DataContext).RemoveRecentCommand}"
                                    CommandParameter="{Binding}"/>
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <StackPanel Spacing="2">
                        <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Classes="mono secondary" LineHeight="16" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="body-sm" LineHeight="18" Text="{Binding RowStatusLabel}" Classes.warn="{Binding HasStatusWarning}"/>
                        <c:DistributionBar Height="8" Value="{Binding Distribution}" IsVisible="{Binding !HasProblem}"
                                           AutomationProperties.Name="{Binding DistributionDescription}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding WhenLabel}" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Tela vazia: o selo 訳, uma frase e as duas ações da tela. -->
              <c:EmptyState Grid.Row="1" IsVisible="{Binding !HasRecents}"
                            Message="Nenhum projeto recente. Abra uma pasta criada com vnf init ou crie um projeto novo a partir da pasta do jogo; ele aparece aqui na próxima vez."
                            ActionText="Abrir projeto" ActionCommand="{Binding OpenFolderCommand}">
                <Button Classes="lg" Command="{Binding NewProjectCommand}" Content="Novo projeto" HorizontalAlignment="Center"/>
              </c:EmptyState>

              <Border Grid.Row="2" Classes="divider-top" Padding="16,0">
                <TextBlock Classes="caption secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding RecentsSummary}"/>
              </Border>
            </Grid>
          </Border>

          <!-- Projeto selecionado -->
          <Border Grid.Column="1" Classes="panel" Padding="16" AutomationProperties.Name="Projeto selecionado">
            <Panel>
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="overline" Text="{Binding Selected.EngineOverline}"/>
                  <TextBlock Classes="title-md" Text="{Binding Selected.Name}" TextWrapping="Wrap"/>
                  <TextBlock Classes="mono secondary" LineHeight="16" Text="{Binding Selected.Path}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="16">
                  <!-- Projeto aberto, motor com suporte -->
                  <StackPanel Spacing="16" IsVisible="{Binding Selected.IsSupported}">
                    <StackPanel Spacing="8">
                      <c:DistributionBar Height="8" Value="{Binding Selected.Distribution}" AutomationProperties.Name="{Binding Selected.DistributionDescription}"/>
                      <c:Legend Value="{Binding Selected.Distribution}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                      <TextBlock Classes="body-sm secondary" LineHeight="20" Text="Linhas"/>
                      <TextBlock Grid.Column="1" Classes="body-sm" LineHeight="20" Text="{Binding Selected.Lines}"/>
                      <TextBlock Grid.Row="1" Classes="body-sm secondary" LineHeight="20" Text="Scripts"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="body-sm" LineHeight="20" Text="{Binding Selected.Scripts}"/>
                      <TextBlock Grid.Row="2" Classes="body-sm secondary" LineHeight="20" Text="Acentuação"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="body-sm" LineHeight="20" Text="{Binding Selected.EncodingLabel}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="3" Classes="body-sm secondary" LineHeight="20" Text="Modelo"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Classes="body-sm" LineHeight="20" Text="{Binding Selected.ModelLabel}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="4" Classes="body-sm secondary" LineHeight="20" Text="Último build"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" Classes="body-sm" LineHeight="20" Text="{Binding Selected.LastBuildLabel}" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>

                  <!-- Motor ainda sem suporte: a pasta foi reconhecida, mas não abre -->
                  <StackPanel Spacing="16" IsVisible="{Binding Selected.IsUnsupported}">
                    <Border Classes="infobar warning">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
                        <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                          <Run FontWeight="SemiBold" Text="Motor ainda sem suporte. "/>
                          <Run Text="{Binding Selected.UnsupportedDetail}"/>
                        </TextBlock>
                      </Grid>
                    </Border>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenSelectedCommand}" Content="Abrir projeto"/>
                  </StackPanel>

                  <!-- Pasta que sumiu ou que não abre -->
                  <StackPanel Spacing="16" IsVisible="{Binding Selected.HasProblem}">
                    <Border Classes="infobar warning">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
                        <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                          <Run FontWeight="SemiBold" Text="Projeto indisponível. "/>
                          <Run Text="{Binding Selected.Problem}"/>
                        </TextBlock>
                      </Grid>
                    </Border>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenSelectedCommand}" Content="Abrir projeto"/>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RemoveSelectedCommand}" Content="Remover da lista"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8" IsVisible="{Binding Selected.IsSupported}">
                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenSelectedCommand}" Content="Abrir projeto"/>
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenSelectedInEditorCommand}" Content="{Binding Selected.ResumeLabel}"/>
                </StackPanel>
              </Grid>
              <TextBlock Classes="body-sm secondary" Text="Selecione um projeto da lista para ver o progresso." TextWrapping="Wrap"
                         IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>
            </Panel>
          </Border>
        </Grid>

        <Border Classes="infobar">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Info}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="Um projeto é uma pasta. "/>
              <Run Text="Texto, glossário e perfil de formatação ficam em JSON versionável; os arquivos do jogo nunca entram nela."/>
            </TextBlock>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
