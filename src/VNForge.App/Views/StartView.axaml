<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:c="using:VNForge.App.Controls"
             x:Class="VNForge.App.Views.StartView"
             x:DataType="vm:StartViewModel">

  <UserControl.Styles>
    <!-- Linha da lista e detalhe em aviso (sem suporte ou indisponível): a cor de alerta do design. -->
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource Vnf.SignalWarningFg}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Border MaxWidth="1180" Padding="24,32,24,40">
      <StackPanel Spacing="16">

        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Classes="title-lg" Text="Projetos" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
              <TextBlock Text="Abrir projeto"/>
            </StackPanel>
          </Button>
          <!-- Com projetos, o único destaque da tela é o botão do cartão; na primeira vez, o caminho começa aqui. -->
          <Button Grid.Column="2" Classes.accent="{Binding !HasRecents}" Command="{Binding NewProjectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Add}"/>
              <TextBlock Text="Novo projeto"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="infobar error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Error}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
          </Grid>
        </Border>
        <Border Classes="infobar" IsVisible="{Binding NoticeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Info}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding NoticeMessage}"/>
          </Grid>
        </Border>
        <Border Classes="infobar warning" IsVisible="{Binding HasRecentsProblem}" AutomationProperties.Name="Lista de recentes ilegível">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
            <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="Não foi possível ler os projetos recentes. "/>
              <Run Text="{Binding RecentsProblem}"/>
            </TextBlock>
          </Grid>
        </Border>

        <!-- Com projetos: o cartão do projeto selecionado (o mais recente, até a pessoa escolher outro) e a lista. -->
        <StackPanel Spacing="24" IsVisible="{Binding HasRecents}">

          <!-- Continuar de onde parou: a parte pronta, a cena do próximo passo, os fatos e a fala onde a pessoa vai continuar, com uma ação só. -->
          <Border Classes="panel" Padding="28" IsVisible="{Binding Selected.IsSupported}" AutomationProperties.Name="Continuar de onde parou">
            <StackPanel Spacing="20">
              <Border Classes="infobar warning" IsVisible="{Binding DetailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      AutomationProperties.Name="Erro ao ler o projeto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
                  <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding DetailError}"/>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
                <c:ProgressRing VerticalAlignment="Center" Done="{Binding Selected.ReadyLines}" Review="{Binding Selected.ReviewLines}" Total="{Binding Selected.TotalLines}"
                                AutomationProperties.Name="{Binding Selected.ReadyDescription}"/>

                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center" MinWidth="0">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="overline" Text="Continuar de onde parou"/>
                    <TextBlock Classes="title-md" Text="{Binding Selected.Name}" TextWrapping="Wrap"/>
                    <TextBlock Classes="body-strong" Text="{Binding Detail.NextStepScene}" TextWrapping="Wrap"
                               IsVisible="{Binding Detail.NextStepScene, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding Detail.PaceText}" Margin="0,2,0,0"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="36" AutomationProperties.Name="Fatos do projeto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="caption secondary" Text="Linhas"/>
                      <TextBlock Classes="body-sm" FontFeatures="tnum" Text="{Binding Selected.Lines}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="caption secondary" Text="Gasto"/>
                      <TextBlock Classes="body-sm" FontFeatures="tnum" Text="{Binding Detail.SpentText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Classes="caption secondary" Text="Último teste no jogo"/>
                      <TextBlock Classes="body-sm" Text="{Binding Detail.LastTestText}"/>
                    </StackPanel>
                  </Grid>

                  <Button Classes="accent lg" HorizontalAlignment="Left" Command="{Binding OpenNextStepCommand}" Content="{Binding Detail.ContinueLabel}"
                          IsVisible="{Binding Detail.HasNextStep}"/>
                  <!-- Sem próximo passo (projeto sem linhas, ou leitura com erro) o cartão ainda precisa de uma saída. -->
                  <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedCommand}" Content="Abrir projeto" IsVisible="{Binding !Detail.HasNextStep}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="420" IsVisible="{Binding HasContinueLayout}">
                  <TextBlock Classes="caption secondary" HorizontalAlignment="Left" Text="{Binding ContinueLineCaption}"/>
                  <c:GameTextbox Size="Large" FitToWidth="True" HorizontalAlignment="Left" Layout="{Binding ContinueLayout}" AutomationProperties.Name="Caixa do jogo"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Motor ainda sem suporte ou pasta que sumiu: o cartão explica e oferece as saídas. -->
          <Border Classes="panel" Padding="24" IsVisible="{Binding Selected.HasStatusWarning}" AutomationProperties.Name="Projeto selecionado">
            <StackPanel Spacing="16">
              <TextBlock Classes="title-md" Text="{Binding Selected.Name}" TextWrapping="Wrap"/>

              <StackPanel Spacing="16" IsVisible="{Binding Selected.IsUnsupported}">
                <Border Classes="infobar warning">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
                    <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                      <Run FontWeight="SemiBold" Text="O VNForge ainda não sabe ler este jogo. "/>
                      <Run Text="{Binding Selected.UnsupportedDetail}"/>
                    </TextBlock>
                  </Grid>
                </Border>
                <Button HorizontalAlignment="Left" Command="{Binding OpenSelectedCommand}" Content="Abrir projeto"/>
              </StackPanel>

              <StackPanel Spacing="16" IsVisible="{Binding Selected.HasProblem}">
                <Border Classes="infobar warning">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource Icon.Warning}"/>
                    <TextBlock Grid.Column="1" Classes="body-sm" TextWrapping="Wrap">
                      <Run FontWeight="SemiBold" Text="Projeto indisponível. "/>
                      <Run Text="{Binding Selected.Problem}"/>
                    </TextBlock>
                  </Grid>
                </Border>
                <c:TechnicalDetails Key="start" AutomationProperties.Name="Detalhes técnicos">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,8,0,0">
                    <TextBlock Classes="body-sm secondary" Text="Pasta"/>
                    <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Selected.Path}"/>
                  </Grid>
                </c:TechnicalDetails>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Command="{Binding OpenSelectedCommand}" Content="Abrir projeto"/>
                  <Button Command="{Binding RemoveSelectedCommand}" Content="Remover da lista"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Seus projetos: uma linha por projeto e, por último, a área para soltar a pasta de outro jogo. -->
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title-md" Text="Seus projetos"/>
              <TextBlock Grid.Column="1" Classes="body-sm secondary" VerticalAlignment="Center" Text="{Binding RecentsSummary}"/>
            </Grid>
            <Border Classes="panel" ClipToBounds="True">
              <StackPanel>
                <ListBox Classes="projects" ItemsSource="{Binding Recents}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Projetos recentes">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentProjectItem">
                      <Grid ColumnDefinitions="*,120,200,96,Auto" ColumnSpacing="16" Margin="20,0,12,0" Height="52">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Remover da lista"
                                      Command="{Binding $parent[ListBox].((vm:StartViewModel)DataContext).RemoveRecentCommand}"
                                      CommandParameter="{Binding}"/>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="body-sm secondary" FontFeatures="tnum" Text="{Binding LinesLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                          <TextBlock Classes="body-sm" MinWidth="36" FontFeatures="tnum" Text="{Binding ReadyColumnLabel}" Classes.warn="{Binding HasStatusWarning}"/>
                          <c:Seg3Bar Grid.Column="1" VerticalAlignment="Center" Done="{Binding ReadyLines}" Review="{Binding ReviewLines}" Total="{Binding TotalLines}"
                                     IsVisible="{Binding !HasProblem}" AutomationProperties.Name="{Binding ReadyDescription}"/>
                        </Grid>
                        <TextBlock Grid.Column="3" Classes="body-sm secondary" Text="{Binding WhenLabel}" VerticalAlignment="Center"/>
                        <Button Grid.Column="4" Classes="subtle sm" VerticalAlignment="Center" Content="Abrir" IsVisible="{Binding IsSupported}"
                                Command="{Binding $parent[ListBox].((vm:StartViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Soltar a pasta de outro jogo abre o Novo projeto com ela preenchida. -->
                <Border x:Name="ListDropArea" DragDrop.AllowDrop="True" Margin="12" Padding="16,0" Height="48" CornerRadius="8" Background="Transparent"
                        AutomationProperties.Name="Soltar a pasta de um jogo">
                  <Panel>
                    <Rectangle Fill="Transparent" Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8"
                               Margin="-16,0" IsHitTestVisible="False"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                      <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource Vnf.TextSecondary}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Classes="body-strong" Text="{Binding DropTitle}" VerticalAlignment="Center"/>
                        <TextBlock Classes="body-sm secondary" Text="Solte a pasta aqui para começar uma tradução nova." VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="sm" Command="{Binding ChooseGameFolderCommand}" Content="Escolher a pasta" VerticalAlignment="Center"/>
                    </Grid>
                  </Panel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Diário de tradução: o trabalho dos últimos dias, no espaço que a lista de um projeto só deixa vazio. -->
          <Border Classes="panel" Padding="24" IsVisible="{Binding Selected.IsSupported}" AutomationProperties.Name="Diário de tradução">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="title-md" Text="Diário de tradução"/>
                <TextBlock Grid.Column="1" Classes="body-sm secondary" VerticalAlignment="Center" Text="Últimas 12 semanas · um quadrado por dia"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,48,*">
                <c:ReviewHeatmap Diary="{Binding Diary.Source}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Diary.MapDescription}"/>
                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center" MinWidth="0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="title-lg" FontFeatures="tnum" Text="{Binding Diary.StreakValue}" VerticalAlignment="Center"/>
                    <TextBlock Classes="body-sm secondary" Text="{Binding Diary.StreakCaption}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Diary.YesterdayText}"/>
                    <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Diary.TodayText}"/>
                    <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Diary.TotalText}" IsVisible="{Binding Diary.HasActivity}"/>
                    <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Diary.EmptyText}" IsVisible="{Binding Diary.IsEmpty}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Os dados do projeto selecionado que a pessoa raramente precisa: fora do cartão, fechados. -->
          <c:TechnicalDetails Key="start" IsVisible="{Binding Selected.IsSupported}" AutomationProperties.Name="Detalhes técnicos">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6" Margin="0,8,0,0">
              <TextBlock Classes="body-sm secondary" Text="Motor"/>
              <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Selected.EngineLabel}"/>
              <TextBlock Grid.Row="1" Classes="body-sm secondary" Text="Pasta"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Selected.Path}"/>
              <TextBlock Grid.Row="2" Classes="body-sm secondary" Text="Acentos"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding Selected.EncodingLabel}"/>
              <TextBlock Grid.Row="3" Classes="body-sm secondary" Text="Qualidade"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="body-sm" TextWrapping="Wrap" Text="{Binding Selected.QualityLabel}"/>
            </Grid>
          </c:TechnicalDetails>
        </StackPanel>

        <!-- Primeira vez: os quatro passos do caminho inteiro, a área para soltar a pasta e o que ter à mão. -->
        <Grid ColumnDefinitions="*,380" ColumnSpacing="16" IsVisible="{Binding !HasRecents}">
          <StackPanel Spacing="12">
            <Border Classes="panel" Padding="20" AutomationProperties.Name="Como começar">
              <StackPanel Spacing="16">
                <TextBlock Classes="title-md" Text="Como começar"/>
                <ItemsControl ItemsSource="{x:Static vm:StartViewModel.FirstSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FirstStep">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,14">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Vnf.AccentSoft}" VerticalAlignment="Top">
                          <TextBlock Classes="body-strong" Text="{Binding Number}" Foreground="{DynamicResource Vnf.AccentText}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Classes="body-strong" Text="{Binding Title}"/>
                          <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Description}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Soltar a pasta do jogo abre o Novo projeto com ela preenchida. -->
            <Border x:Name="FirstDropArea" DragDrop.AllowDrop="True" MinHeight="72" Padding="16" CornerRadius="8" Background="Transparent"
                    AutomationProperties.Name="Soltar a pasta de um jogo">
              <Panel>
                <Rectangle Fill="Transparent" Stroke="{DynamicResource Vnf.StrokeControl}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8"
                           Margin="-16" IsHitTestVisible="False"/>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <PathIcon Width="20" Height="20" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource Vnf.TextSecondary}"/>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="body-strong" Text="{Binding DropTitle}"/>
                    <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="Solte a pasta aqui para começar uma tradução nova."/>
                  </StackPanel>
                  <Button Grid.Column="2" Command="{Binding ChooseGameFolderCommand}" Content="Escolher a pasta" VerticalAlignment="Center"/>
                </Grid>
              </Panel>
            </Border>
          </StackPanel>

          <!-- O que ter à mão antes do primeiro passo. -->
          <Border Grid.Column="1" Classes="panel" Padding="20" VerticalAlignment="Top" AutomationProperties.Name="O que você precisa">
            <StackPanel Spacing="16">
              <TextBlock Classes="title-md" Text="O que você precisa"/>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <PathIcon Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top" Data="{StaticResource Icon.Folder}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="body-strong" Text="O jogo instalado"/>
                  <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="A pasta onde ele está no computador, com o executável dentro."/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Panel Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top">
                  <PathIcon Width="16" Height="16" Foreground="{DynamicResource Vnf.StatusApprovedFg}" Data="{StaticResource Icon.Check}" IsVisible="{Binding ApiKeyConfigured}"/>
                  <PathIcon Width="16" Height="16" Foreground="{DynamicResource Vnf.SignalWarningFg}" Data="{StaticResource Icon.Warning}" IsVisible="{Binding !ApiKeyConfigured}"/>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="body-strong" Text="Uma chave do Claude"/>
                  <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding ApiKeyNeedText}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <PathIcon Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top" Data="{StaticResource Icon.Box}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="body-strong" Text="Espaço para a cópia de segurança"/>
                  <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="O app guarda uma cópia do jogo original antes de mexer nele."/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
