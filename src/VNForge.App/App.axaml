<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:views="using:VNForge.App.Views"
             x:Class="VNForge.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VNForge.App/Themes/Tokens.axaml"/>
        <ResourceInclude Source="avares://VNForge.App/Themes/TextScale.axaml"/>
        <ResourceInclude Source="avares://VNForge.App/Assets/Icons.axaml"/>
        <ResourceInclude Source="avares://VNForge.App/Assets/Brand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- O Fluent usa 4 e 8; o design system v3 pede 8 e 16 (radius-sm e radius-lg). -->
      <StaticResource x:Key="ControlCornerRadius" ResourceKey="Vnf.RadiusSm"/>
      <StaticResource x:Key="OverlayCornerRadius" ResourceKey="Vnf.RadiusLg"/>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:StartViewModel">
      <views:StartView/>
    </DataTemplate>
    <DataTemplate DataType="vm:NewProjectWizardViewModel">
      <views:NewProjectWizardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel">
      <views:EditorView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ConferenceViewModel">
      <views:ConferenceView/>
    </DataTemplate>
    <DataTemplate DataType="vm:LineDetailViewModel">
      <views:LineDetailView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:GlossaryViewModel">
      <views:GlossaryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:BibleViewModel">
      <views:BibleView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ImagesViewModel">
      <views:ImagesView/>
    </DataTemplate>
    <DataTemplate DataType="vm:BuildViewModel">
      <views:BuildView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ReleaseViewModel">
      <views:ReleaseView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <!-- Accent fixo: o verde-água do design system v3 é identidade do app e os contrastes foram calculados para ele; não segue a cor do Windows. Os valores são os tokens accent, bg-layer e signal-error-fg. -->
    <FluentTheme DensityStyle="Normal">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#4FD1B5" RegionColor="#161A19" ErrorText="#F59AB2"/>
        <ColorPaletteResources x:Key="Light" Accent="#0B7A66" RegionColor="#F8F9F7" ErrorText="#B8244F"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://VNForge.App/Themes/Typography.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Buttons.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/NavRail.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Panels.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/InfoBar.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/OptionCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/StatusBadge.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/SeverityTag.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/PipelineStepper.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineRow.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ScriptItem.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ToggleRule.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Segmented.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/FilterChip.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/AiSuggestion.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Legend.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/StatCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/PageHeader.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/EmptyState.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Skeleton.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ToastHost.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/MarkerChip.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ProgressRing.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/CostLabel.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/TodoItem.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ReviewStage.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/GameStateBanner.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/QualityCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ContextLines.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ExplainCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ScriptGroup.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/TechnicalDetails.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ScreenDialog.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/FitWarning.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Motion.axaml"/>
  </Application.Styles>
</Application>
