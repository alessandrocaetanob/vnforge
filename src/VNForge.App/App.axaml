<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VNForge.App.ViewModels"
             xmlns:views="using:VNForge.App.Views"
             x:Class="VNForge.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VNForge.App/Themes/Tokens.axaml"/>
        <ResourceInclude Source="avares://VNForge.App/Assets/Icons.axaml"/>
        <ResourceInclude Source="avares://VNForge.App/Assets/Brand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:StartViewModel">
      <views:StartView/>
    </DataTemplate>
    <DataTemplate DataType="vm:NewProjectWizardViewModel">
      <views:NewProjectWizardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel">
      <views:EditorView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ConferenceViewModel">
      <views:ConferenceView/>
    </DataTemplate>
    <DataTemplate DataType="vm:LineDetailViewModel">
      <views:LineDetailView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:GlossaryViewModel">
      <views:GlossaryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:BuildViewModel">
      <views:BuildView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <!-- Accent fixo: o azul ai (藍) é identidade do app e os contrastes foram calculados para ele; não segue a cor do Windows. -->
    <FluentTheme DensityStyle="Normal">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#8DB0EA" RegionColor="#15181E" ErrorText="#F59AB2"/>
        <ColorPaletteResources x:Key="Light" Accent="#2B4C7E" RegionColor="#F4F5F8" ErrorText="#9C1F45"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://VNForge.App/Themes/Typography.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Buttons.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/NavRail.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Panels.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/InfoBar.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/OptionCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/StatusBadge.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/SeverityTag.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/PipelineStepper.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/LineRow.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ScriptItem.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ToggleRule.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Segmented.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/FilterChip.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/AiSuggestion.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Legend.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/StatCard.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/PageHeader.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/EmptyState.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Skeleton.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/ToastHost.axaml"/>
    <StyleInclude Source="avares://VNForge.App/Themes/Controls/Motion.axaml"/>
  </Application.Styles>
</Application>
