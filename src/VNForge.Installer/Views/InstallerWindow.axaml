<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VNForge.Installer.ViewModels"
        xmlns:v="using:VNForge.Installer.Views"
        x:Class="VNForge.Installer.Views.InstallerWindow"
        x:DataType="vm:InstallerViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/VNForge.ico"
        Width="720" Height="480"
        CanResize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource Vnf.BgLayer}">

  <!-- Janela de 720 por 480 do quadro #540: barra de 32 com minimizar e fechar (o quadro não tem maximizar), coluna de 200 com a capa e o resto com a etapa. -->
  <Grid RowDefinitions="32,*">
    <Border Name="TitleBar" Grid.Row="0" Background="{DynamicResource Vnf.BgBase}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource Vnf.BrandShu}" VerticalAlignment="Center">
            <Border.RenderTransform>
              <RotateTransform Angle="-4"/>
            </Border.RenderTransform>
            <TextBlock Name="SealGlyph" Text="訳" Foreground="White" FontFamily="{DynamicResource Vnf.FontJp}" FontWeight="Bold" FontSize="9" LineHeight="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Classes="caption secondary" Text="{Binding WindowTitle}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Name="MinimizeButton" Classes="caption-button" AutomationProperties.Name="Minimizar">
            <Path Data="M0,4 H8" Stroke="{DynamicResource Vnf.TextSecondary}" StrokeThickness="1.2" Width="8" Height="8"/>
          </Button>
          <Button Name="CloseButton" Classes="caption-button close" AutomationProperties.Name="Fechar a janela">
            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Vnf.TextSecondary}" StrokeThickness="1.2" Width="8" Height="8"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <!-- A capa: o patch não leva a arte do jogo, então a capa é desenhada com o nome dele. -->
      <Border Grid.Column="0" Background="{DynamicResource Vnf.BgBase}" BorderBrush="{DynamicResource Vnf.StrokeSubtle}" BorderThickness="0,0,1,0" Padding="20,20,19,20">
        <StackPanel Spacing="12">
          <Border Width="150" Height="200" HorizontalAlignment="Left" CornerRadius="{DynamicResource Vnf.RadiusLg}" BoxShadow="{DynamicResource Vnf.ShadowCover}">
            <Border CornerRadius="{DynamicResource Vnf.RadiusLg}" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#4A6D94" Offset="0"/>
                  <GradientStop Color="#1B2D49" Offset="0.55"/>
                  <GradientStop Color="#0C1424" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Image Name="CoverImage" Stretch="UniformToFill" IsVisible="{Binding HasCover}"
                       Source="{Binding CoverBytes, Converter={x:Static v:BytesToBitmapConverter.Instance}}"/>
                <Viewbox Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Opacity="0.9" IsVisible="{Binding !HasCover}">
                  <Canvas Width="48" Height="48">
                    <Path Data="{StaticResource Brand.Seal}" Fill="White"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Name="CoverTitle" Text="{Binding GameName}" Foreground="White" FontFamily="{DynamicResource Vnf.FontDisplay}" FontWeight="Bold" FontSize="14" LineHeight="20"
                           TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasCover}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,14,14"/>
              </Grid>
            </Border>
          </Border>
          <TextBlock Classes="title-sm" Text="{Binding GameName}" TextWrapping="Wrap"/>
          <TextBlock Classes="caption secondary" Text="{Binding SideInfo}" TextWrapping="Wrap" Margin="0,0,-4,0"/>
        </StackPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="28,24,28,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="subtle" Content="Cancelar" Command="{Binding CloseCommand}" IsVisible="{Binding IsFolder}" IsCancel="True"/>
          <Button Content="Cancelar" Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsInstalling}"/>
          <Button Classes="subtle" Content="Ler o leia-me" Command="{Binding OpenReadMeCommand}" IsVisible="{Binding ShowReadMe}"/>
          <Button Classes="subtle" Content="Sair" Command="{Binding CloseCommand}" IsVisible="{Binding IsWrongVersion}" IsCancel="True"/>
          <Button Content="Fechar" Command="{Binding CloseCommand}" IsVisible="{Binding ShowClose}"/>
          <Button Classes="accent" Content="Fechar" Command="{Binding CloseCommand}" IsVisible="{Binding IsReverted}" IsDefault="True"/>
          <Button Classes="accent" Content="Instalar" Command="{Binding InstallCommand}" IsVisible="{Binding IsFolder}" IsDefault="True"/>
          <Button Classes="accent" Command="{Binding OpenGameCommand}" IsVisible="{Binding ShowOpenGame}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Play}"/>
              <TextBlock Text="Abrir o jogo"/>
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding BrowseCommand}" IsVisible="{Binding IsWrongVersion}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Folder}"/>
              <TextBlock Text="Escolher outra pasta"/>
            </StackPanel>
          </Button>
          <Button Classes="danger" Command="{Binding RevertCommand}" IsVisible="{Binding IsAlreadyInstalled}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <!-- O traço "undo" do quadro (azeu.html, viewBox 20, traço 1,6, pontas redondas), não o ícone Fluent. -->
              <Viewbox Width="16" Height="16">
                <Canvas Width="20" Height="20">
                  <Path Data="M5,8 h7 a3.5,3.5 0 0 1 0,7 H8 M5,8 l3,-3 M5,8 l3,3" Stroke="{DynamicResource Vnf.SignalErrorFg}" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Voltar ao jogo original"/>
            </StackPanel>
          </Button>
          <Button Classes="accent" Content="Tentar de novo" Command="{Binding RetryCommand}" IsVisible="{Binding ShowRetry}" IsDefault="True"/>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Vnf.FontDisplay}" FontWeight="Bold" FontSize="20" LineHeight="29" TextWrapping="Wrap"
                     AutomationProperties.Name="Título da janela"/>
          <TextBlock Text="{Binding Intro}" IsVisible="{Binding HasIntro}" Classes="secondary" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowFolderRow}">
            <Border Background="{DynamicResource Vnf.BgInset}" BorderBrush="{DynamicResource Vnf.StrokeControl}" BorderThickness="1"
                    CornerRadius="{DynamicResource Vnf.RadiusSm}" Height="{DynamicResource Vnf.ControlMd}" Padding="12,0"
                    AutomationProperties.Name="Pasta do jogo">
              <TextBlock Text="{Binding FolderPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Classes="sm" Content="Procurar" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
          </Grid>

          <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding ShowSteps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InstallStepViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="23">
                  <Panel Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                    <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Vnf.StatusApprovedFg}" IsVisible="{Binding IsDone}"/>
                    <PathIcon Width="18" Height="18" Data="{StaticResource Icon.ArrowSync}" Foreground="{DynamicResource Vnf.AccentText}" IsVisible="{Binding IsRunning}"/>
                    <Ellipse Width="14" Height="14" StrokeThickness="1.5" Stroke="{DynamicResource Vnf.TextTertiary}" IsVisible="{Binding IsPending}"/>
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Classes.pending="{Binding IsPending}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock.pending">
                        <Setter Property="Foreground" Value="{DynamicResource Vnf.TextTertiary}"/>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption secondary" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar Classes="install" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding Progress}" ShowProgressText="False" IsVisible="{Binding ShowSteps}"/>

          <Border Classes="ck" Classes.bad="{Binding CardIsError}" IsVisible="{Binding HasCard}">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,12,0">
                <PathIcon Width="20" Height="20" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Vnf.TextSecondary}" IsVisible="{Binding CardIsOk}"/>
                <PathIcon Width="20" Height="20" Data="{StaticResource Icon.Error}" Foreground="{DynamicResource Vnf.TextSecondary}" IsVisible="{Binding CardIsError}"/>
                <PathIcon Width="20" Height="20" Data="{StaticResource Icon.ArrowSync}" Foreground="{DynamicResource Vnf.AccentText}" IsVisible="{Binding CardIsWorking}"/>
              </Panel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CardTitle}" Classes="body-strong" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CardDetail}" Classes="caption secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="secondary" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
